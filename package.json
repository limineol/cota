{
  "name": "cota",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "proofs"
  ],
  "scripts": {
    "check": "biome check . && bun run typecheck && bun run boundaries && bun run docs:check && bun run lint:design",
    "typecheck": "effect-tsgo tsc -p tooling && effect-tsgo tsc -p evals && effect-tsgo tsc -p deploy && bun run --filter '*' typecheck",
    "boundaries": "bun tooling/boundaries.ts",
    "docs:check": "bun tooling/docs-check.ts",
    "lint:design": "oxlint apps/web/src apps/web/.storybook packages/ui/src && designmd lint DESIGN.md",
    "test": "bun --bun vitest run",
    "test:clickhouse": "bun --bun vitest run --config vitest.clickhouse.config.ts",
    "test:evals": "bun --bun vitest run --config vitest.evals.config.ts",
    "stories": "bun run --cwd apps/web stories",
    "prove": "bun tooling/bend.ts check",
    "prove:models": "bun tooling/bend.ts models --check",
    "mutants": "bun tooling/mutants.ts",
    "verify": "bun tooling/verify.ts",
    "openapi": "bun apps/hub/src/shared/05-tests/openapi.ts && biome format --write apps/hub/openapi.json",
    "replay:expect": "bun apps/hub/src/shared/05-tests/replay/expect.ts && biome format --write apps/hub/src/shared/05-tests/replay/exchanges",
    "replay:strings": "bun apps/hub/src/modules/recording/01-presentation/strings.ts",
    "prices:update": "bun apps/hub/src/modules/request-log/04-infrastructure/prices/update.ts && biome format --write apps/hub/src/modules/request-log/04-infrastructure/prices",
    "hub": "bun apps/hub/src/main.ts",
    "quota:connect": "bun apps/hub/src/modules/quota/01-presentation/connect.ts",
    "archive:restore": "bun apps/hub/src/restore-archive.ts",
    "import": "bun apps/hub/src/import.ts",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "cli:build": "bun apps/cli/build.ts",
    "storybook": "bun run --cwd apps/web storybook",
    "evals:design": "bun evals/design/harness.ts",
    "evals:install": "bun evals/install/harness.ts",
    "evals:memory": "bun evals/memory/harness.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@effect/tsgo": "0.68.0",
    "@effect/vitest": "4.1.4",
    "@google/design.md": "0.4.0",
    "@shadcn/lint": "0.2.5",
    "@types/bun": "1.4.4",
    "effect": "4.1.4",
    "oxlint": "1.93.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
