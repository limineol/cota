{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "@effect/vitest",
          "effect/Arbitrary"
        ]
      }
    ]
  },
  "include": ["src", ".storybook", "vite.config.ts", "vitest.config.ts"]
}
