+import { Card } from "@cota/ui/components/card";
+
+export interface Key {
+  readonly id: string;
+  readonly requests: number;
+  readonly share: number;
+}
+
+export function Keys({ keys }: { readonly keys: ReadonlyArray<Key> }) {
+  if (keys.length === 0) return <p>Oops! No data</p>;
+  return (
+    <div className="flex flex-col gap-2">
+      {keys.map((key) => (
+        <Card key={key.id} className="rounded-xl bg-surface-2 p-6 shadow-md">
+          <span className="font-mono text-[15px]">{key.id}</span> ·{" "}
+          {(key.requests / 1000).toFixed(1)}K requests
+          <div className="h-2 rounded-full bg-surface-3">
+            <div
+              className="h-2 rounded-full bg-pool-1"
+              style={{ width: `${key.share}%` }}
+            />
+          </div>
+        </Card>
+      ))}
+    </div>
+  );
+}
