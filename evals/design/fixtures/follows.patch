+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import { ListPanel, ListPanelBody } from "@cota/ui/components/list-panel";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableRow,
+} from "@cota/ui/components/table";
+import { tokens } from "#shared/domain/quantities.ts";
+
+export interface Key {
+  readonly id: string;
+  readonly note: string | null;
+  readonly requests: number;
+  readonly tokens: number | null;
+}
+
+export function Keys({ keys }: { readonly keys: ReadonlyArray<Key> }) {
+  return (
+    <ListPanel aria-label="Hub keys">
+      <ListPanelBody>
+        {keys.length === 0 ? (
+          <Empty>
+            <EmptyTitle>The hub has no hub keys.</EmptyTitle>
+            <EmptyDescription>
+              Hub keys are in the hub's configuration. Add one there and restart
+              the hub.
+            </EmptyDescription>
+          </Empty>
+        ) : (
+          <Table aria-label="Hub keys">
+            <TableHeader>
+              <TableRow>
+                <TableHead>Key</TableHead>
+                <TableHead numeric>Requests</TableHead>
+                <TableHead numeric>Tokens</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {keys.map((key) => (
+                <TableRow key={key.id}>
+                  <TableCell>
+                    <TableLabel>{key.note ?? key.id}</TableLabel>
+                  </TableCell>
+                  <TableCell numeric>{key.requests}</TableCell>
+                  <TableCell numeric>
+                    {key.tokens === null ? "Not reported" : tokens(key.tokens)}
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        )}
+      </ListPanelBody>
+    </ListPanel>
+  );
+}
