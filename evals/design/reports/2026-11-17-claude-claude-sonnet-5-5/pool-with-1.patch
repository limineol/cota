@@ -0,0 +1,77 @@
+import { BlockMeter } from "@cota/ui/components/block-meter";
+import {
+  Pace,
+  QuotaWindow,
+  QuotaWindowFoot,
+  QuotaWindowHead,
+  QuotaWindowLabel,
+  QuotaWindowReset,
+  QuotaWindowUsed,
+} from "@cota/ui/components/quota-window";
+import type { Hue } from "#shared/domain/hues.ts";
+import { meter } from "#shared/domain/meter.ts";
+import { span } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { useNow } from "#shared/now.tsx";
+import { when } from "#shared/words.ts";
+import { paceOf, usedText, type WindowShape, windowName } from "./windows.ts";
+
+/** One quota window: its name, how much is used, the countdown to its reset, and its block meter. */
+export function WindowLine({
+  window,
+  pool,
+  hue,
+  detailed,
+}: {
+  readonly window: WindowShape;
+  readonly pool: string;
+  readonly hue: Hue;
+  readonly detailed: boolean;
+}) {
+  const now = useNow();
+  const nameOf = useNameOf();
+  const name = windowName(window);
+  const pace = paceOf(window, now);
+  const {
+    blocks,
+    severity,
+    pace: marker,
+  } = meter({
+    usedPercent: window.usedPercent,
+    elapsed: window.standing?.elapsed ?? null,
+  });
+  const resetsAt = window.resetsAt;
+  const used = usedText(window);
+  return (
+    <QuotaWindow size={detailed ? "detail" : "card"}>
+      <QuotaWindowHead>
+        <QuotaWindowLabel>{name}</QuotaWindowLabel>
+        <QuotaWindowUsed>{used}</QuotaWindowUsed>
+        <QuotaWindowReset
+          title={
+            resetsAt === null ? undefined : `Resets ${when(resetsAt, now)}`
+          }
+        >
+          {resetsAt === null
+            ? "Not started"
+            : `Resets in ${span(resetsAt - now)}`}
+        </QuotaWindowReset>
+      </QuotaWindowHead>
+      <BlockMeter
+        blocks={blocks}
+        pace={marker}
+        severity={severity}
+        hue={hue}
+        size={detailed ? "detail" : "card"}
+        label={`${nameOf("pool", pool)}, ${name} window`}
+        valueText={pace === null ? used : `${used}, ${pace.text}`}
+      />
+      {detailed && (pace !== null || resetsAt !== null) ? (
+        <QuotaWindowFoot>
+          {pace === null ? null : <Pace tone={pace.tone}>{pace.text}</Pace>}
+          {resetsAt === null ? null : <span>Resets {when(resetsAt, now)}</span>}
+        </QuotaWindowFoot>
+      ) : null}
+    </QuotaWindow>
+  );
+}
diff --git a/apps/web/src/shared/windows.ts b/apps/web/src/shared/windows.ts
new file mode 100644
index 0000000..9880d4a
--- /dev/null
+++ b/apps/web/src/shared/windows.ts
@@ -0,0 +1,79 @@
+import { share, span } from "#shared/domain/quantities.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+
+/** A quota window as the screens write it, its times in milliseconds since the epoch. */
+export interface WindowShape {
+  readonly lengthMs: number;
+  readonly scope: string | null;
+  readonly usedPercent: number;
+  readonly resetsAt: number | null;
+  readonly standing: {
+    readonly elapsed: number;
+    readonly resetsInMs: number;
+    readonly pace: "full" | "on-pace" | "in-reserve" | "ahead-of-pace";
+    readonly points: number | null;
+    readonly emptiesInMs: number | null;
+  } | null;
+}
+
+const named: Record<number, string> = {
+  [5 * hour]: "5-hour",
+  [day]: "Daily",
+  [7 * day]: "Weekly",
+  [28 * day]: "Monthly",
+  [30 * day]: "Monthly",
+  [31 * day]: "Monthly",
+};
+
+/** A window's name for people, from its length and scope: `5-hour`, `Weekly`, `Weekly · opus`. */
+export const windowName = (window: WindowShape) => {
+  const base =
+    named[window.lengthMs] ??
+    (window.lengthMs < day
+      ? `${Math.round(window.lengthMs / hour)}-hour`
+      : `${Math.round(window.lengthMs / day)}-day`);
+  return window.scope === null ? base : `${base} · ${window.scope}`;
+};
+
+export const usedText = (window: WindowShape) =>
+  `${share(window.usedPercent / 100)} used`;
+
+/** When the window's standing was worked out: its reset less the time the hub said was left. */
+const answeredAt = (window: WindowShape) =>
+  window.resetsAt === null || window.standing === null
+    ? null
+    : window.resetsAt - window.standing.resetsInMs;
+
+export type Tone = "ok" | "warn" | "danger";
+
+/** A window's pace in words, as the hub decided it, with any emptying time counted down from `now`. */
+export const paceOf = (
+  window: WindowShape,
+  now: number,
+): { readonly text: string; readonly tone: Tone } | null => {
+  const standing = window.standing;
+  if (standing === null) return null;
+  const points = Math.round(standing.points ?? 0);
+  switch (standing.pace) {
+    case "full":
+      return { text: "Full until the reset", tone: "danger" };
+    case "on-pace":
+      return { text: "On pace", tone: "ok" };
+    case "in-reserve":
+      return { text: `${points}% in reserve`, tone: "ok" };
+    case "ahead-of-pace": {
+      const tone = window.usedPercent >= 80 ? "danger" : "warn";
+      const asked = answeredAt(window);
+      if (standing.emptiesInMs === null || asked === null) {
+        return { text: `${points}% ahead of pace`, tone };
+      }
+      const left = asked + standing.emptiesInMs - now;
+      return {
+        text: `${points}% ahead of pace · empties in ${span(left)}`,
+        tone,
+      };
+    }
+  }
+};
