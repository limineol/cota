+    { model: "glm-4.5-air", requests: 120, tokens: 1_900_000, cost: 1.7 },
+  ],
+};
+
+/** A pool with requests whose model has no price. */
+export const unpricedModel: PoolSummary = {
+  ...claudeSubscription,
+  pool: {
+    id: "codex",
