+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { expect, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { withApi } from "#stories/page.tsx";
+import {
+  claudeBeforeTheLog,
+  claudeSubscription,
+  quiet,
+  unpricedModel,
+  windowsNotRead,
+} from "#stories/pool.ts";
+import { PoolView } from "./pool.tsx";
+import type { PoolSummary, SummaryRange } from "./summary.ts";
+
+function Chosen({ summary }: { readonly summary: PoolSummary }) {
+  const [range, setRange] = useState<SummaryRange>(summary.range);
+  return <PoolView summary={{ ...summary, range }} onRangeChange={setRange} />;
+}
+
+const meta = {
+  title: "Screens/Pool",
+  component: Chosen,
+  decorators: [withApi([displayNames])],
+  parameters: { layout: "fullscreen" },
+} satisfies Meta<typeof Chosen>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const ClaudeSubscription: Story = {
+  args: { summary: claudeSubscription },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: "personal" }),
+    ).toBeVisible();
+    await expect(
+      await canvas.findByRole("meter", { name: "personal, 5-hour window" }),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("meter", { name: "personal, Weekly · Opus window" }),
+    ).toBeVisible();
+    const models = await canvas.findByRole("table", { name: "Models" });
+    await expect(within(models).getAllByRole("row")).toHaveLength(6);
+    await expect(within(models).getByText("Claude Opus 4.5")).toBeVisible();
+    await expect(
+      canvas.getByTitle("The requests of the 7 days before"),
+    ).toHaveTextContent("↑37%");
+    await expect(canvas.getByText(/the most was 188K tokens/)).toBeVisible();
+  },
+};
+
+export const WindowsNotRead: Story = {
+  args: { summary: windowsNotRead },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(/has not read this pool's quota windows/),
+    ).toBeVisible();
+    await expect(canvas.queryAllByRole("meter")).toHaveLength(0);
+  },
+};
+
+export const ModelWithNoPrice: Story = {
+  args: { summary: unpricedModel },
+  play: async ({ canvas }) => {
+    const models = await canvas.findByRole("table", { name: "Models" });
+    await expect(within(models).getByText("no price")).toBeVisible();
+    await expect(
+      canvas.getByText(/64 requests went to a model with no price/),
+    ).toBeVisible();
+    await expect(canvas.getByText("≥$21")).toBeVisible();
+  },
+};
+
+export const BeforeTheLogBegins: Story = {
+  args: { summary: claudeBeforeTheLog },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(/nothing before it to compare with/),
+    ).toBeVisible();
+    await expect(canvas.queryAllByTitle(/before$/)).toHaveLength(0);
+  },
+};
+
+export const NothingCarried: Story = {
+  args: { summary: quiet },
+  play: async ({ canvas }) => {
+    await expect(await canvas.findByText("No requests")).toBeVisible();
+    await expect(
+      (await canvas.findAllByText("No requests in the last 7 days.")).length,
+    ).toBeGreaterThan(0);
+  },
+};
+
+export const ChangingTheRange: Story = {
+  args: { summary: claudeSubscription },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(await canvas.findByRole("radio", { name: "30d" }));
+    await expect(canvas.getByRole("radio", { name: "30d" })).toBeChecked();
+    await expect(canvas.getByText("Last 30 days")).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  args: { summary: claudeSubscription },
+  globals: { viewport: { value: "mobile2" } },
+};
