@@ -0,0 +1,67 @@
+import type { WindowShape } from "#shared/windows.ts";
+import type { SummaryDay, SummaryRange, SummaryWindow } from "./summary.ts";
+
+export const rangeOptions: ReadonlyArray<{
+  readonly value: SummaryRange;
+  readonly label: string;
+}> = [
+  { value: "1d", label: "1d" },
+  { value: "7d", label: "7d" },
+  { value: "30d", label: "30d" },
+];
+
+export const rangeTitle: Record<SummaryRange, string> = {
+  "1d": "Last day",
+  "7d": "Last 7 days",
+  "30d": "Last 30 days",
+};
+
+/** The range before, as it ends "compared with the … before". */
+export const before: Record<SummaryRange, string> = {
+  "1d": "day",
+  "7d": "7 days",
+  "30d": "30 days",
+};
+
+const dayLength = 86_400_000;
+
+const dayName = new Intl.DateTimeFormat("en-US", {
+  month: "short",
+  day: "numeric",
+  timeZone: "UTC",
+});
+
+export const dayStart = (day: string) => Date.parse(day);
+
+/** A day of the summary as `Nov 3`: the hub's days are dates, so they are written in UTC, never moved by the viewer's zone. */
+export const dayLabel = (day: string) => dayName.format(dayStart(day));
+
+export const dayEnd = (day: string) => dayStart(day) + dayLength;
+
+/** A window of the answer with its reset in milliseconds, as the quota window line reads it. */
+export const shapeOf = (window: SummaryWindow): WindowShape => ({
+  lengthMs: window.lengthMs,
+  scope: window.scope,
+  usedPercent: window.usedPercent,
+  resetsAt: window.resetsAt === null ? null : Date.parse(window.resetsAt),
+  standing: window.standing,
+});
+
+/** The day with the largest prompt, the earliest of equals; none when no day reported a prompt size. */
+export const largestPrompt = (
+  days: ReadonlyArray<SummaryDay>,
+): { readonly day: string; readonly size: number } | null => {
+  let best: { readonly day: string; readonly size: number } | null = null;
+  for (const { day, promptSize } of days) {
+    if (promptSize === null) continue;
+    if (best === null || promptSize > best.size) {
+      best = { day, size: promptSize };
+    }
+  }
+  return best;
+};
+
+export const kindName = {
+  subscription: "Subscription",
+  keyed: "Keyed",
+} as const;
