@@ -0,0 +1,201 @@
+import type { PoolSummary } from "#screens/pool/summary.ts";
+
+const minute = 60_000;
+const hour = 60 * minute;
+const day = 24 * hour;
+
+const now = Math.floor(Date.now() / minute) * minute;
+
+const iso = (at: number) => new Date(at).toISOString();
+
+const dateOf = (at: number) => iso(at).slice(0, 10);
+
+const standingOf = (
+  length: number,
+  used: number,
+  elapsed: number,
+): NonNullable<PoolSummary["windows"][number]["standing"]> => {
+  const lead = used - elapsed * 100;
+  const pace =
+    used >= 100
+      ? "full"
+      : Math.abs(lead) < 2
+        ? "on-pace"
+        : lead < 0
+          ? "in-reserve"
+          : "ahead-of-pace";
+  return {
+    elapsed,
+    resetsInMs: Math.round((1 - elapsed) * length),
+    pace,
+    points:
+      pace === "in-reserve" || pace === "ahead-of-pace" ? Math.abs(lead) : null,
+    emptiesInMs:
+      pace === "ahead-of-pace"
+        ? Math.round(((100 - used) / used) * elapsed * length)
+        : null,
+  };
+};
+
+const windowOf = (
+  length: number,
+  used: number,
+  elapsed: number,
+  scope: string | null = null,
+): PoolSummary["windows"][number] => ({
+  lengthMs: length,
+  scope,
+  usedPercent: used,
+  startsAt: iso(now - Math.round(elapsed * length)),
+  resetsAt: iso(now + Math.round((1 - elapsed) * length)),
+  standing: standingOf(length, used, elapsed),
+});
+
+const daysOf = (
+  count: number,
+  figures: ReadonlyArray<readonly [number, number, number | null]>,
+): PoolSummary["days"] =>
+  Array.from({ length: count }, (_, index) => {
+    const [requests, tokens, promptSize] = figures[index % figures.length] ?? [
+      0,
+      0,
+      null,
+    ];
+    return {
+      day: dateOf(now - (count - 1 - index) * day),
+      requests,
+      tokens,
+      promptSize,
+    };
+  });
+
+const sevenDays = daysOf(7, [
+  [212, 9_400_000, 142_000],
+  [388, 18_200_000, 171_000],
+  [96, 3_100_000, 64_000],
+  [0, 0, null],
+  [454, 21_900_000, 188_000],
+  [301, 14_800_000, 96_000],
+  [177, 8_300_000, 153_000],
+]);
+
+const fiveModels: PoolSummary["models"] = [
+  { model: "claude-opus-4-5", requests: 402, tokens: 41_300_000, cost: 118.42 },
+  {
+    model: "claude-sonnet-4-5",
+    requests: 951,
+    tokens: 29_700_000,
+    cost: 31.07,
+  },
+  { model: "claude-haiku-4-5", requests: 214, tokens: 3_900_000, cost: 1.38 },
+  { model: "claude-opus-4-1", requests: 38, tokens: 1_150_000, cost: 6.9 },
+  { model: "claude-3-7-sonnet", requests: 22, tokens: 410_000, cost: 0.94 },
+];
+
+const claude: PoolSummary["pool"] = {
+  id: "personal",
+  kind: "subscription",
+  provider: "anthropic",
+  plan: "Max 20x",
+};
+
+const configured = ["personal", "work", "codex", "zai"];
+
+/** A Claude subscription with two windows and five models, over seven days the log covers twice. */
+export const claudeSubscription: PoolSummary = {
+  pool: claude,
+  pools: configured,
+  windows: [windowOf(5 * hour, 41, 0.42), windowOf(7 * day, 12, 0.49, "Opus")],
+  range: "7d",
+  logBegins: dateOf(now - 40 * day),
+  totals: {
+    requests: 1627,
+    tokens: 76_460_000,
+    cost: 158.71,
+    unpricedRequests: 0,
+    previous: { requests: 1188, tokens: 91_200_000, cost: 120.4 },
+  },
+  models: fiveModels,
+  days: sevenDays,
+};
+
+/** The same pool over a range that begins before the request log does. */
+export const claudeBeforeTheLog: PoolSummary = {
+  ...claudeSubscription,
+  range: "30d",
+  logBegins: dateOf(now - 9 * day),
+  totals: { ...claudeSubscription.totals, previous: null },
+  days: daysOf(30, [
+    [0, 0, null],
+    ...sevenDays.map((each): readonly [number, number, number | null] => [
+      each.requests,
+      each.tokens,
+      each.promptSize,
+    ]),
+  ]),
+};
+
+/** A pool whose quota windows the hub has not read. */
+export const windowsNotRead: PoolSummary = {
+  ...claudeSubscription,
+  pool: {
+    id: "zai",
+    kind: "keyed",
+    provider: "zai",
+    plan: null,
+  },
+  windows: [],
+  totals: {
+    requests: 640,
