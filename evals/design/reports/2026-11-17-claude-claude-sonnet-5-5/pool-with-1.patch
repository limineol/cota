@@ -0,0 +1,266 @@
+import { Badge } from "@cota/ui/components/badge";
+import { Card } from "@cota/ui/components/card";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+  Section,
+  SectionDescription,
+  SectionHeader,
+  SectionTitle,
+  Subheading,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Segmented } from "@cota/ui/components/segmented";
+import {
+  Stat,
+  StatDelta,
+  StatLabel,
+  StatNote,
+  StatValue,
+} from "@cota/ui/components/stat";
+import { poolHues } from "#shared/domain/hues.ts";
+import { delta, tokens } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { NowProvider } from "#shared/now.tsx";
+import { glyphOf } from "#shared/providers.tsx";
+import { WindowLine } from "#shared/window-line.tsx";
+import { costText, counted, plural } from "#shared/words.ts";
+import { PromptColumns } from "./context.tsx";
+import { ModelsTable } from "./models.tsx";
+import type { PoolSummary, SummaryRange } from "./summary.ts";
+import {
+  before,
+  dayLabel,
+  kindName,
+  largestPrompt,
+  rangeOptions,
+  rangeTitle,
+  shapeOf,
+} from "./words.ts";
+
+const during: Record<SummaryRange, string> = {
+  "1d": "in the last day",
+  "7d": "in the last 7 days",
+  "30d": "in the last 30 days",
+};
+
+interface Figure {
+  readonly label: string;
+  readonly value: string;
+  readonly current: number;
+  readonly previous: number | null;
+  readonly note?: string | undefined;
+}
+
+const figuresOf = (summary: PoolSummary): ReadonlyArray<Figure> => {
+  const { totals } = summary;
+  const previous = totals.previous;
+  return [
+    {
+      label: "Requests",
+      value: counted(totals.requests),
+      current: totals.requests,
+      previous: previous?.requests ?? null,
+    },
+    {
+      label: "Tokens",
+      value: tokens(totals.tokens),
+      current: totals.tokens,
+      previous: previous?.tokens ?? null,
+    },
+    {
+      label: "Cost",
+      value: costText(totals.cost, totals.unpricedRequests),
+      current: totals.cost,
+      previous: previous?.cost ?? null,
+      note:
+        totals.unpricedRequests > 0
+          ? `${plural(totals.unpricedRequests, "request")} with no price`
+          : "at API list prices",
+    },
+  ];
+};
+
+function Totals({ summary }: { readonly summary: PoolSummary }) {
+  return (
+    <div className="grid grid-cols-1 gap-2.5 @xl:grid-cols-3 wide:gap-3">
+      {figuresOf(summary).map((figure) => {
+        const change =
+          figure.previous === null
+            ? null
+            : delta(figure.current, figure.previous);
+        return (
+          <Stat key={figure.label} variant="tile">
+            <StatLabel>{figure.label}</StatLabel>
+            <StatValue>
+              {figure.value}
+              {change === null ? null : (
+                <StatDelta
+                  direction={change.direction}
+                  title={`The ${figure.label.toLowerCase()} of the ${before[summary.range]} before`}
+                >
+                  {change.text}
+                </StatDelta>
+              )}
+            </StatValue>
+            {figure.note === undefined ? null : (
+              <StatNote>{figure.note}</StatNote>
+            )}
+          </Stat>
+        );
+      })}
+    </div>
+  );
+}
+
+/** What the range covers, and why it has nothing to compare with when the log is too young. */
+const coverage = (summary: PoolSummary) => {
+  const first = summary.days[0]?.day;
+  const last = summary.days.at(-1)?.day;
+  const span =
+    first === undefined || last === undefined
+      ? rangeTitle[summary.range]
+      : `${dayLabel(first)} – ${dayLabel(last)}`;
+  if (summary.totals.previous !== null) {
+    return `${span}, compared with the ${before[summary.range]} before`;
+  }
+  return `${span} · the request log begins ${dayLabel(summary.logBegins)}, so there is nothing before it to compare with`;
+};
+
+/** One pool's page: its quota windows, what it carried over a range against the range before, its models and its largest prompts. */
+export function PoolView({
+  summary,
+  onRangeChange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onRangeChange: (range: SummaryRange) => void;
+}) {
+  return (
+    <NowProvider>
+      <PoolPage summary={summary} onRangeChange={onRangeChange} />
+    </NowProvider>
+  );
+}
+
+function PoolPage({
+  summary,
+  onRangeChange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onRangeChange: (range: SummaryRange) => void;
+}) {
+  const nameOf = useNameOf();
+  const { pool } = summary;
+  const hue = poolHues(summary.pools).get(pool.id) ?? "neutral";
+  const peak = largestPrompt(summary.days);
+  const empty = summary.totals.requests === 0;
+  const emptyText = `No requests ${during[summary.range]}.`;
+  return (
+    <Page className="@container">
+      <section aria-labelledby="pool-title">
+        <PageHeader>
+          <div className="flex min-w-0 flex-wrap items-center gap-2.5">
+            <PoolMark
+              hue={hue}
+              name={pool.id}
+              glyph={glyphOf(pool.provider)}
+              size="lg"
+            />
+            <PageTitle id="pool-title" title={pool.id}>
+              {nameOf("pool", pool.id)}
+            </PageTitle>
+            {pool.plan === null ? null : <Badge>{pool.plan}</Badge>}
+            <PageDescription>
+              {kindName[pool.kind]} · {pool.provider}
+            </PageDescription>
+          </div>
+        </PageHeader>
+        <section aria-labelledby="windows-title">
+          <h2 id="windows-title" className="sr-only">
+            Quota windows
+          </h2>
+          {summary.windows.length > 0 ? (
+            <div className="grid gap-6 @3xl:grid-cols-2">
+              {summary.windows.map((window) => (
+                <WindowLine
+                  key={`${window.lengthMs}-${window.scope ?? ""}`}
+                  window={shapeOf(window)}
+                  pool={pool.id}
+                  hue={hue}
+                  detailed
+                />
+              ))}
+            </div>
+          ) : (
+            <p className="text-base text-pretty text-text-2">
+              The hub has not read this pool's quota windows, so there is no
+              meter to show. A window appears here once the hub reads one or a
+              request reports it.
+            </p>
+          )}
+        </section>
+      </section>
+
+      <Section aria-labelledby="traffic-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="traffic-title">What it carried</SectionTitle>
+            <SectionDescription>{coverage(summary)}</SectionDescription>
+          </div>
+          <Segmented
+            label="Time range"
+            value={summary.range}
+            options={rangeOptions}
+            onValueChange={onRangeChange}
+          />
+        </SectionHeader>
+        <Totals summary={summary} />
+      </Section>
+
+      <Section aria-labelledby="models-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="models-title">Models</SectionTitle>
+            <SectionDescription>{rangeTitle[summary.range]}</SectionDescription>
+          </div>
+        </SectionHeader>
+        <Card size="compact">
+          <ModelsTable
+            models={summary.models}
+            labelledBy="models-title"
+            during={during[summary.range]}
+          />
+          {summary.totals.unpricedRequests > 0 ? (
+            <SectionDescription>
+              {plural(summary.totals.unpricedRequests, "request")} went to a
+              model with no price, so the cost above leaves them out.
+            </SectionDescription>
+          ) : null}
+        </Card>
+      </Section>
+
+      <Section aria-labelledby="context-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="context-title">Largest context</SectionTitle>
+            <SectionDescription>
+              {peak === null
+                ? "No request reported its prompt size."
+                : `The largest prompt of each day; the most was ${tokens(peak.size)} tokens, on ${dayLabel(peak.day)}.`}
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <Card size="compact">
+          <Subheading>Largest prompt, by day</Subheading>
+          <PromptColumns
+            days={summary.days}
+            hue={hue}
+            empty={empty ? emptyText : "No request reported its prompt size."}
+          />
+        </Card>
+      </Section>
+    </Page>
+  );
+}
