@@ -0,0 +1,66 @@
+import {
+  type BlockColumn,
+  BlockColumns,
+  type ColumnsLayout,
+} from "@cota/ui/components/block-columns";
+import { useMemo } from "react";
+import { stack } from "#shared/domain/columns.ts";
+import type { Hue } from "#shared/domain/hues.ts";
+import { tokens } from "#shared/domain/quantities.ts";
+import type { SummaryDay } from "./summary.ts";
+import { dayEnd, dayLabel, dayStart, largestPrompt } from "./words.ts";
+
+const noParts = [0];
+
+/** The largest prompt of each day as one column, never merged: a day's figure is a largest, which adding days would turn into a sum. */
+export function PromptColumns({
+  days,
+  hue,
+  empty,
+}: {
+  readonly days: ReadonlyArray<SummaryDay>;
+  readonly hue: Hue;
+  readonly empty: string;
+}) {
+  const peak = largestPrompt(days);
+  const fit = useMemo(() => {
+    const layout = stack(
+      days.map((day) => ({
+        start: dayStart(day.day),
+        end: dayEnd(day.day),
+        parts: day.promptSize === null ? noParts : [day.promptSize],
+      })),
+      1,
+    );
+    const result: ColumnsLayout = {
+      unit: `${tokens(layout.unit)} ${layout.unit === 1 ? "token" : "tokens"} of prompt`,
+      columns: layout.columns.map((column, index): BlockColumn => {
+        const size = days[index]?.promptSize ?? null;
+        const tick = dayLabel(days[index]?.day ?? "");
+        return {
+          key: days[index]?.day ?? String(index),
+          label:
+            size === null
+              ? `${tick} · no prompt size reported`
+              : `${tick} · largest prompt`,
+          tick,
+          total: size === null ? "—" : tokens(size),
+          parts: column.parts.map((blocks) => ({ blocks, value: null })),
+        };
+      }),
+    };
+    return () => result;
+  }, [days]);
+  return (
+    <BlockColumns
+      series={[{ key: "prompt", label: "Largest prompt", tint: hue }]}
+      fit={fit}
+      label={
+        peak === null
+          ? "Largest prompt of each day: none reported"
+          : `Largest prompt of each day, at most ${tokens(peak.size)} tokens on ${dayLabel(peak.day)}`
+      }
+      empty={empty}
+    />
+  );
+}
