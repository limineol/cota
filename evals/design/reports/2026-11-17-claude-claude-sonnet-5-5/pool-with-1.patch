@@ -0,0 +1,76 @@
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import { MagnitudeBar } from "@cota/ui/components/magnitude-bar";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableRow,
+} from "@cota/ui/components/table";
+import { cost, tokens } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { counted } from "#shared/words.ts";
+import type { PoolSummary } from "./summary.ts";
+
+/** The models the pool's requests went to, the most tokens first; a model with no price has no cost, said so. */
+export function ModelsTable({
+  models,
+  labelledBy,
+  during,
+}: {
+  readonly models: PoolSummary["models"];
+  readonly labelledBy: string;
+  readonly during: string;
+}) {
+  const nameOf = useNameOf();
+  if (models.length === 0) {
+    return (
+      <Empty>
+        <EmptyTitle>No requests</EmptyTitle>
+        <EmptyDescription>This pool carried nothing {during}.</EmptyDescription>
+      </Empty>
+    );
+  }
+  const ranked = models.toSorted((a, b) => b.tokens - a.tokens);
+  const peak = Math.max(1, ...ranked.map((row) => row.tokens));
+  return (
+    <Table aria-labelledby={labelledBy}>
+      <TableHeader>
+        <TableRow>
+          <TableHead scope="col">Model</TableHead>
+          <TableHead scope="col" numeric>
+            Requests
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Tokens
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Cost
+          </TableHead>
+        </TableRow>
+      </TableHeader>
+      <TableBody>
+        {ranked.map((row) => (
+          <TableRow key={row.model}>
+            <TableCell className="w-full max-w-0">
+              <TableLabel title={row.model}>
+                {nameOf("model", row.model)}
+              </TableLabel>
+              <MagnitudeBar
+                fraction={row.tokens / peak}
+                className="mt-1.25 max-w-55"
+              />
+            </TableCell>
+            <TableCell numeric>{counted(row.requests)}</TableCell>
+            <TableCell numeric>{tokens(row.tokens)}</TableCell>
+            <TableCell numeric>
+              {row.cost === null ? "no price" : cost(row.cost)}
+            </TableCell>
+          </TableRow>
+        ))}
+      </TableBody>
+    </Table>
+  );
+}
