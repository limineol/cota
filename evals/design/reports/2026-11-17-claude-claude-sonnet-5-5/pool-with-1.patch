+
+/** A pool that carried nothing in the range. */
+export const quiet: PoolSummary = {
+  ...claudeSubscription,
+  totals: {
+    requests: 0,
+    tokens: 0,
+    cost: 0,
+    unpricedRequests: 0,
+    previous: { requests: 12, tokens: 300_000, cost: 0.4 },
+  },
+  models: [],
+  days: daysOf(7, [[0, 0, null]]),
+};
