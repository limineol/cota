+
+const at = (milliseconds: number) => new Date(milliseconds).toISOString();
+
+const daysBack = (count: number) => {
+  const today = Math.floor(Date.now() / day) * day;
+  return Array.from({ length: count }, (_, index) =>
+    at(today - (count - 1 - index) * day).slice(0, 10),
+  );
+};
+
+const daysOf = (
+  count: number,
+  shape: (index: number) => Omit<DayRow, "day">,
+): ReadonlyArray<DayRow> =>
+  daysBack(count).map((each, index) => ({ day: each, ...shape(index) }));
