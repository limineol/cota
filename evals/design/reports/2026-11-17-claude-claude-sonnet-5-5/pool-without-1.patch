@@ -0,0 +1,61 @@
+export const ranges = ["1d", "7d", "30d"] as const;
+
+export type Range = (typeof ranges)[number];
+
+export type Pace = "full" | "on-pace" | "in-reserve" | "ahead-of-pace";
+
+export interface QuotaWindow {
+  readonly lengthMs: number;
+  readonly scope: string | null;
+  readonly usedPercent: number;
+  readonly startsAt: string | null;
+  readonly resetsAt: string | null;
+  readonly standing: {
+    readonly elapsed: number;
+    readonly resetsInMs: number;
+    readonly pace: Pace;
+    readonly points: number | null;
+    readonly emptiesInMs: number | null;
+  } | null;
+}
+
+export interface ModelRow {
+  readonly model: string;
+  readonly requests: number;
+  readonly tokens: number;
+  readonly cost: number | null;
+}
+
+export interface DayRow {
+  readonly day: string;
+  readonly requests: number;
+  readonly tokens: number;
+  readonly promptSize: number | null;
+}
+
+/** What `GET /api/pools/:pool/summary?range=` answers. */
+export interface PoolSummary {
+  readonly pool: {
+    readonly id: string;
+    readonly kind: "subscription" | "keyed";
+    readonly provider: string;
+    readonly plan: string | null;
+  };
+  readonly pools: ReadonlyArray<string>;
+  readonly windows: ReadonlyArray<QuotaWindow>;
+  readonly range: Range;
+  readonly logBegins: string;
+  readonly totals: {
+    readonly requests: number;
+    readonly tokens: number;
+    readonly cost: number;
+    readonly unpricedRequests: number;
+    readonly previous: {
+      readonly requests: number;
+      readonly tokens: number;
+      readonly cost: number;
+    } | null;
+  };
+  readonly models: ReadonlyArray<ModelRow>;
+  readonly days: ReadonlyArray<DayRow>;
+}
