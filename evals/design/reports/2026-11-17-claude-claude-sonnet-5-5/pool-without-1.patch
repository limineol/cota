@@ -0,0 +1,85 @@
+import {
+  type BlockColumn,
+  BlockColumns,
+  type ColumnsLayout,
+} from "@cota/ui/components/block-columns";
+import { Stat, StatLabel, StatNote, StatValue } from "@cota/ui/components/stat";
+import { stack } from "#shared/domain/columns.ts";
+import type { Hue } from "#shared/domain/hues.ts";
+import { tokens } from "#shared/domain/quantities.ts";
+import { plural } from "#shared/words.ts";
+import type { DayRow } from "./summary.ts";
+import { dayText } from "./words.ts";
+
+/** The day whose requests reached the largest prompt, the first of them when two tie; null when none reported a size. */
+export const peakDay = (days: ReadonlyArray<DayRow>): DayRow | null =>
+  days.reduce<DayRow | null>(
+    (best, day) =>
+      day.promptSize !== null &&
+      (best === null || day.promptSize > (best.promptSize ?? 0))
+        ? day
+        : best,
+    null,
+  );
+
+/** The largest prompt of each day of the range as columns of blocks, and the largest of them all. */
+export function Context({
+  days,
+  hue,
+}: {
+  readonly days: ReadonlyArray<DayRow>;
+  readonly hue: Hue;
+}) {
+  const peak = peakDay(days);
+  const { unit, columns } = stack(
+    days.map((day) => ({
+      start: Date.parse(day.day),
+      end: Date.parse(day.day) + 86_400_000,
+      parts: [day.promptSize ?? 0],
+    })),
+    1,
+  );
+  const fit = (): ColumnsLayout => ({
+    unit: `${tokens(unit)} tokens of prompt`,
+    columns: columns.map((column, index): BlockColumn => {
+      const day = days[index];
+      const size = day?.promptSize ?? null;
+      return {
+        key: day?.day ?? String(column.bucket.start),
+        label:
+          day === undefined
+            ? ""
+            : `${dayText(day.day)} · ${plural(day.requests, "request")} · ${tokens(day.tokens)} tokens`,
+        tick: day === undefined ? "" : dayText(day.day),
+        total: size === null ? "no prompt size" : `${tokens(size)} prompt`,
+        parts: [
+          {
+            blocks: column.parts[0] ?? 0,
+            value: size === null ? null : tokens(size),
+          },
+        ],
+      };
+    }),
+  });
+  return (
+    <div className="flex flex-col gap-4">
+      <Stat variant="tile" className="max-w-sm">
+        <StatLabel>Largest context</StatLabel>
+        <StatValue>
+          {peak?.promptSize == null ? "unreported" : tokens(peak.promptSize)}
+        </StatValue>
+        <StatNote>
+          {peak === null
+            ? "no request of the range reported its prompt size"
+            : `the prompt of a request on ${dayText(peak.day)}`}
+        </StatNote>
+      </Stat>
+      <BlockColumns
+        series={[{ key: "prompt", label: "Largest prompt", tint: hue }]}
+        fit={fit}
+        label="The largest prompt of each day"
+        empty="No request of the range reported its prompt size."
+      />
+    </div>
+  );
+}
