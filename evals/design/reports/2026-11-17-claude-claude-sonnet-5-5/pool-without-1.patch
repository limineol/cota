@@ -0,0 +1,81 @@
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import { MagnitudeBar } from "@cota/ui/components/magnitude-bar";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableFlag,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableRow,
+} from "@cota/ui/components/table";
+import { tokens } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { costText, counted } from "#shared/words.ts";
+import type { ModelRow, Range } from "./summary.ts";
+import { during } from "./words.ts";
+
+/** The models the range's requests went to, most tokens first. */
+export function Models({
+  models,
+  range,
+  labelledBy,
+}: {
+  readonly models: ReadonlyArray<ModelRow>;
+  readonly range: Range;
+  readonly labelledBy: string;
+}) {
+  const nameOf = useNameOf();
+  if (models.length === 0) {
+    return (
+      <Empty>
+        <EmptyTitle>No model traffic</EmptyTitle>
+        <EmptyDescription>Nothing was logged {during[range]}.</EmptyDescription>
+      </Empty>
+    );
+  }
+  const rows = models.toSorted((a, b) => b.tokens - a.tokens);
+  const peak = Math.max(1, ...rows.map((row) => row.tokens));
+  return (
+    <Table aria-labelledby={labelledBy}>
+      <TableHeader>
+        <TableRow>
+          <TableHead scope="col">Model</TableHead>
+          <TableHead scope="col" numeric>
+            Requests
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Tokens
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Cost
+          </TableHead>
+        </TableRow>
+      </TableHeader>
+      <TableBody>
+        {rows.map((row) => (
+          <TableRow key={row.model}>
+            <TableCell className="w-full max-w-0">
+              <span className="flex min-w-0 items-center gap-1.75">
+                <TableLabel title={row.model}>
+                  {nameOf("model", row.model)}
+                </TableLabel>
+                {row.cost === null ? <TableFlag>no price</TableFlag> : null}
+              </span>
+              <MagnitudeBar
+                fraction={row.tokens / peak}
+                className="mt-1.25 max-w-55"
+              />
+            </TableCell>
+            <TableCell numeric>{counted(row.requests)}</TableCell>
+            <TableCell numeric>{tokens(row.tokens)}</TableCell>
+            <TableCell numeric>
+              {row.cost === null ? "no price" : costText(row.cost, 0)}
+            </TableCell>
+          </TableRow>
+        ))}
+      </TableBody>
+    </Table>
+  );
+}
