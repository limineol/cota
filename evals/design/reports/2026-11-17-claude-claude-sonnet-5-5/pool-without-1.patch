+import {
+  Stat,
+  StatDelta,
+  StatLabel,
+  StatNote,
+  StatValue,
+} from "@cota/ui/components/stat";
+import { delta, tokens } from "#shared/domain/quantities.ts";
+import { costText, counted, plural } from "#shared/words.ts";
+import type { PoolSummary } from "./summary.ts";
+
+type Totals = PoolSummary["totals"];
+
+interface Figure {
+  readonly label: string;
+  readonly value: string;
+  readonly current: number;
+  readonly previous: number | null;
+  readonly note?: string;
+}
+
+const figuresOf = (totals: Totals): ReadonlyArray<Figure> => [
+  {
+    label: "Requests",
+    value: counted(totals.requests),
+    current: totals.requests,
+    previous: totals.previous?.requests ?? null,
+  },
+  {
+    label: "Tokens",
+    value: tokens(totals.tokens),
+    current: totals.tokens,
+    previous: totals.previous?.tokens ?? null,
+  },
+  {
+    label: "Cost",
+    value: costText(totals.cost, totals.unpricedRequests),
+    current: totals.cost,
+    previous: totals.previous?.cost ?? null,
+    note:
+      totals.unpricedRequests > 0
+        ? `${plural(totals.unpricedRequests, "request")} with no price`
+        : "at API list prices",
+  },
+];
+
+/** The range's requests, tokens and cost, each beside the range before it where the request log covers that. */
+export function Totals({ totals }: { readonly totals: Totals }) {
+  return (
+    <div className="grid grid-cols-1 gap-2.5 @2xl:grid-cols-3 wide:gap-3">
+      {figuresOf(totals).map((figure) => {
+        const change =
+          figure.previous === null
+            ? null
+            : delta(figure.current, figure.previous);
+        return (
+          <Stat key={figure.label} variant="tile">
+            <StatLabel>{figure.label}</StatLabel>
+            <StatValue>
+              {figure.value}
+              {change === null ? null : (
+                <StatDelta
+                  direction={change.direction}
+                  title={`The ${figure.label.toLowerCase()} of the range before`}
+                >
+                  {change.text}
+                </StatDelta>
+              )}
+            </StatValue>
+            <StatNote>
+              {figure.note ?? ""}
+              {change === null
+                ? `${figure.note === undefined ? "" : " · "}the range before is not in the request log`
+                : ""}
+            </StatNote>
+          </Stat>
+        );
+      })}
+    </div>
+  );
+}
diff --git a/apps/web/src/screens/pool/windows.tsx b/apps/web/src/screens/pool/windows.tsx
new file mode 100644
index 0000000..7fc8e9a
--- /dev/null
+++ b/apps/web/src/screens/pool/windows.tsx
@@ -0,0 +1,117 @@
+import { BlockMeter } from "@cota/ui/components/block-meter";
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  Pace,
+  QuotaWindow as QuotaWindowBox,
+  QuotaWindowFoot,
+  QuotaWindowHead,
+  QuotaWindowLabel,
+  QuotaWindowReset,
+  QuotaWindowUsed,
+} from "@cota/ui/components/quota-window";
+import type { Hue } from "#shared/domain/hues.ts";
+import { meter } from "#shared/domain/meter.ts";
+import { span } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { useNow } from "#shared/now.tsx";
+import { when } from "#shared/words.ts";
+import type { PoolSummary, QuotaWindow } from "./summary.ts";
+import { paceOf, usedText, windowName } from "./words.ts";
+
+function WindowLine({
+  window,
+  pool,
+  hue,
+}: {
+  readonly window: QuotaWindow;
+  readonly pool: string;
+  readonly hue: Hue;
+}) {
+  const now = useNow();
+  const nameOf = useNameOf();
+  const name = windowName(window);
+  const pace = paceOf(window, now);
+  const {
+    blocks,
+    severity,
+    pace: marker,
+  } = meter({
+    usedPercent: window.usedPercent,
+    elapsed: window.standing?.elapsed ?? null,
+  });
+  const resetsAt =
+    window.resetsAt === null ? null : Date.parse(window.resetsAt);
+  const used = usedText(window);
+  return (
+    <QuotaWindowBox size="detail">
+      <QuotaWindowHead>
+        <QuotaWindowLabel>{name}</QuotaWindowLabel>
+        <QuotaWindowUsed>{used}</QuotaWindowUsed>
+        <QuotaWindowReset>
+          {resetsAt === null
+            ? "Not started"
+            : `Resets in ${span(resetsAt - now)}`}
+        </QuotaWindowReset>
+      </QuotaWindowHead>
+      <BlockMeter
+        blocks={blocks}
+        pace={marker}
+        severity={severity}
+        hue={hue}
+        size="detail"
+        label={`${nameOf("pool", pool)}, ${name} window`}
+        valueText={pace === null ? used : `${used}, ${pace.text}`}
+      />
+      {pace !== null || resetsAt !== null ? (
+        <QuotaWindowFoot>
+          {pace === null ? null : <Pace tone={pace.tone}>{pace.text}</Pace>}
+          {resetsAt === null ? null : <span>Resets {when(resetsAt, now)}</span>}
+        </QuotaWindowFoot>
+      ) : null}
+    </QuotaWindowBox>
+  );
+}
+
+/** Why a pool has no windows to show: a keyed pool has none to read, a subscription's have not been read yet. */
+const noWindows = (kind: PoolSummary["pool"]["kind"]) =>
+  kind === "keyed"
+    ? {
+        title: "A keyed pool has no quota windows",
+        description:
+          "It is paid by the token, so its provider reports no allowance to meter.",
+      }
+    : {
+        title: "The hub has not read this pool's windows",
+        description:
+          "Its quota windows appear once the hub reads them, or once a request reports them.",
+      };
+
+export function Windows({
+  summary,
+  hue,
+}: {
+  readonly summary: PoolSummary;
+  readonly hue: Hue;
+}) {
+  if (summary.windows.length === 0) {
+    const none = noWindows(summary.pool.kind);
+    return (
+      <Empty>
+        <EmptyTitle>{none.title}</EmptyTitle>
+        <EmptyDescription>{none.description}</EmptyDescription>
+      </Empty>
+    );
+  }
+  return (
+    <div className="grid gap-x-10 gap-y-6 @3xl:grid-cols-2">
+      {summary.windows.map((window) => (
+        <WindowLine
+          key={`${window.lengthMs}-${window.scope ?? ""}`}
+          window={window}
+          pool={summary.pool.id}
+          hue={hue}
+        />
+      ))}
+    </div>
+  );
+}
