+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { expect, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { withApi } from "#stories/page.tsx";
+import {
+  claudeSubscription,
+  quietRange,
+  unpricedModel,
+  unreadWindows,
+} from "#stories/pool.ts";
+import { Pool } from "./pool.tsx";
+import type { PoolSummary, Range } from "./summary.ts";
+
+const meta = {
+  title: "Screens/Pool",
+  decorators: [withApi([displayNames])],
+  parameters: { layout: "fullscreen" },
+} satisfies Meta;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+function Shown({ summary }: { readonly summary: PoolSummary }) {
+  const [range, setRange] = useState<Range>(summary.range);
+  return <Pool summary={{ ...summary, range }} onRangeChange={setRange} />;
+}
+
+const showing = (summary: PoolSummary): Story => ({
+  render: () => <Shown summary={summary} />,
+});
+
+export const ClaudeSubscription: Story = {
+  ...showing(claudeSubscription),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: "Personal plan" }),
+    ).toBeVisible();
+    await expect(canvas.getByText("Weekly")).toBeVisible();
+    await expect(canvas.getByText("5-hour")).toBeVisible();
+    const models = await canvas.findByRole("table", { name: "Models" });
+    await expect(within(models).getAllByRole("row")).toHaveLength(6);
+    await expect(
+      canvas.getByRole("group", { name: /^The largest prompt of each day/ }),
+    ).toBeVisible();
+  },
+};
+
+export const WindowsNotRead: Story = {
+  ...showing(unreadWindows),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub has not read this pool's windows"),
+    ).toBeVisible();
+    await expect(
+      canvas.getAllByText(/the range before is not in the request log/i),
+    ).toHaveLength(3);
+  },
+};
+
+export const ModelWithoutAPrice: Story = {
+  ...showing(unpricedModel),
+  play: async ({ canvas }) => {
+    const models = await canvas.findByRole("table", { name: "Models" });
+    await expect(within(models).getAllByText("no price")).toHaveLength(2);
+    await expect(canvas.getByText("610 requests with no price")).toBeVisible();
+    await expect(canvas.getByText("≥$18.40")).toBeVisible();
+  },
+};
+
+export const NothingInTheRange: Story = {
+  ...showing(quietRange),
+  play: async ({ canvas }) => {
+    await expect(await canvas.findByText("No model traffic")).toBeVisible();
+  },
+};
+
+export const RangeChosen: Story = {
+  ...showing(claudeSubscription),
+  play: async ({ canvas, userEvent }) => {
+    const thirty = await canvas.findByRole("radio", { name: "30 days" });
+    await userEvent.click(thirty);
+    await expect(thirty).toBeChecked();
+  },
+};
+
+export const Narrow: Story = {
+  ...showing(claudeSubscription),
+  globals: { viewport: { value: "mobile2" } },
+};
