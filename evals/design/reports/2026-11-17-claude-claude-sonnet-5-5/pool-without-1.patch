@@ -0,0 +1,150 @@
+import { Badge } from "@cota/ui/components/badge";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+  Section,
+  SectionDescription,
+  SectionHeader,
+  SectionTitle,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Segmented } from "@cota/ui/components/segmented";
+import { Skeleton } from "@cota/ui/components/skeleton";
+import { poolHues } from "#shared/domain/hues.ts";
+import { Name, useNameOf } from "#shared/names.tsx";
+import { NowProvider, useNow } from "#shared/now.tsx";
+import { glyphOf } from "#shared/providers.tsx";
+import { dayOf } from "#shared/words.ts";
+import { Context } from "./context.tsx";
+import { Models } from "./models.tsx";
+import type { PoolSummary, Range } from "./summary.ts";
+import { Totals } from "./totals.tsx";
+import { Windows } from "./windows.tsx";
+import { rangeDays, rangeOptions } from "./words.ts";
+
+const day = 86_400_000;
+
+const kindName = { subscription: "Subscription", keyed: "Keyed" } as const;
+
+/** Whether the range, counted back from `now`, begins before the request log does. */
+export const beginsBeforeLog = (range: Range, logBegins: string, now: number) =>
+  now - rangeDays[range] * day < Date.parse(logBegins);
+
+function PoolPage({
+  summary,
+  onRangeChange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onRangeChange: (range: Range) => void;
+}) {
+  const now = useNow();
+  const nameOf = useNameOf();
+  const { pool, range, totals } = summary;
+  const hue = poolHues(summary.pools).get(pool.id) ?? "neutral";
+  const cut = beginsBeforeLog(range, summary.logBegins, now);
+  return (
+    <Page className="@container">
+      <PageHeader>
+        <div className="flex items-center gap-3">
+          <PoolMark
+            hue={hue}
+            name={nameOf("pool", pool.id)}
+            glyph={glyphOf(pool.provider)}
+            size="md"
+          />
+          <div>
+            <PageTitle>
+              <Name kind="pool" value={pool.id} />
+            </PageTitle>
+            <PageDescription>
+              <Badge>{pool.plan ?? kindName[pool.kind]}</Badge>
+            </PageDescription>
+          </div>
+        </div>
+        <Segmented
+          label="Range"
+          value={range}
+          options={rangeOptions}
+          onValueChange={onRangeChange}
+        />
+      </PageHeader>
+
+      <Section aria-labelledby="pool-windows" className="mt-0 wide:mt-0">
+        <SectionHeader>
+          <SectionTitle id="pool-windows">Quota windows</SectionTitle>
+        </SectionHeader>
+        <Windows summary={summary} hue={hue} />
+      </Section>
+
+      <Section aria-labelledby="pool-traffic">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="pool-traffic">Traffic</SectionTitle>
+            <SectionDescription>
+              {totals.previous === null
+                ? "The range before begins earlier than the request log, so there is nothing to compare with."
+                : "Each figure beside the range before."}
+              {cut
+                ? ` The request log begins ${dayOf(Date.parse(summary.logBegins))}, inside this range.`
+                : ""}
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <Totals totals={totals} />
+      </Section>
+
+      <Section aria-labelledby="pool-models">
+        <SectionHeader>
+          <SectionTitle id="pool-models">Models</SectionTitle>
+        </SectionHeader>
+        <Models
+          models={summary.models}
+          range={range}
+          labelledBy="pool-models"
+        />
+      </Section>
+
+      <Section aria-labelledby="pool-context">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="pool-context">Context</SectionTitle>
+            <SectionDescription>
+              The largest prompt a request sent on each day.
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <Context days={summary.days} hue={hue} />
+      </Section>
+    </Page>
+  );
+}
+
+/** One pool's page: its quota windows, what it carried over the range against the range before, its models and its largest context. */
+export function Pool({
+  summary,
+  onRangeChange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onRangeChange: (range: Range) => void;
+}) {
+  return (
+    <NowProvider>
+      <PoolPage summary={summary} onRangeChange={onRangeChange} />
+    </NowProvider>
+  );
+}
+
+export function PoolSkeleton() {
+  return (
+    <Page>
+      <div role="status" aria-busy="true" aria-label="The pool is loading">
+        <Skeleton className="mb-6 h-8 w-1/3" />
+        <Skeleton className="mb-10 h-24 w-full" />
+        <Skeleton className="mb-10 h-20 w-full" />
+        <Skeleton className="h-48 w-full" />
+      </div>
+    </Page>
+  );
+}
