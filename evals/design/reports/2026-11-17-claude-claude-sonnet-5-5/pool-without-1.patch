+import { share, span } from "#shared/domain/quantities.ts";
+import type { QuotaWindow, Range } from "./summary.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+
+const named: Record<number, string> = {
+  [5 * hour]: "5-hour",
+  [day]: "Daily",
+  [7 * day]: "Weekly",
+  [28 * day]: "Monthly",
+  [30 * day]: "Monthly",
+  [31 * day]: "Monthly",
+};
+
+/** A window's name for people, from its length and scope: `5-hour`, `Weekly`, `Weekly · Opus`. */
+export const windowName = (window: QuotaWindow) => {
+  const base =
+    named[window.lengthMs] ??
+    (window.lengthMs < day
+      ? `${Math.round(window.lengthMs / hour)}-hour`
+      : `${Math.round(window.lengthMs / day)}-day`);
+  return window.scope === null ? base : `${base} · ${window.scope}`;
+};
+
+export const usedText = (window: QuotaWindow) =>
+  `${share(window.usedPercent / 100)} used`;
+
+export type Tone = "ok" | "warn" | "danger";
+
+/** A window's pace in words, as the hub decided it, with any emptying time counted down from `now`. */
+export const paceOf = (
+  window: QuotaWindow,
+  now: number,
+): { readonly text: string; readonly tone: Tone } | null => {
+  const standing = window.standing;
+  if (standing === null) return null;
+  const points = Math.round(Math.abs(standing.points ?? 0));
+  switch (standing.pace) {
+    case "full":
+      return { text: "Full until the reset", tone: "danger" };
+    case "on-pace":
+      return { text: "On pace", tone: "ok" };
+    case "in-reserve":
+      return { text: `${points}% in reserve`, tone: "ok" };
+    case "ahead-of-pace": {
+      const tone = window.usedPercent >= 80 ? "danger" : "warn";
+      if (standing.emptiesInMs === null || window.resetsAt === null) {
+        return { text: `${points}% ahead of pace`, tone };
+      }
+      const asked = Date.parse(window.resetsAt) - standing.resetsInMs;
+      return {
+        text: `${points}% ahead of pace · empties in ${span(
+          asked + standing.emptiesInMs - now,
+        )}`,
+        tone,
+      };
+    }
+  }
+};
+
+export const rangeOptions: ReadonlyArray<{
+  readonly value: Range;
+  readonly label: string;
+}> = [
+  { value: "1d", label: "1 day" },
+  { value: "7d", label: "7 days" },
+  { value: "30d", label: "30 days" },
+];
+
+export const rangeDays: Record<Range, number> = { "1d": 1, "7d": 7, "30d": 30 };
+
+/** What the range covers, as it ends "Nothing was logged …". */
+export const during: Record<Range, string> = {
+  "1d": "in the last day",
+  "7d": "in the last 7 days",
+  "30d": "in the last 30 days",
+};
+
+const dayFormat = new Intl.DateTimeFormat("en-US", {
+  month: "short",
+  day: "numeric",
+  timeZone: "UTC",
+});
+
+/** A day of the answer, an ISO date, as `Nov 15`, whatever zone the viewer is in. */
+export const dayText = (day: string) => dayFormat.format(Date.parse(day));
