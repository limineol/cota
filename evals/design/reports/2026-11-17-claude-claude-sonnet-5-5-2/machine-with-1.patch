@@ -0,0 +1,76 @@
+import { Stat, StatLabel, StatNote, StatValue } from "@cota/ui/components/stat";
+import { type Figures, roles } from "#shared/domain/machine-day.ts";
+import { tokens } from "#shared/domain/quantities.ts";
+import { costText, counted, plural } from "#shared/words.ts";
+
+/** The roles a set of requests has, in words: `212 main · 14 title`. */
+export const rolesText = (figures: Figures) =>
+  roles
+    .filter((role) => figures.roles[role] > 0)
+    .map((role) => `${counted(figures.roles[role])} ${role}`)
+    .join(" · ");
+
+/** The outcomes that were not an answer, in words: `2 refused · 1 error`, or none. */
+export const unansweredText = (figures: Figures) =>
+  [
+    figures.outcomes.error > 0 ? plural(figures.outcomes.error, "error") : null,
+    figures.outcomes.refused > 0
+      ? `${counted(figures.outcomes.refused)} refused`
+      : null,
+    figures.outcomes.cancelled > 0
+      ? `${counted(figures.outcomes.cancelled)} cancelled`
+      : null,
+  ]
+    .filter((part) => part !== null)
+    .join(" · ");
+
+export function DayFigures({
+  sessions,
+  figures,
+}: {
+  readonly sessions: number;
+  readonly figures: Figures;
+}) {
+  const unanswered = unansweredText(figures);
+  return (
+    <section
+      aria-label="Figures"
+      className="grid grid-cols-2 gap-2.5 @3xl:grid-cols-5 wide:gap-3"
+    >
+      <Stat variant="tile">
+        <StatLabel>Sessions</StatLabel>
+        <StatValue>{counted(sessions)}</StatValue>
+      </Stat>
+      <Stat variant="tile">
+        <StatLabel>Requests</StatLabel>
+        <StatValue>{counted(figures.requests)}</StatValue>
+        <StatNote>{rolesText(figures) || "none"}</StatNote>
+      </Stat>
+      <Stat variant="tile">
+        <StatLabel>Not answered</StatLabel>
+        <StatValue tone={figures.outcomes.error > 0 ? "danger" : "default"}>
+          {counted(
+            figures.outcomes.error +
+              figures.outcomes.refused +
+              figures.outcomes.cancelled,
+          )}
+        </StatValue>
+        <StatNote>{unanswered || "every request was answered"}</StatNote>
+      </Stat>
+      <Stat variant="tile">
+        <StatLabel>Largest context</StatLabel>
+        <StatValue>
+          {figures.peakContext === null
+            ? "unreported"
+            : tokens(figures.peakContext)}
+        </StatValue>
+        <StatNote>largest prompt of a main request</StatNote>
+      </Stat>
+      <Stat variant="tile">
+        <StatLabel>Cost</StatLabel>
+        <StatValue>{costText(figures.cost, figures.unpriced)}</StatValue>
+        <StatNote>{tokens(figures.output)} tokens of output</StatNote>
+      </Stat>
+    </section>
+  );
+}
