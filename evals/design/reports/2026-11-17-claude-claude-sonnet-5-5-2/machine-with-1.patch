@@ -0,0 +1,183 @@
+import { BackLink } from "@cota/ui/components/back-link";
+import { BlockMix } from "@cota/ui/components/block-mix";
+import { buttonVariants } from "@cota/ui/components/button";
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFoot,
+} from "@cota/ui/components/list-panel";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+  Section,
+  SectionDescription,
+  SectionHeader,
+  SectionTitle,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Link } from "@tanstack/react-router";
+import { cloneElement, type ReactElement, type ReactNode } from "react";
+import { apportion, mixBlocks } from "#shared/domain/blocks.ts";
+import { poolHues } from "#shared/domain/hues.ts";
+import { adjacentDay, figuresOf } from "#shared/domain/machine-day.ts";
+import { share } from "#shared/domain/quantities.ts";
+import { rememberedList } from "#shared/last-list.ts";
+import { Name, useNameOf } from "#shared/names.tsx";
+import { counted, plural } from "#shared/words.ts";
+import type { MachineDay } from "./day.ts";
+import { DayFigures } from "./figures.tsx";
+import { SessionsTable } from "./sessions.tsx";
+
+const dayWords = new Intl.DateTimeFormat("en-US", {
+  weekday: "long",
+  month: "long",
+  day: "numeric",
+  year: "numeric",
+  timeZone: "UTC",
+});
+
+/** An ISO date in words, `Monday, November 16, 2026`. */
+export const dayText = (day: string) =>
+  dayWords.format(Date.parse(`${day}T00:00:00Z`));
+
+function DayStep({
+  to,
+  link,
+  children,
+}: {
+  readonly to: string;
+  readonly link: (day: string) => ReactElement<{ className?: string }>;
+  readonly children: ReactNode;
+}) {
+  return cloneElement(
+    link(to),
+    { className: buttonVariants({ variant: "outline", size: "sm" }) },
+    children,
+  );
+}
+
+/** The two days beside this one, as links the renderer gives. */
+function Days({
+  day,
+  dayLink,
+}: {
+  readonly day: string;
+  readonly dayLink: (day: string) => ReactElement<{ className?: string }>;
+}) {
+  return (
+    <nav aria-label="Days" className="flex items-center gap-2">
+      <DayStep to={adjacentDay(day, -1)} link={dayLink}>
+        ← Day before
+      </DayStep>
+      <DayStep to={adjacentDay(day, 1)} link={dayLink}>
+        Day after →
+      </DayStep>
+    </nav>
+  );
+}
+
+function PoolSplit({ answer }: { readonly answer: MachineDay }) {
+  const nameOf = useNameOf();
+  const hues = poolHues(answer.pools);
+  const requestsOf = (pool: string) =>
+    answer.sessions
+      .filter((session) => session.pool === pool)
+      .reduce((sum, session) => sum + session.requests.length, 0);
+  const used = answer.pools.filter((pool) => requestsOf(pool) > 0);
+  const counts = used.map(requestsOf);
+  const total = counts.reduce((sum, count) => sum + count, 0);
+  const blocks = apportion(counts, mixBlocks);
+  return (
+    <BlockMix
+      label="Requests by pool"
+      empty="No pool took a request."
+      parts={used.map((pool, at) => ({
+        key: pool,
+        label: nameOf("pool", pool),
+        value: plural(counts[at] ?? 0, "request"),
+        share: share((counts[at] ?? 0) / total),
+        blocks: blocks[at] ?? 0,
+        tint: hues.get(pool) ?? "neutral",
+      }))}
+    />
+  );
+}
+
+export function Machine({
+  answer,
+  dayLink,
+}: {
+  readonly answer: MachineDay;
+  /** The link to another day of this machine, which whoever renders the screen routes. */
+  readonly dayLink: (day: string) => ReactElement<{ className?: string }>;
+}) {
+  const hues = poolHues(answer.pools);
+  const figures = figuresOf(
+    answer.sessions.flatMap((session) => session.requests),
+  );
+  const markOf = (pool: string) => (
+    <PoolMark hue={hues.get(pool) ?? "neutral"} name={pool} />
+  );
+  return (
+    <Page className="@container">
+      <BackLink render={<Link to="/sessions" search={rememberedList()} />}>
+        Sessions
+      </BackLink>
+      <PageHeader>
+        <div>
+          <PageTitle>
+            <Name kind="machine" value={answer.machine} />
+          </PageTitle>
+          <PageDescription>{dayText(answer.day)}</PageDescription>
+        </div>
+        <Days day={answer.day} dayLink={dayLink} />
+      </PageHeader>
+      {answer.sessions.length === 0 ? (
+        <Empty className="my-12">
+          <EmptyTitle>This machine sent no request this day.</EmptyTitle>
+          <EmptyDescription>
+            The request log has no session of this machine on{" "}
+            {dayText(answer.day)}. Move to another day to find where it worked.
+          </EmptyDescription>
+        </Empty>
+      ) : (
+        <>
+          <DayFigures sessions={answer.sessions.length} figures={figures} />
+          <Section aria-labelledby="pools-title">
+            <SectionHeader>
+              <div>
+                <SectionTitle id="pools-title">Pools</SectionTitle>
+                <SectionDescription>
+                  Each block is 2% of the day's {counted(figures.requests)}{" "}
+                  requests, by the pool they went through.
+                </SectionDescription>
+              </div>
+            </SectionHeader>
+            <PoolSplit answer={answer} />
+          </Section>
+          <Section aria-labelledby="sessions-title">
+            <SectionHeader>
+              <div>
+                <SectionTitle id="sessions-title">Sessions</SectionTitle>
+                <SectionDescription>
+                  Each leads to its own page.
+                </SectionDescription>
+              </div>
+            </SectionHeader>
+            <ListPanel aria-label="The day's sessions">
+              <ListPanelBody>
+                <SessionsTable sessions={answer.sessions} markOf={markOf} />
+              </ListPanelBody>
+              <ListPanelFoot>
+                <span>{plural(answer.sessions.length, "session")}</span>
+              </ListPanelFoot>
+            </ListPanel>
+          </Section>
+        </>
+      )}
+    </Page>
+  );
+}
diff --git a/apps/web/src/screens/machine/sessions.tsx b/apps/web/src/screens/machine/sessions.tsx
