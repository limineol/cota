@@ -0,0 +1,37 @@
+import type { Outcome, Role } from "#shared/domain/machine-day.ts";
+
+export interface DayRequestRow {
+  readonly id: string;
+  readonly at: string;
+  readonly role: Role;
+  readonly outcome: Outcome;
+  /** Everything the request gave the model to read, in tokens, or null if its usage was not reported. */
+  readonly promptSize: number | null;
+  readonly outputTokens: number | null;
+  readonly cost: number | null;
+}
+
+export interface DaySession {
+  readonly id: string;
+  /** The title the client reported, or null. */
+  readonly title: string | null;
+  /** The first prompt, up to 200 characters, or null. */
+  readonly firstPrompt: string | null;
+  readonly client: string;
+  readonly pool: string;
+  readonly project: string;
+  readonly startedAt: string;
+  readonly endedAt: string;
+  readonly requests: ReadonlyArray<DayRequestRow>;
+}
+
+/** What `GET /api/machines/:machine/days/:day` answers. */
+export interface MachineDay {
+  /** The machine tag, such as "ada-mbp.local". */
+  readonly machine: string;
+  /** The day, as an ISO date in the hub's time zone. */
+  readonly day: string;
+  /** Every pool of the configuration, in its order. */
+  readonly pools: ReadonlyArray<string>;
+  readonly sessions: ReadonlyArray<DaySession>;
+}
diff --git a/apps/web/src/screens/machine/figures.tsx b/apps/web/src/screens/machine/figures.tsx
