@@ -0,0 +1,96 @@
+export const roles = ["main", "subagent", "title", "utility"] as const;
+
+export type Role = (typeof roles)[number];
+
+export const outcomes = ["ok", "error", "refused", "cancelled"] as const;
+
+export type Outcome = (typeof outcomes)[number];
+
+/** A request as a machine's day reads it. */
+export interface DayRequest {
+  readonly at: string;
+  readonly role: Role;
+  readonly outcome: Outcome;
+  readonly promptSize: number | null;
+  readonly outputTokens: number | null;
+  readonly cost: number | null;
+}
+
+const dayInMs = 86_400_000;
+
+/** The ISO date a day before (-1) or after (1) an ISO date. */
+export const adjacentDay = (day: string, step: -1 | 1): string =>
+  new Date(Date.parse(`${day}T00:00:00Z`) + step * dayInMs)
+    .toISOString()
+    .slice(0, 10);
+
+/** What a set of requests came to. */
+export interface Figures {
+  readonly requests: number;
+  readonly roles: Readonly<Record<Role, number>>;
+  readonly outcomes: Readonly<Record<Outcome, number>>;
+  /** The largest prompt of the main requests that reported one, or null: a level, never a sum. */
+  readonly peakContext: number | null;
+  readonly output: number;
+  /** The cost of the requests that have one, a lower bound while `unpriced` is above nothing. */
+  readonly cost: number;
+  /** The requests that reported tokens and have no cost. */
+  readonly unpriced: number;
+}
+
+/** How a session's context grew: the prompt of its first main request that reported one and the largest of all, both levels, never sums. */
+export interface Growth {
+  readonly first: number;
+  readonly peak: number;
+}
+
+export const growthOf = (
+  requests: ReadonlyArray<DayRequest>,
+): Growth | null => {
+  const sizes = requests
+    .filter((request) => request.role === "main")
+    .toSorted((a, b) => Date.parse(a.at) - Date.parse(b.at))
+    .flatMap((request) =>
+      request.promptSize === null ? [] : [request.promptSize],
+    );
+  const [first] = sizes;
+  return first === undefined ? null : { first, peak: Math.max(...sizes) };
+};
+
+export const figuresOf = (requests: ReadonlyArray<DayRequest>): Figures => {
+  const prompts = requests.flatMap((request) =>
+    request.role === "main" && request.promptSize !== null
+      ? [request.promptSize]
+      : [],
+  );
+  const inRole = (role: Role) =>
+    requests.filter((request) => request.role === role).length;
+  const withOutcome = (outcome: Outcome) =>
+    requests.filter((request) => request.outcome === outcome).length;
+  return {
+    requests: requests.length,
+    roles: {
+      main: inRole("main"),
+      subagent: inRole("subagent"),
+      title: inRole("title"),
+      utility: inRole("utility"),
+    },
+    outcomes: {
+      ok: withOutcome("ok"),
+      error: withOutcome("error"),
+      refused: withOutcome("refused"),
+      cancelled: withOutcome("cancelled"),
+    },
+    peakContext: prompts.length === 0 ? null : Math.max(...prompts),
+    output: requests.reduce(
+      (sum, request) => sum + (request.outputTokens ?? 0),
+      0,
+    ),
+    cost: requests.reduce((sum, request) => sum + (request.cost ?? 0), 0),
+    unpriced: requests.filter(
+      (request) =>
+        request.cost === null &&
+        (request.promptSize !== null || request.outputTokens !== null),
+    ).length,
+  };
+};
