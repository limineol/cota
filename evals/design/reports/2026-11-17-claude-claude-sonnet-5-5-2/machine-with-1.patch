+++ b/apps/web/src/shared/domain/machine-day.laws.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "@effect/vitest";
+import { Arbitrary, Schema } from "effect";
+import {
+  adjacentDay,
+  type DayRequest,
+  figuresOf,
+  growthOf,
+  outcomes,
+  roles,
+} from "./machine-day.ts";
+
+const int = (minimum: number, maximum: number) =>
+  Arbitrary.schema(Schema.Int.check(Schema.isBetween({ minimum, maximum })));
+
+const request = Arbitrary.all({
+  role: int(0, roles.length - 1),
+  outcome: int(0, outcomes.length - 1),
+  reported: int(0, 3),
+  prompt: int(0, 400_000),
+  output: int(0, 9_000),
+  priced: int(0, 3),
+  cents: int(0, 5_000),
+  minute: int(0, 1_439),
+}).pipe(
+  Arbitrary.map(
+    ({
+      role,
+      outcome,
+      reported,
+      prompt,
+      output,
+      priced,
+      cents,
+      minute,
+    }): DayRequest => ({
+      at: new Date(Date.UTC(2026, 10, 16, 0, minute)).toISOString(),
+      role: roles[role] ?? "main",
+      outcome: outcomes[outcome] ?? "ok",
+      promptSize: reported === 0 ? null : prompt,
+      outputTokens: reported === 1 ? null : output,
+      cost: priced === 0 ? null : cents / 100,
+    }),
+  ),
+);
+
+const requests = Arbitrary.array(request, { maxLength: 40 });
+
+const date = Arbitrary.all({
+  year: int(1970, 2100),
+  month: int(0, 11),
+  day: int(1, 31),
+}).pipe(
+  Arbitrary.map(({ year, month, day }) =>
+    new Date(Date.UTC(year, month, Math.min(day, 28)))
+      .toISOString()
+      .slice(0, 10),
+  ),
+);
+
+describe("a machine's day", () => {
+  it.prop(
+    "V43: the day before or after a day is the calendar day beside it, and the one after the one before is the day itself",
+    { day: date },
+    ({ day }) => {
+      const before = adjacentDay(day, -1);
+      const after = adjacentDay(day, 1);
+      expect(
+        Date.parse(`${day}T00:00:00Z`) - Date.parse(`${before}T00:00:00Z`),
+      ).toBe(86_400_000);
+      expect(
+        Date.parse(`${after}T00:00:00Z`) - Date.parse(`${day}T00:00:00Z`),
+      ).toBe(86_400_000);
+      expect(adjacentDay(before, 1)).toBe(day);
+      expect(adjacentDay(after, -1)).toBe(day);
+      expect(before).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+    },
+  );
+
+  it.prop(
+    "V44: a day's figures count every request once by role and by outcome, add the output and cost of the requests that have them, and take a context as the largest main prompt, never a sum",
+    { requests },
+    ({ requests }) => {
+      const figures = figuresOf(requests);
+      const total = (counts: Readonly<Record<string, number>>) =>
+        Object.values(counts).reduce((sum, count) => sum + count, 0);
+      expect(figures.requests).toBe(requests.length);
+      expect(total(figures.roles)).toBe(requests.length);
+      expect(total(figures.outcomes)).toBe(requests.length);
+      expect(figures.output).toBe(
+        requests.reduce((sum, each) => sum + (each.outputTokens ?? 0), 0),
+      );
+      expect(figures.cost).toBeCloseTo(
+        requests.reduce((sum, each) => sum + (each.cost ?? 0), 0),
+        6,
+      );
+      const main = requests.flatMap((each) =>
+        each.role === "main" && each.promptSize !== null
+          ? [each.promptSize]
+          : [],
+      );
+      expect(figures.peakContext).toBe(
+        main.length === 0 ? null : Math.max(...main),
+      );
+      expect(figures.unpriced).toBe(
+        requests.filter(
+          (each) =>
+            each.cost === null &&
+            (each.promptSize !== null || each.outputTokens !== null),
+        ).length,
+      );
+    },
+  );
+
+  it.prop(
+    "V45: a session's context grows from the prompt of its first main request that reported one to the largest of them, whatever order the requests are given in",
+    { requests },
+    ({ requests }) => {
+      const sized = requests
+        .filter((each) => each.role === "main" && each.promptSize !== null)
+        .toSorted((a, b) => Date.parse(a.at) - Date.parse(b.at));
+      const growth = growthOf(requests);
+      expect(growth?.first ?? null).toBe(sized[0]?.promptSize ?? null);
+      expect(growth?.peak ?? null).toBe(
+        sized.length === 0
+          ? null
+          : Math.max(...sized.map((each) => each.promptSize ?? 0)),
+      );
+      expect(growthOf(requests.toReversed())?.peak).toBe(growth?.peak);
+    },
+  );
+});
