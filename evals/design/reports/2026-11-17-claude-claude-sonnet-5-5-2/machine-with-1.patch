+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import {
+  busyDay,
+  firstSession,
+  oneSessionDay,
+  quietDay,
+  untitledSession,
+} from "#stories/machine.ts";
+import { withRouter } from "#stories/page.tsx";
+import { Machine } from "./machine.tsx";
+
+const meta = {
+  title: "Screens/Machine",
+  component: Machine,
+  decorators: [withRouter([displayNames])],
+  args: {
+    answer: busyDay,
+    dayLink: (day: string) => <a href={`/machines/tower/days/${day}`}>{day}</a>,
+  },
+} satisfies Meta<typeof Machine>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const ABusyDay: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: "Desk" }),
+    ).toBeVisible();
+    await expect(canvas.getByText("Monday, November 16, 2026")).toBeVisible();
+    const table = canvas.getByRole("table", {
+      name: "Sessions, in the order they began",
+    });
+    await expect(within(table).getAllByRole("link")).toHaveLength(8);
+    await expect(
+      within(table).getByRole("link", {
+        name: "Fix the checkout total after a coupon is removed",
+      }),
+    ).toHaveAttribute("href", `/sessions/${firstSession}`);
+  },
+};
+
+export const ASessionWithoutATitle: Story = {
+  play: async ({ canvas }) => {
+    const link = canvas.getByRole("link", { name: /^why does bun test/ });
+    await expect(link).toHaveAttribute("href", `/sessions/${untitledSession}`);
+  },
+};
+
+export const ThePoolsOfTheDay: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByRole("img", { name: /^Requests by pool: / }),
+    ).toBeVisible();
+    await expect(canvas.queryByText("spare")).toBeNull();
+  },
+};
+
+export const MovingToAnotherDay: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByRole("link", { name: "← Day before" }),
+    ).toHaveAttribute("href", "/machines/tower/days/2026-11-15");
+    await expect(
+      canvas.getByRole("link", { name: "Day after →" }),
+    ).toHaveAttribute("href", "/machines/tower/days/2026-11-17");
+  },
+};
+
+export const ADayWithOneSession: Story = {
+  args: { answer: oneSessionDay },
+};
+
+export const ADayWithNothing: Story = {
+  args: { answer: quietDay },
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText("This machine sent no request this day."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("link", { name: "← Day before" }),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  globals: { viewport: { value: "mobile2" } },
+};
