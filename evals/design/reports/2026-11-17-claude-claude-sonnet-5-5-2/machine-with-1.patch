@@ -0,0 +1,228 @@
+import { RequestEnded } from "@cota/ui/components/request-table";
+import { SessionTitle } from "@cota/ui/components/session-table";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableFlag,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableMagnitude,
+  TableRow,
+  TableSecondary,
+} from "@cota/ui/components/table";
+import { Link } from "@tanstack/react-router";
+import type { ReactNode } from "react";
+import {
+  type Figures,
+  figuresOf,
+  growthOf,
+} from "#shared/domain/machine-day.ts";
+import { span, tokens } from "#shared/domain/quantities.ts";
+import { Name } from "#shared/names.tsx";
+import { costText, counted, plural, timeOf } from "#shared/words.ts";
+import type { DaySession } from "./day.ts";
+import { rolesText } from "./figures.tsx";
+
+const withoutSession = "request:";
+
+function Heading({ session }: { readonly session: DaySession }) {
+  if (session.title !== null) {
+    return <SessionTitle title={session.title}>{session.title}</SessionTitle>;
+  }
+  if (session.firstPrompt !== null) {
+    return (
+      <SessionTitle kind="prompt" title={session.firstPrompt}>
+        {session.firstPrompt}
+      </SessionTitle>
+    );
+  }
+  return (
+    <SessionTitle kind="none">
+      {session.id.startsWith(withoutSession)
+        ? "A request without a session"
+        : "Untitled session"}
+    </SessionTitle>
+  );
+}
+
+/** How a session's requests that were not answered ended, in words, or nothing. */
+const endedText = (figures: Figures) =>
+  [
+    figures.outcomes.error > 0 ? plural(figures.outcomes.error, "error") : null,
+    figures.outcomes.refused > 0
+      ? `${counted(figures.outcomes.refused)} refused`
+      : null,
+    figures.outcomes.cancelled > 0
+      ? `${counted(figures.outcomes.cancelled)} cancelled`
+      : null,
+  ]
+    .filter((part) => part !== null)
+    .join(" · ");
+
+const contextText = (session: DaySession) => {
+  const growth = growthOf(session.requests);
+  if (growth === null) return "unreported";
+  return growth.first === growth.peak
+    ? tokens(growth.peak)
+    : `${tokens(growth.first)} → ${tokens(growth.peak)}`;
+};
+
+const peakOf = (session: DaySession) => growthOf(session.requests)?.peak ?? 0;
+
+/** The sessions in the order they began. */
+export const inOrder = (sessions: ReadonlyArray<DaySession>) =>
+  sessions.toSorted(
+    (a, b) => Date.parse(a.startedAt) - Date.parse(b.startedAt),
+  );
+
+export function SessionsHead() {
+  return (
+    <TableHeader from="md">
+      <TableRow>
+        <TableHead scope="col">Session</TableHead>
+        <TableHead scope="col" from="lg">
+          Pool
+        </TableHead>
+        <TableHead scope="col" from="xl">
+          Client
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Started
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Lasted
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Requests
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Context
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Cost
+        </TableHead>
+        <TableHead scope="col" numeric from="md">
+          Ended
+        </TableHead>
+      </TableRow>
+    </TableHeader>
+  );
+}
+
+export function SessionItem({
+  session,
+  largestContext,
+  markOf,
+}: {
+  readonly session: DaySession;
+  readonly largestContext: number;
+  readonly markOf: (pool: string) => ReactNode;
+}) {
+  const figures = figuresOf(session.requests);
+  const started = Date.parse(session.startedAt);
+  const ended = Date.parse(session.endedAt);
+  const cost = costText(figures.cost, figures.unpriced);
+  const unanswered = endedText(figures);
+  const errors = figures.outcomes.error;
+  return (
+    <TableBody linked>
+      <TableRow>
+        <TableCell className="w-full max-w-0">
+          <span className="flex min-w-0 items-center gap-1.75">
+            <TableLabel
+              render={
+                <Link
+                  to="/sessions/$session"
+                  params={{ session: session.id }}
+                />
+              }
+            >
+              <Heading session={session} />
+            </TableLabel>
+            {errors > 0 ? (
+              <TableFlag>{plural(errors, "error")}</TableFlag>
+            ) : null}
+          </span>
+          {session.title !== null && session.firstPrompt !== null ? (
+            <TableSecondary className="hidden @2xl/panel:block">
+              {session.firstPrompt}
+            </TableSecondary>
+          ) : null}
+          <TableSecondary className="@2xl/panel:hidden">
+            {timeOf(started)} · {span(ended - started)} ·{" "}
+            {plural(figures.requests, "request")} · {contextText(session)}{" "}
+            context · {cost}
+            {unanswered === "" ? "" : ` · ${unanswered}`}
+          </TableSecondary>
+        </TableCell>
+        <TableCell from="lg" className="max-w-44">
+          <span className="flex min-w-0 items-center gap-1.5">
+            {markOf(session.pool)}
+            <TableLabel>
+              <Name kind="pool" value={session.pool} />
+            </TableLabel>
+          </span>
+          <TableSecondary>
+            <Name kind="project" value={session.project} />
+          </TableSecondary>
+        </TableCell>
+        <TableCell from="xl" className="max-w-44">
+          <TableLabel className="block">
+            <Name kind="client" value={session.client} />
+          </TableLabel>
+        </TableCell>
+        <TableCell numeric from="md">
+          {timeOf(started)}
+        </TableCell>
+        <TableCell numeric from="md">
+          {span(ended - started)}
+        </TableCell>
+        <TableCell numeric from="md">
+          {counted(figures.requests)}
+          <TableSecondary>{rolesText(figures)}</TableSecondary>
+        </TableCell>
+        <TableCell numeric from="md">
+          {contextText(session)}
+          <TableMagnitude fraction={peakOf(session) / largestContext} />
+        </TableCell>
+        <TableCell numeric from="md">
+          {cost}
+        </TableCell>
+        <TableCell numeric from="md">
+          {unanswered === "" ? (
+            <RequestEnded tone="unseen">all answered</RequestEnded>
+          ) : (
+            <RequestEnded tone={errors > 0 ? "danger" : "quiet"}>
+              {unanswered}
+            </RequestEnded>
+          )}
+        </TableCell>
+      </TableRow>
+    </TableBody>
+  );
+}
+
+export function SessionsTable({
+  sessions,
+  markOf,
+}: {
+  readonly sessions: ReadonlyArray<DaySession>;
+  readonly markOf: (pool: string) => ReactNode;
+}) {
+  const largestContext = Math.max(1, ...sessions.map(peakOf));
+  return (
+    <Table aria-label="Sessions, in the order they began">
+      <SessionsHead />
+      {inOrder(sessions).map((session) => (
+        <SessionItem
+          key={session.id}
+          session={session}
+          largestContext={largestContext}
+          markOf={markOf}
+        />
+      ))}
+    </Table>
+  );
+}
diff --git a/apps/web/src/shared/domain/machine-day.laws.test.ts b/apps/web/src/shared/domain/machine-day.laws.test.ts
