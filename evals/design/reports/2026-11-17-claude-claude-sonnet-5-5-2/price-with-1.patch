+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, fn } from "storybook/test";
+import {
+  invalidPrice,
+  keptAs,
+  listedAndOwn,
+  listedOnly,
+  noSuchPool,
+  ownPrices,
+  storeUnavailable,
+  unknownToTheList,
+  unknownWithOwn,
+  unreachable,
+} from "#stories/price.ts";
+import { type Outcome, Price } from "./price.tsx";
+
+const never = () => new Promise<Outcome>(() => {});
+
+const meta = {
+  title: "Screens/Price",
+  component: Price,
+  args: {
+    answer: { _tag: "Read", price: listedOnly },
+    save: fn(async () => keptAs(listedAndOwn)),
+    drop: fn(async () => keptAs(listedOnly)),
+    onRetry: fn(),
+  },
+} satisfies Meta<typeof Price>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const WhileItReads: Story = {
+  args: { answer: { _tag: "Reading" } },
+  play: async ({ canvas }) => {
+    await expect(await canvas.findByLabelText("Price loading")).toBeVisible();
+  },
+};
+
+export const ListedPriceInForce: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The price list's price is in force."),
+    ).toBeVisible();
+    await expect(canvas.getByText("$3.75")).toBeVisible();
+    await expect(
+      canvas.getByRole("textbox", {
+        name: "Cache write price, dollars per million tokens",
+      }),
+    ).toHaveValue("3.75");
+    await expect(
+      canvas.queryByRole("button", { name: "Drop the pool's price" }),
+    ).not.toBeInTheDocument();
+  },
+};
+
+export const OwnPriceInForce: Story = {
+  args: { answer: { _tag: "Read", price: listedAndOwn } },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("textbox", {
+        name: "Input price, dollars per million tokens",
+      }),
+    ).toHaveValue("2.5");
+    await expect(canvas.getByText("$3.00")).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    ).toBeEnabled();
+    await expect(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    ).toBeDisabled();
+  },
+};
+
+export const ModelTheListDoesNotKnow: Story = {
+  args: { answer: { _tag: "Read", price: unknownToTheList } },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(
+        "No price is in force, so 42 requests of the last 7 days to this model through this pool have no cost.",
+      ),
+    ).toBeVisible();
+    await expect(
+      canvas.getByText("The price list does not know this model."),
+    ).toBeVisible();
+    await expect(canvas.getAllByText("—")).toHaveLength(4);
+  },
+};
+
+export const ModelTheListDoesNotKnowWithOwnPrice: Story = {
+  args: { answer: { _tag: "Read", price: unknownWithOwn } },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("textbox", {
+        name: "Cache write price, dollars per million tokens",
+      }),
+    ).toHaveValue("0");
+  },
+};
+
+export const Saving: Story = {
+  args: { save: fn(never) },
+  play: async ({ canvas, userEvent }) => {
+    const input = await canvas.findByRole("textbox", {
+      name: "Input price, dollars per million tokens",
+    });
+    await userEvent.clear(input);
+    await userEvent.type(input, "2.5");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByText("Saving…")).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    ).toBeDisabled();
+  },
+};
+
+export const Saved: Story = {
+  args: { save: fn(async () => keptAs(listedAndOwn)) },
+  play: async ({ canvas, userEvent, args }) => {
+    const input = await canvas.findByRole("textbox", {
+      name: "Input price, dollars per million tokens",
+    });
+    await userEvent.clear(input);
+    await userEvent.type(input, "2.5");
+    for (const [name, value] of [
+      ["Output", "12"],
+      ["Cache read", "0.25"],
+      ["Cache write", "3"],
+    ] as const) {
+      const field = canvas.getByRole("textbox", {
+        name: `${name} price, dollars per million tokens`,
+      });
+      await userEvent.clear(field);
+      await userEvent.type(field, value);
+    }
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(
+      await canvas.findByText("Saved. The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(args.save).toHaveBeenCalledWith(ownPrices);
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    ).toBeVisible();
+  },
+};
+
+export const Dropped: Story = {
+  args: { answer: { _tag: "Read", price: listedAndOwn } },
+  play: async ({ canvas, userEvent, args }) => {
+    await userEvent.click(
+      await canvas.findByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(
+      await canvas.findByText("Dropped. The price list's price is in force."),
+    ).toBeVisible();
+    await expect(args.drop).toHaveBeenCalled();
+    await expect(
+      canvas.queryByRole("button", { name: "Drop the pool's price" }),
+    ).not.toBeInTheDocument();
+  },
+};
+
+export const NotANumberIsNotSent: Story = {
+  play: async ({ canvas, userEvent, args }) => {
+    const field = await canvas.findByRole("textbox", {
+      name: "Cache read price, dollars per million tokens",
+    });
+    await userEvent.clear(field);
+    await userEvent.type(field, "-1");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: Cache read must be a number of dollars, zero or more, so nothing was sent.",
+    );
+    await expect(field).toHaveAttribute("aria-invalid", "true");
+    await expect(args.save).not.toHaveBeenCalled();
+  },
+};
+
+export const RefusedAsInvalid: Story = {
+  args: { save: fn(async () => invalidPrice) },
+  play: async ({ canvas, userEvent }) => {
+    const field = await canvas.findByRole("textbox", {
+      name: "Input price, dollars per million tokens",
+    });
+    await userEvent.clear(field);
+    await userEvent.type(field, "1");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: cacheRead is -1.",
+    );
+    await expect(field).toHaveValue("1");
+  },
+};
+
+export const RefusedForWantOfThePool: Story = {
+  args: { save: fn(async () => noSuchPool) },
+  play: async ({ canvas, userEvent }) => {
+    const field = await canvas.findByRole("textbox", {
+      name: "Input price, dollars per million tokens",
+    });
+    await userEvent.clear(field);
+    await userEvent.type(field, "1");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The hub has no pool named personal.",
+    );
+  },
+};
+
+export const RefusedWhenTheStoreIsDown: Story = {
+  args: {
+    answer: { _tag: "Read", price: listedAndOwn },
+    drop: fn(async () => storeUnavailable),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      await canvas.findByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not dropped: The hub store did not answer: the disk is full.",
+    );
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+  },
+};
+
+export const HubCannotBeReachedWhileSaving: Story = {
+  args: { save: fn(async () => unreachable) },
+  play: async ({ canvas, userEvent }) => {
+    const field = await canvas.findByRole("textbox", {
+      name: "Input price, dollars per million tokens",
+    });
+    await userEvent.clear(field);
+    await userEvent.type(field, "1");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The hub did not answer.",
+    );
+  },
+};
+
+export const HubCannotBeReachedWhileReading: Story = {
+  args: { answer: { _tag: "Unreachable" } },
+  play: async ({ canvas, userEvent, args }) => {
+    await expect(
+      await canvas.findByText("The hub could not read the price."),
+    ).toBeVisible();
+    await userEvent.click(canvas.getByRole("button", { name: "Try again" }));
+    await expect(args.onRetry).toHaveBeenCalled();
+  },
+};
