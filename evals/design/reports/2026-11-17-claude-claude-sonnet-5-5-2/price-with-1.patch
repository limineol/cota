@@ -0,0 +1,286 @@
+import { Badge } from "@cota/ui/components/badge";
+import { Button } from "@cota/ui/components/button";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@cota/ui/components/card";
+import { FieldNote } from "@cota/ui/components/field-note";
+import { Input } from "@cota/ui/components/input";
+import { Note } from "@cota/ui/components/note";
+import { Skeleton } from "@cota/ui/components/skeleton";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@cota/ui/components/table";
+import { type FormEvent, useState } from "react";
+import { Problem } from "#shared/problem.tsx";
+import { plural } from "#shared/words.ts";
+import {
+  type Drafts,
+  draftsOf,
+  fields,
+  inForce,
+  isKept,
+  type ModelPrice,
+  type Prices,
+  parseDrafts,
+  priceText,
+} from "./prices.ts";
+
+/** What the hub did with a save or a drop. */
+export type Outcome =
+  | { readonly _tag: "Kept"; readonly price: ModelPrice }
+  | {
+      readonly _tag: "Refused";
+      readonly title: string;
+      readonly detail: string;
+    }
+  | { readonly _tag: "Unreachable" };
+
+/** What the hub answered to reading the price, as the screen is given it. */
+export type Answer =
+  | { readonly _tag: "Reading" }
+  | { readonly _tag: "Read"; readonly price: ModelPrice }
+  | { readonly _tag: "Unreachable" };
+
+type Said = { readonly tone: "quiet" | "danger"; readonly text: string } | null;
+
+const unreachable =
+  "The hub did not answer. Check that it is running and reachable from this browser.";
+
+function Reading() {
+  return (
+    <Card role="status" aria-label="Price loading" aria-busy="true">
+      <Skeleton className="h-6 w-48" />
+      <Skeleton className="h-4 w-80" />
+      <Skeleton className="h-40 w-full" />
+    </Card>
+  );
+}
+
+function inForceText(price: ModelPrice) {
+  const force = inForce(price);
+  if (force === null) {
+    return price.unpricedRequests === 0
+      ? "No price is in force: neither the list nor the pool has one for this model."
+      : `No price is in force, so ${plural(price.unpricedRequests, "request")} of the last 7 days to this model through this pool have no cost.`;
+  }
+  return force.from === "own"
+    ? "The pool's own price is in force."
+    : "The price list's price is in force.";
+}
+
+const listedText = (listed: Prices | null, field: keyof Prices) =>
+  listed === null ? "—" : priceText(listed[field]);
+
+function PriceForm({
+  price,
+  save,
+  drop,
+}: {
+  readonly price: ModelPrice;
+  readonly save: (prices: Prices) => Promise<Outcome>;
+  readonly drop: () => Promise<Outcome>;
+}) {
+  const [kept, setKept] = useState(price);
+  const [drafts, setDrafts] = useState<Drafts>(() => draftsOf(price));
+  const [note, setNote] = useState<Said>(null);
+  const [refusedField, setRefusedField] = useState<string | null>(null);
+  const [working, setWorking] = useState<"saving" | "dropping" | null>(null);
+
+  const force = inForce(kept);
+  const unchanged = isKept(drafts, kept.own);
+
+  const settle = async (
+    doing: "saving" | "dropping",
+    run: () => Promise<Outcome>,
+    done: string,
+    failed: string,
+  ) => {
+    setWorking(doing);
+    setNote(null);
+    setRefusedField(null);
+    const outcome = await run().catch((): Outcome => ({ _tag: "Unreachable" }));
+    setWorking(null);
+    switch (outcome._tag) {
+      case "Kept":
+        setKept(outcome.price);
+        setDrafts(draftsOf(outcome.price));
+        setNote({ tone: "quiet", text: done });
+        return;
+      case "Refused":
+        setNote({ tone: "danger", text: `${failed} ${outcome.detail}` });
+        return;
+      case "Unreachable":
+        setNote({ tone: "danger", text: `${failed} ${unreachable}` });
+    }
+  };
+
+  const submit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (working !== null) return;
+    const parsed = parseDrafts(drafts);
+    if (parsed._tag === "Refused") {
+      setRefusedField(parsed.field);
+      setNote({
+        tone: "danger",
+        text: `Not saved: ${parsed.label} must be a number of dollars, zero or more, so nothing was sent.`,
+      });
+      return;
+    }
+    void settle(
+      "saving",
+      () => save(parsed.prices),
+      "Saved. The pool's own price is in force.",
+      "Not saved:",
+    );
+  };
+
+  const dropOwn = () =>
+    void settle(
+      "dropping",
+      drop,
+      kept.listed === null
+        ? "Dropped. No price is in force now."
+        : "Dropped. The price list's price is in force.",
+      "Not dropped:",
+    );
+
+  const said: Said =
+    working === null
+      ? note
+      : {
+          tone: "quiet",
+          text: working === "saving" ? "Saving…" : "Dropping…",
+        };
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle>
+          <code>{kept.model}</code>
+        </CardTitle>
+        <CardDescription>
+          Through the pool <code>{kept.pool}</code>, in dollars per million
+          tokens.
+        </CardDescription>
+      </CardHeader>
+      <CardContent>
+        <p className="m-0 flex flex-wrap items-center gap-2 text-text-2">
+          {force === null ? (
+            <Badge variant="outline">None</Badge>
+          ) : (
+            <Badge variant="outline">
+              {force.from === "own" ? "Pool's own" : "Price list"}
+            </Badge>
+          )}
+          <span>{inForceText(kept)}</span>
+        </p>
+        <form
+          className="flex flex-col gap-4"
+          aria-label={`Price of ${kept.model} for ${kept.pool}`}
+          onSubmit={submit}
+          noValidate
+        >
+          <Table aria-label="Prices">
+            <TableHeader>
+              <TableRow>
+                <TableHead scope="col">Usage</TableHead>
+                <TableHead scope="col" numeric>
+                  Price list
+                </TableHead>
+                <TableHead scope="col" className="w-40">
+                  Pool's own
+                </TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {fields.map(({ field, label }) => (
+                <TableRow key={field}>
+                  <TableCell>{label}</TableCell>
+                  <TableCell numeric>
+                    {listedText(kept.listed, field)}
+                  </TableCell>
+                  <TableCell>
+                    <Input
+                      aria-label={`${label} price, dollars per million tokens`}
+                      inputMode="decimal"
+                      autoComplete="off"
+                      spellCheck={false}
+                      value={drafts[field]}
+                      placeholder={
+                        kept.listed === null ? "0" : String(kept.listed[field])
+                      }
+                      aria-invalid={refusedField === field || undefined}
+                      onChange={(event) => {
+                        setDrafts({ ...drafts, [field]: event.target.value });
+                        setNote(null);
+                        setRefusedField(null);
+                      }}
+                    />
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+          {kept.listed === null ? (
+            <Note>The price list does not know this model.</Note>
+          ) : null}
+          <div className="flex flex-wrap items-center gap-2">
+            <Button type="submit" disabled={working !== null || unchanged}>
+              Save the pool's price
+            </Button>
+            {kept.own === null ? null : (
+              <Button
+                type="button"
+                variant="outline"
+                disabled={working !== null}
+                onClick={dropOwn}
+              >
+                Drop the pool's price
+              </Button>
+            )}
+          </div>
+          {said === null ? null : (
+            <FieldNote tone={said.tone}>{said.text}</FieldNote>
+          )}
+        </form>
+      </CardContent>
+    </Card>
+  );
+}
+
+/** A model's price for a pool: the four prices beside the list's, which is in force, and a way to save the pool's own or drop it. */
+export function Price({
+  answer,
+  save,
+  drop,
+  onRetry,
+}: {
+  readonly answer: Answer;
+  readonly save: (prices: Prices) => Promise<Outcome>;
+  readonly drop: () => Promise<Outcome>;
+  readonly onRetry: () => void;
+}) {
+  switch (answer._tag) {
+    case "Reading":
+      return <Reading />;
+    case "Unreachable":
+      return (
+        <Problem
+          title="The hub could not read the price."
+          error={null}
+          onRetry={onRetry}
+        />
+      );
+    case "Read":
+      return <PriceForm price={answer.price} save={save} drop={drop} />;
+  }
+}
