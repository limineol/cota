+import type { Outcome } from "#screens/price/price.tsx";
+import type { ModelPrice, Prices } from "#screens/price/prices.ts";
+
+export const listedPrices: Prices = {
+  input: 3,
+  output: 15,
+  cacheRead: 0.3,
+  cacheWrite: 3.75,
+};
+
+export const ownPrices: Prices = {
+  input: 2.5,
+  output: 12,
+  cacheRead: 0.25,
+  cacheWrite: 3,
+};
