@@ -0,0 +1,98 @@
+/** Dollars per million tokens, by usage class. */
+export interface Prices {
+  readonly input: number;
+  readonly output: number;
+  readonly cacheRead: number;
+  readonly cacheWrite: number;
+}
+
+export interface ModelPrice {
+  readonly pool: string;
+  readonly model: string;
+  /** The shipped price list's price, or null when the list does not know the model. */
+  readonly listed: Prices | null;
+  /** The pool's own price, or null when it has none. */
+  readonly own: Prices | null;
+  /** Requests of the last 7 days to this model through this pool that have no cost because neither price exists. */
+  readonly unpricedRequests: number;
+}
+
+export type Field = keyof Prices;
+
+export const fields: ReadonlyArray<{
+  readonly field: Field;
+  readonly label: string;
+}> = [
+  { field: "input", label: "Input" },
+  { field: "output", label: "Output" },
+  { field: "cacheRead", label: "Cache read" },
+  { field: "cacheWrite", label: "Cache write" },
+];
+
+export type Drafts = Record<Field, string>;
+
+const dollars = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 6,
+});
+
+/** A price in dollars per million tokens, as `$3.75`. */
+export const priceText = (price: number): string => `$${dollars.format(price)}`;
+
+/** The price in force: the pool's own, else the list's, else none. */
+export const inForce = (
+  price: ModelPrice,
+): { readonly from: "own" | "listed"; readonly prices: Prices } | null => {
+  if (price.own !== null) return { from: "own", prices: price.own };
+  if (price.listed !== null) return { from: "listed", prices: price.listed };
+  return null;
+};
+
+const written = (price: number): string => String(price);
+
+/** The fields as they start: the price in force, or empty where there is none. */
+export const draftsOf = (price: ModelPrice): Drafts => {
+  const force = inForce(price)?.prices;
+  return {
+    input: force === undefined ? "" : written(force.input),
+    output: force === undefined ? "" : written(force.output),
+    cacheRead: force === undefined ? "" : written(force.cacheRead),
+    cacheWrite: force === undefined ? "" : written(force.cacheWrite),
+  };
+};
+
+const number = /^\d+(\.\d+)?$/;
+
+export type Parsed =
+  | { readonly _tag: "Prices"; readonly prices: Prices }
+  | { readonly _tag: "Refused"; readonly field: Field; readonly label: string };
+
+/** The four fields as prices, or the first that is not a number of dollars, zero or more. */
+export const parseDrafts = (drafts: Drafts): Parsed => {
+  const values: Partial<Record<Field, number>> = {};
+  for (const { field, label } of fields) {
+    const text = drafts[field].trim();
+    const value = number.test(text) ? Number(text) : Number.NaN;
+    if (!Number.isFinite(value)) return { _tag: "Refused", field, label };
+    values[field] = value;
+  }
+  return {
+    _tag: "Prices",
+    prices: {
+      input: values.input ?? 0,
+      output: values.output ?? 0,
+      cacheRead: values.cacheRead ?? 0,
+      cacheWrite: values.cacheWrite ?? 0,
+    },
+  };
+};
+
+/** Whether the fields, read as prices, are the pool's own price as kept. */
+export const isKept = (drafts: Drafts, own: Prices | null): boolean => {
+  if (own === null) return false;
+  const parsed = parseDrafts(drafts);
+  return (
+    parsed._tag === "Prices" &&
+    fields.every(({ field }) => parsed.prices[field] === own[field])
+  );
+};
