@@ -0,0 +1,114 @@
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import {
+  createMemoryHistory,
+  createRootRoute,
+  createRoute,
+  createRouter,
+  RouterProvider,
+} from "@tanstack/react-router";
+import { useState } from "react";
+import { expect, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { busyDay, quietDay } from "#stories/machine.ts";
+import { withApi } from "#stories/page.tsx";
+import { Machine } from "./machine.tsx";
+import type { MachineDay } from "./machine-day.ts";
+
+function Drawn({ answer }: { readonly answer: MachineDay }) {
+  const [router] = useState(() => {
+    const root = createRootRoute();
+    const here = createRoute({
+      getParentRoute: () => root,
+      path: "/",
+      component: () => (
+        <Machine
+          answer={answer}
+          dayLink={(day) => <a href={`/machines/${answer.machine}/days/${day}`} />}
+        />
+      ),
+    });
+    const session = createRoute({
+      getParentRoute: () => root,
+      path: "/sessions/$session",
+      component: () => <p>The session's own page</p>,
+    });
+    return createRouter({
+      routeTree: root.addChildren([here, session]),
+      history: createMemoryHistory({ initialEntries: ["/"] }),
+    });
+  });
+  return <RouterProvider router={router} />;
+}
+
+const meta = {
+  title: "Screens/Machine",
+  decorators: [withApi([displayNames])],
+  render: (args) => <Drawn answer={args.answer} />,
+  args: { answer: busyDay },
+} satisfies Meta<{ answer: MachineDay }>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const ABusyDay: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: "ada-mbp.local" }),
+    ).toBeVisible();
+    const table = await canvas.findByRole("table", {
+      name: "Sessions, oldest first",
+    });
+    await expect(within(table).getAllByRole("link")).toHaveLength(8);
+    await expect(canvas.getByText(/8 sessions · \d+ requests/)).toBeVisible();
+  },
+};
+
+export const ASessionWithoutATitle: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(
+        "why does the scrubber keep the word 'organization' in a header value",
+      ),
+    ).toBeVisible();
+    await expect(canvas.getByText("Untitled session")).toBeVisible();
+  },
+};
+
+export const ASessionOpens: Story = {
+  play: async ({ canvas }) => {
+    const link = await canvas.findByRole("link", {
+      name: "Fix the checkout total after a coupon is removed",
+    });
+    await expect(link).toHaveAttribute(
+      "href",
+      "/sessions/0193b7d0-0001-7000-8000-5e5510000000",
+    );
+  },
+};
+
+export const MovingFromDayToDay: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("link", { name: "The day before, 2026-11-13" }),
+    ).toHaveAttribute("href", "/machines/ada-mbp.local/days/2026-11-13");
+    await expect(
+      canvas.getByRole("link", { name: "The day after, 2026-11-15" }),
+    ).toHaveAttribute("href", "/machines/ada-mbp.local/days/2026-11-15");
+  },
+};
+
+export const ADayWithNothing: Story = {
+  args: { answer: quietDay },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("This machine ran nothing on this day."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("link", { name: "The day before, 2026-11-14" }),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  globals: { viewport: { value: "mobile2" } },
+};
