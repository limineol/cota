+import type {
+  MachineDaySession,
+  Outcome,
+  Role,
+} from "./machine-day.ts";
+
+export const roles: ReadonlyArray<Role> = [
+  "main",
+  "subagent",
+  "title",
+  "utility",
+];
+
+export const roleWords: Record<Role, string> = {
+  main: "main",
+  subagent: "subagent",
+  title: "title",
+  utility: "utility",
+};
+
+export const outcomeWords: Record<Exclude<Outcome, "ok">, string> = {
+  error: "error",
+  refused: "refused",
+  cancelled: "cancelled",
+};
+
+const dayInMilliseconds = 86_400_000;
+
+/** The ISO date `step` days from `day`, counted on the calendar alone. */
+export const dayBeside = (day: string, step: number) =>
+  new Date(Date.parse(`${day}T00:00:00Z`) + step * dayInMilliseconds)
+    .toISOString()
+    .slice(0, 10);
+
+const dayWords = new Intl.DateTimeFormat("en-GB", {
+  weekday: "long",
+  day: "numeric",
+  month: "long",
+  year: "numeric",
+  timeZone: "UTC",
+});
+
+export const dayText = (day: string) =>
+  dayWords.format(Date.parse(`${day}T00:00:00Z`));
+
+export const inOrder = (sessions: ReadonlyArray<MachineDaySession>) =>
+  sessions.toSorted((a, b) => Date.parse(a.startedAt) - Date.parse(b.startedAt));
+
+/** What a session's requests came to: how they split by role and how they ended. */
+export const tallyOf = (session: MachineDaySession) => {
+  const requests = session.requests;
+  const ended = (outcome: Outcome) =>
+    requests.filter((each) => each.outcome === outcome).length;
+  const mains = requests
+    .filter((each) => each.role === "main")
+    .toSorted((a, b) => Date.parse(a.at) - Date.parse(b.at));
+  const sizes = mains.flatMap((each) =>
+    each.promptSize === null ? [] : [each.promptSize],
+  );
+  return {
+    requests: requests.length,
+    byRole: roles.flatMap((role) => {
+      const count = requests.filter((each) => each.role === role).length;
+      return count === 0 ? [] : [{ role, count }];
+    }),
+    errors: ended("error"),
+    refused: ended("refused"),
+    cancelled: ended("cancelled"),
+    firstPrompt: sizes[0] ?? null,
+    peakPrompt: sizes.length === 0 ? null : Math.max(...sizes),
+    dollars: requests.reduce((sum, each) => sum + (each.cost ?? 0), 0),
+    unpriced: requests.filter(
+      (each) => each.outcome === "ok" && each.cost === null,
+    ).length,
+  };
+};
+
+export type Tally = ReturnType<typeof tallyOf>;
