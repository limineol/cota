+export type Role = "main" | "subagent" | "title" | "utility";
+
+export type Outcome = "ok" | "error" | "refused" | "cancelled";
+
+export interface MachineDayRequest {
+  readonly id: string;
+  readonly at: string;
+  readonly role: Role;
+  readonly outcome: Outcome;
+  readonly promptSize: number | null;
+  readonly outputTokens: number | null;
+  readonly cost: number | null;
+}
+
+export interface MachineDaySession {
+  readonly id: string;
+  readonly title: string | null;
+  readonly firstPrompt: string | null;
+  readonly client: string;
+  readonly pool: string;
+  readonly project: string;
+  readonly startedAt: string;
+  readonly endedAt: string;
+  readonly requests: ReadonlyArray<MachineDayRequest>;
+}
+
+/** What `GET /api/machines/:machine/days/:day` answers: one machine's sessions on one day of the hub's time zone. */
+export interface MachineDay {
+  readonly machine: string;
+  readonly day: string;
+  readonly pools: ReadonlyArray<string>;
+  readonly sessions: ReadonlyArray<MachineDaySession>;
+}
