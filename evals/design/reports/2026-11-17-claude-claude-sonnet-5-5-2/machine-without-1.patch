+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFoot,
+} from "@cota/ui/components/list-panel";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+} from "@cota/ui/components/page";
+import {
+  Pager,
+  PagerControls,
+  PagerPage,
+  PagerStep,
+} from "@cota/ui/components/pager";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { RequestEnded } from "@cota/ui/components/request-table";
+import {
+  SessionTitle,
+} from "@cota/ui/components/session-table";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableFlag,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableMagnitude,
+  TableRow,
+  TableSecondary,
+} from "@cota/ui/components/table";
+import { Link } from "@tanstack/react-router";
+import type { ReactElement } from "react";
+import { poolHues } from "#shared/domain/hues.ts";
+import { span, tokens } from "#shared/domain/quantities.ts";
+import { Name } from "#shared/names.tsx";
+import { costText, counted, plural, timeOf } from "#shared/words.ts";
+import {
+  dayBeside,
+  dayText,
+  inOrder,
+  type Tally,
+  tallyOf,
+} from "./figures.ts";
+import type { MachineDay, MachineDaySession } from "./machine-day.ts";
+
+const withoutTitle = "Untitled session";
+
+function Heading({ session }: { readonly session: MachineDaySession }) {
+  if (session.title !== null) {
+    return (
+      <SessionTitle title={session.title}>{session.title}</SessionTitle>
+    );
+  }
+  const line = session.firstPrompt
+    ?.split("\n")
+    .find((each) => each.trim() !== "");
+  if (line !== undefined) {
+    return (
+      <SessionTitle kind="prompt" title={session.firstPrompt ?? line}>
+        {line.trim()}
+      </SessionTitle>
+    );
+  }
+  return <SessionTitle kind="none">{withoutTitle}</SessionTitle>;
+}
+
+function Ended({ tally }: { readonly tally: Tally }) {
+  const parts = [
+    tally.errors > 0 ? { text: plural(tally.errors, "error"), error: true } : null,
+    tally.refused > 0 ? { text: `${counted(tally.refused)} refused`, error: false } : null,
+    tally.cancelled > 0
+      ? { text: `${counted(tally.cancelled)} cancelled`, error: false }
+      : null,
+  ].filter((part) => part !== null);
+  if (parts.length === 0) return <RequestEnded tone="quiet">all answered</RequestEnded>;
+  return (
+    <span className="flex flex-col items-end">
+      {parts.map((part) => (
+        <RequestEnded key={part.text} {...(part.error ? { tone: "danger" } : {})}>
+          {part.text}
+        </RequestEnded>
+      ))}
+    </span>
+  );
+}
+
+const sizeText = (tally: Tally) => {
+  if (tally.peakPrompt === null) return "unreported";
+  const first = tally.firstPrompt;
+  return first === null || first === tally.peakPrompt
+    ? tokens(tally.peakPrompt)
+    : `${tokens(first)} → ${tokens(tally.peakPrompt)}`;
+};
+
+function SessionItem({
+  session,
+  tally,
+  peak,
+  markOf,
+}: {
+  readonly session: MachineDaySession;
+  readonly tally: Tally;
+  readonly peak: number;
+  readonly markOf: (pool: string) => ReactElement;
+}) {
+  const started = Date.parse(session.startedAt);
+  const ended = Date.parse(session.endedAt);
+  return (
+    <TableBody linked>
+      <TableRow>
+        <TableCell className="w-full max-w-0">
+          <span className="flex min-w-0 items-center gap-1.75">
+            <TableLabel
+              render={
+                <Link
+                  to="/sessions/$session"
+                  params={{ session: session.id }}
+                />
+              }
+            >
+              <Heading session={session} />
+            </TableLabel>
+            {tally.errors > 0 ? (
+              <TableFlag>{plural(tally.errors, "error")}</TableFlag>
+            ) : null}
+          </span>
+          <TableSecondary>
+            <Name kind="project" value={session.project} /> ·{" "}
+            <Name kind="client" value={session.client} />
+          </TableSecondary>
+        </TableCell>
+        <TableCell from="md" className="max-w-44">
+          <span className="flex min-w-0 items-center gap-1.5">
+            {markOf(session.pool)}
+            <TableLabel>
+              <Name kind="pool" value={session.pool} />
+            </TableLabel>
+          </span>
+        </TableCell>
+        <TableCell numeric>
+          <span title={`${timeOf(started)} – ${timeOf(ended)}`}>
+            {timeOf(started)}
+          </span>
+          <TableSecondary>{span(ended - started)}</TableSecondary>
+        </TableCell>
+        <TableCell numeric>
+          {counted(tally.requests)}
+          <TableSecondary className="hidden @2xl/panel:block">
+            {tally.byRole
+              .map(({ role, count }) => `${counted(count)} ${role}`)
+              .join(" · ")}
+          </TableSecondary>
+        </TableCell>
+        <TableCell numeric from="lg">
+          <Ended tally={tally} />
+        </TableCell>
+        <TableCell numeric from="md">
+          {sizeText(tally)}
+          <TableMagnitude fraction={(tally.peakPrompt ?? 0) / peak} />
+        </TableCell>
+        <TableCell numeric from="lg">
+          {costText(tally.dollars, tally.unpriced)}
+        </TableCell>
+      </TableRow>
+    </TableBody>
+  );
+}
+
+function SessionsTable({ answer }: { readonly answer: MachineDay }) {
+  const hues = poolHues(answer.pools);
+  const sessions = inOrder(answer.sessions).map((session) => ({
+    session,
+    tally: tallyOf(session),
+  }));
+  const peak = Math.max(1, ...sessions.map(({ tally }) => tally.peakPrompt ?? 0));
+  const markOf = (pool: string) => (
+    <PoolMark hue={hues.get(pool) ?? "neutral"} name={pool} />
+  );
+  return (
+    <Table aria-label="Sessions, oldest first">
+      <TableHeader>
+        <TableRow>
+          <TableHead scope="col">Session</TableHead>
+          <TableHead scope="col" from="md">
+            Pool
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Started
+          </TableHead>
+          <TableHead scope="col" numeric>
+            Requests
+          </TableHead>
+          <TableHead scope="col" numeric from="lg">
+            Ended
+          </TableHead>
+          <TableHead scope="col" numeric from="md">
+            Context
+          </TableHead>
+          <TableHead scope="col" numeric from="lg">
+            Cost
+          </TableHead>
+        </TableRow>
+      </TableHeader>
+      {sessions.map(({ session, tally }) => (
+        <SessionItem
+          key={session.id}
+          session={session}
+          tally={tally}
+          peak={peak}
+          markOf={markOf}
+        />
+      ))}
+    </Table>
+  );
+}
+
+export function Machine({
+  answer,
+  dayLink,
+}: {
+  readonly answer: MachineDay;
+  readonly dayLink: (day: string) => ReactElement;
+}) {
+  const tallies = answer.sessions.map(tallyOf);
+  const requests = tallies.reduce((sum, each) => sum + each.requests, 0);
+  const dollars = tallies.reduce((sum, each) => sum + each.dollars, 0);
+  const unpriced = tallies.reduce((sum, each) => sum + each.unpriced, 0);
+  const before = dayBeside(answer.day, -1);
+  const after = dayBeside(answer.day, 1);
+  return (
+    <Page className="@container">
+      <PageHeader>
+        <div>
+          <PageTitle>
+            <Name kind="machine" value={answer.machine} />
+          </PageTitle>
+          <PageDescription>
+            {dayText(answer.day)}
+            {answer.sessions.length === 0
+              ? null
+              : ` · ${plural(answer.sessions.length, "session")} · ${plural(requests, "request")} · ${costText(dollars, unpriced)}`}
+          </PageDescription>
+        </div>
+        <Pager aria-label="Days" className="w-auto">
+          <PagerControls>
+            <PagerStep render={dayLink(before)} aria-label={`The day before, ${before}`}>
+              ← {before}
+            </PagerStep>
+            <PagerPage>{answer.day}</PagerPage>
+            <PagerStep render={dayLink(after)} aria-label={`The day after, ${after}`}>
+              {after} →
+            </PagerStep>
+          </PagerControls>
+        </Pager>
+      </PageHeader>
+      <ListPanel aria-label="Sessions">
+        <ListPanelBody>
+          {answer.sessions.length === 0 ? (
+            <Empty>
+              <EmptyTitle>This machine ran nothing on this day.</EmptyTitle>
+              <EmptyDescription>
+                No request of {answer.machine} is in the request log for{" "}
+                {answer.day}.
+              </EmptyDescription>
+            </Empty>
+          ) : (
+            <SessionsTable answer={answer} />
+          )}
+        </ListPanelBody>
+        {answer.sessions.length === 0 ? null : (
+          <ListPanelFoot>
+            <span>{plural(answer.sessions.length, "session")}</span>
+          </ListPanelFoot>
+        )}
+      </ListPanel>
+    </Page>
+  );
+}
