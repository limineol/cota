@@ -0,0 +1,230 @@
+import type {
+  MachineDay,
+  MachineDayRequest,
+  Outcome,
+  Role,
+} from "#screens/machine/machine-day.ts";
+
+const minute = 60_000;
+
+const day = "2026-11-14";
+const midnight = Date.parse(`${day}T00:00:00Z`);
+
+const hex = (n: number, digits: number) => n.toString(16).padStart(digits, "0");
+
+interface Plan {
+  readonly role: Role;
+  readonly outcome?: Outcome;
+  readonly promptSize: number | null;
+}
+
+const answered = (role: Role, promptSize: number): Plan => ({
+  role,
+  promptSize,
+});
+
+const failed = (role: Role, outcome: Outcome): Plan => ({
+  role,
+  outcome,
+  promptSize: null,
+});
+
+/** A session's requests, one every `every` minutes from `start`, priced by their tokens. */
+const requestsOf = (
+  session: number,
+  start: number,
+  every: number,
+  plans: ReadonlyArray<Plan>,
+): ReadonlyArray<MachineDayRequest> =>
+  plans.map((plan, n) => {
+    const outcome = plan.outcome ?? "ok";
+    const output = outcome === "ok" ? 150 + ((n * 977) % 3200) : null;
+    const prompt = outcome === "ok" ? plan.promptSize : null;
+    return {
+      id: `0193b7d0-${hex(session, 4)}-7000-8000-${hex(n + 1, 12)}`,
+      at: new Date(midnight + start * minute + n * every * minute).toISOString(),
+      role: plan.role,
+      outcome,
+      promptSize: prompt,
+      outputTokens: output,
+      cost:
+        prompt === null || output === null
+          ? null
+          : Math.round((prompt * 0.0000006 + output * 0.000025) * 1e6) / 1e6,
+    };
+  });
+
+const climbing = (
+  from: number,
+  to: number,
+  count: number,
+): ReadonlyArray<Plan> =>
+  Array.from({ length: count }, (_, n) =>
+    answered("main", Math.round(from + ((to - from) * n) / Math.max(1, count - 1))),
+  );
+
+const sessionOf = (
+  n: number,
+  fields: {
+    readonly title: string | null;
+    readonly firstPrompt: string | null;
+    readonly client: string;
+    readonly pool: string;
+    readonly project: string;
+    readonly start: number;
+    readonly every: number;
+    readonly plans: ReadonlyArray<Plan>;
+  },
+) => {
+  const requests = requestsOf(n, fields.start, fields.every, fields.plans);
+  return {
+    id: `0193b7d0-${hex(n, 4)}-7000-8000-5e5510000000`,
+    title: fields.title,
+    firstPrompt: fields.firstPrompt,
+    client: fields.client,
+    pool: fields.pool,
+    project: fields.project,
+    startedAt: requests[0]?.at ?? new Date(midnight).toISOString(),
+    endedAt: requests.at(-1)?.at ?? new Date(midnight).toISOString(),
+    requests,
+  };
+};
+
+/** `GET /api/machines/ada-mbp.local/days/2026-11-14`: eight sessions on three pools, one of them untitled, and an error among the refusals and cancellations. */
+export const busyDay: MachineDay = {
+  machine: "ada-mbp.local",
+  day,
+  pools: ["personal", "work", "spare"],
+  sessions: [
+    sessionOf(1, {
+      title: "Fix the checkout total after a coupon is removed",
+      firstPrompt:
+        "The cart total keeps the coupon's discount after the coupon is removed. Find out why.",
+      client: "claude-code",
+      pool: "work",
+      project: "acme/shop",
+      start: 8 * 60 + 12,
+      every: 3,
+      plans: [
+        answered("title", 900),
+        ...climbing(14_000, 96_000, 24),
+        answered("subagent", 21_000),
+        answered("subagent", 33_000),
+        ...climbing(40_000, 120_000, 10),
+      ],
+    }),
+    sessionOf(2, {
+      title: "Rename the relay's fallback port",
+      firstPrompt: "Rename Fallback to DivertedPool across the relay.",
+      client: "claude-code",
+      pool: "personal",
+      project: "limineol/cota",
+      start: 9 * 60 + 40,
+      every: 2,
+      plans: [
+        answered("title", 700),
+        ...climbing(18_000, 64_000, 12),
+        answered("utility", 4_000),
+        failed("main", "refused"),
+        failed("main", "refused"),
+        answered("main", 66_000),
+      ],
+    }),
+    sessionOf(3, {
+      title: null,
+      firstPrompt:
+        "why does the scrubber keep the word 'organization' in a header value",
+      client: "codex",
+      pool: "spare",
+      project: "limineol/cota",
+      start: 10 * 60 + 5,
+      every: 1,
+      plans: [
+        ...climbing(9_000, 22_000, 6),
+        failed("main", "cancelled"),
+        answered("main", 23_000),
+      ],
+    }),
+    sessionOf(4, {
+      title: "Price the new Haiku in curated.json",
+      firstPrompt: "Add the new Haiku to curated.json with its sources.",
+      client: "claude-code",
+      pool: "personal",
+      project: "limineol/cota",
+      start: 11 * 60 + 30,
+      every: 4,
+      plans: [
+        answered("title", 800),
+        ...climbing(12_000, 48_000, 8),
+        answered("subagent", 15_000),
+      ],
+    }),
+    sessionOf(5, {
+      title: "Dashboard: the machine's day",
+      firstPrompt: "Build the screen for one machine's day.",
