+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, fn } from "storybook/test";
+import {
+  invalidPrice,
+  listedAndOwn,
+  listedOnly,
+  listedPrices,
+  noSuchPool,
+  oneUnpriced,
+  ownPrices,
+  storeUnavailable,
+  unknownToTheList,
+  unknownToTheListWithOwn,
+  unreachable,
+} from "#stories/price.ts";
+import { Price } from "./price.tsx";
+
+const meta = {
+  title: "Screens/Price",
+  component: Price,
+  args: {
+    read: { state: "read", price: listedOnly },
+    onRetry: fn(),
+    save: fn(),
+    drop: fn(),
+  },
+} satisfies Meta<typeof Price>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+const never = () => new Promise<never>(() => {});
+
+export const ListedPriceInForce: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText("The listed price is in force."),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Input")).toHaveValue("3");
+    await expect(canvas.getByLabelText("Cache write")).toHaveValue("3.75");
+    await expect(canvas.getByText("$15")).toBeVisible();
+    await expect(
+      canvas.queryByRole("button", { name: "Drop the pool's price" }),
+    ).not.toBeInTheDocument();
+  },
+};
+
+export const OwnPriceInForce: Story = {
+  args: { read: { state: "read", price: listedAndOwn } },
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Input")).toHaveValue("2.5");
+    await expect(canvas.getByText("$3")).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    ).toBeEnabled();
+  },
+};
+
+export const ModelTheListDoesNotKnow: Story = {
+  args: { read: { state: "read", price: unknownToTheList } },
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText(
+        "No price is in force: the list does not know this model and the pool has none.",
+      ),
+    ).toBeVisible();
+    await expect(
+      canvas.getByText("The shipped price list does not know this model."),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Input")).toHaveValue("");
+    await expect(
+      canvas.getByText(
+        "42 requests of the last 7 days to this model through this pool have no cost: neither price exists.",
+      ),
+    ).toBeVisible();
+  },
+};
+
+export const ModelTheListDoesNotKnowWithOwnPrice: Story = {
+  args: { read: { state: "read", price: unknownToTheListWithOwn } },
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Output")).toHaveValue("2.2");
+    await expect(
+      canvas.getByText("No request of the last 7 days is unpriced."),
+    ).toBeVisible();
+  },
+};
+
+export const OneRequestUnpriced: Story = {
+  args: { read: { state: "read", price: oneUnpriced } },
+  play: async ({ canvas }) => {
+    await expect(
+      canvas.getByText(
+        "1 request of the last 7 days to this model through this pool has no cost: neither price exists.",
+      ),
+    ).toBeVisible();
+  },
+};
+
+export const Reading: Story = {
+  args: { read: { state: "loading" } },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("table", { name: "Price loading" }),
+    ).toBeVisible();
+  },
+};
+
+export const HubCannotBeReached: Story = {
+  args: { read: { state: "failed", error: unreachable } },
+  play: async ({ canvas, args, userEvent }) => {
+    await expect(
+      await canvas.findByText("The hub could not read this price."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByText(
+        "The hub did not answer. Check that it is running and reachable from this browser.",
+      ),
+    ).toBeVisible();
+    await userEvent.click(canvas.getByRole("button", { name: "Try again" }));
+    await expect(args.onRetry).toHaveBeenCalledOnce();
+  },
+};
+
+export const HubStoreUnavailableWhileReading: Story = {
+  args: { read: { state: "failed", error: storeUnavailable } },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub store did not answer."),
+    ).toBeVisible();
+  },
+};
+
+export const Saving: Story = {
+  args: { save: fn(never) },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(
+      await canvas.findByRole("button", { name: "Saving…" }),
+    ).toBeDisabled();
+    await expect(canvas.getByLabelText("Input")).toBeDisabled();
+  },
+};
+
+export const Saved: Story = {
+  args: {
+    save: fn(async () => ({ ...listedOnly, own: ownPrices })),
+  },
+  play: async ({ canvas, args, userEvent }) => {
+    const input = canvas.getByLabelText("Input");
+    await userEvent.clear(input);
+    await userEvent.type(input, "2.5");
+    await userEvent.clear(canvas.getByLabelText("Output"));
+    await userEvent.type(canvas.getByLabelText("Output"), "12");
+    await userEvent.clear(canvas.getByLabelText("Cache read"));
+    await userEvent.type(canvas.getByLabelText("Cache read"), "0.25");
+    await userEvent.clear(canvas.getByLabelText("Cache write"));
+    await userEvent.type(canvas.getByLabelText("Cache write"), "3");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(
+      await canvas.findByText("Saved. This pool's own price is in force."),
+    ).toBeVisible();
+    await expect(args.save).toHaveBeenCalledWith(ownPrices);
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    ).toBeVisible();
+  },
+};
+
+export const SavedUntouchedListedPrice: Story = {
+  args: {
+    save: fn(async () => ({ ...listedOnly, own: listedPrices })),
+  },
+  play: async ({ canvas, args, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByText(/^Saved\./)).toBeVisible();
+    await expect(args.save).toHaveBeenCalledWith(listedPrices);
+  },
+};
+
+export const NotANumberIsNotSent: Story = {
+  play: async ({ canvas, args, userEvent }) => {
+    const output = canvas.getByLabelText("Output");
+    await userEvent.clear(output);
+    await userEvent.type(output, "-4");
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: a price must be a number of dollars, zero or more (output).",
+    );
+    await expect(output).toHaveAttribute("aria-invalid", "true");
+    await expect(args.save).not.toHaveBeenCalled();
+  },
+};
+
+export const RefusedAsInvalid: Story = {
+  args: {
+    save: fn(async () => {
+      throw invalidPrice;
+    }),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The output price must be a number of dollars, zero or more.",
+    );
+    await expect(canvas.getByLabelText("Output")).toHaveAttribute(
+      "aria-invalid",
+      "true",
+    );
+    await expect(canvas.getByLabelText("Input")).toHaveValue("3");
+  },
+};
+
+export const RefusedForNoSuchPool: Story = {
+  args: {
+    save: fn(async () => {
+      throw noSuchPool;
+    }),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The hub has no pool named personal.",
+    );
+  },
+};
+
+export const RefusedWhileTheStoreIsDown: Story = {
+  args: {
+    save: fn(async () => {
+      throw storeUnavailable;
+    }),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The hub store did not answer.",
+    );
+  },
+};
+
+export const SavingWhenTheHubCannotBeReached: Story = {
+  args: {
+    save: fn(async () => {
+      throw unreachable;
+    }),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not saved: The hub did not answer. Check that it is running and reachable from this browser.",
+    );
+  },
+};
+
+export const Dropping: Story = {
+  args: {
+    read: { state: "read", price: listedAndOwn },
+    drop: fn(never),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(await canvas.findByText("Dropping…")).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Save the pool's price" }),
+    ).toBeDisabled();
+  },
+};
+
+export const Dropped: Story = {
+  args: {
+    read: { state: "read", price: listedAndOwn },
+    drop: fn(async () => {}),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(
+      await canvas.findByText(
+        "The pool's own price is dropped. The listed price is in force.",
+      ),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Input")).toHaveValue("3");
+    await expect(
+      canvas.queryByRole("button", { name: "Drop the pool's price" }),
+    ).not.toBeInTheDocument();
+  },
+};
+
+export const DroppedWithNoListedPrice: Story = {
+  args: {
+    read: { state: "read", price: unknownToTheListWithOwn },
+    drop: fn(async () => {}),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(
+      await canvas.findByText(
+        "The pool's own price is dropped. No price is in force now.",
+      ),
+    ).toBeVisible();
+    await expect(canvas.getByLabelText("Input")).toHaveValue("");
+  },
+};
+
+export const DroppingRefused: Story = {
+  args: {
+    read: { state: "read", price: listedAndOwn },
+    drop: fn(async () => {
+      throw storeUnavailable;
+    }),
+  },
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(
+      canvas.getByRole("button", { name: "Drop the pool's price" }),
+    );
+    await expect(await canvas.findByRole("alert")).toHaveTextContent(
+      "Not dropped: The hub store did not answer.",
+    );
+    await expect(
+      canvas.getByText("The pool's own price is in force."),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  args: { read: { state: "read", price: listedAndOwn } },
+  globals: { viewport: { value: "mobile2" } },
+};
