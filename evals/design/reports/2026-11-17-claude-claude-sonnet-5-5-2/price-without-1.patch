@@ -0,0 +1,347 @@
+import { Button } from "@cota/ui/components/button";
+import { FieldNote } from "@cota/ui/components/field-note";
+import { Input } from "@cota/ui/components/input";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFoot,
+  ListPanelHead,
+} from "@cota/ui/components/list-panel";
+import { Note } from "@cota/ui/components/note";
+import { Subheading } from "@cota/ui/components/page";
+import { Skeleton } from "@cota/ui/components/skeleton";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@cota/ui/components/table";
+import { type FormEvent, useId, useState } from "react";
+import { Problem, problemOf } from "#shared/problem.tsx";
+import { plural } from "#shared/words.ts";
+
+/** Dollars per million tokens, by usage class. */
+export interface Prices {
+  readonly input: number;
+  readonly output: number;
+  readonly cacheRead: number;
+  readonly cacheWrite: number;
+}
+
+/** What `GET /api/pools/:pool/prices/:model` answers. */
+export interface ModelPrice {
+  readonly pool: string;
+  readonly model: string;
+  readonly listed: Prices | null;
+  readonly own: Prices | null;
+  readonly unpricedRequests: number;
+}
+
+/** What the hub has answered so far: nothing yet, a problem, or the price. */
+export type PriceRead =
+  | { readonly state: "loading" }
+  | { readonly state: "failed"; readonly error: unknown }
+  | { readonly state: "read"; readonly price: ModelPrice };
+
+const classes: ReadonlyArray<{
+  readonly key: keyof Prices;
+  readonly label: string;
+}> = [
+  { key: "input", label: "Input" },
+  { key: "output", label: "Output" },
+  { key: "cacheRead", label: "Cache read" },
+  { key: "cacheWrite", label: "Cache write" },
+];
+
+type Drafts = Record<keyof Prices, string>;
+
+const draftsOf = (price: ModelPrice): Drafts => {
+  const from = price.own ?? price.listed;
+  return {
+    input: from === null ? "" : String(from.input),
+    output: from === null ? "" : String(from.output),
+    cacheRead: from === null ? "" : String(from.cacheRead),
+    cacheWrite: from === null ? "" : String(from.cacheWrite),
+  };
+};
+
+const dollarsPattern = /^(\d+\.?\d*|\.\d+)$/;
+
+const dollars = (value: number) => `$${value}`;
+
+type Said = { readonly tone: "quiet" | "danger"; readonly text: string } | null;
+
+/** One model's price through one pool: each of the four prices beside the listed one, saved as the pool's own or dropped. */
+export function Price({
+  read,
+  onRetry,
+  save,
+  drop,
+}: {
+  readonly read: PriceRead;
+  readonly onRetry: () => void;
+  readonly save: (prices: Prices) => Promise<ModelPrice>;
+  readonly drop: () => Promise<void>;
+}) {
+  if (read.state === "loading") {
+    return (
+      <ListPanel aria-label="Price" aria-busy="true">
+        <ListPanelHead>
+          <Skeleton className="w-64" />
+        </ListPanelHead>
+        <ListPanelBody>
+          <Table aria-label="Price loading">
+            <PriceHead />
+            <TableBody>
+              {classes.map(({ key }) => (
+                <TableRow key={key} aria-hidden="true">
+                  <TableCell>
+                    <Skeleton className="w-20" />
+                  </TableCell>
+                  <TableCell numeric>
+                    <Skeleton className="ml-auto w-12" />
+                  </TableCell>
+                  <TableCell>
+                    <Skeleton className="h-8 w-full" />
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        </ListPanelBody>
+      </ListPanel>
+    );
+  }
+  if (read.state === "failed") {
+    return (
+      <ListPanel aria-label="Price">
+        <ListPanelBody>
+          <Problem
+            inside
+            title="The hub could not read this price."
+            error={read.error}
+            onRetry={onRetry}
+          />
+        </ListPanelBody>
+      </ListPanel>
+    );
+  }
+  return (
+    <PriceForm
+      key={`${read.price.pool}\u0000${read.price.model}`}
+      price={read.price}
+      save={save}
+      drop={drop}
+    />
+  );
+}
+
+function PriceHead() {
+  return (
+    <TableHeader>
+      <TableRow>
+        <TableHead scope="col">Usage</TableHead>
+        <TableHead scope="col" numeric>
+          Listed, per million tokens
+        </TableHead>
+        <TableHead scope="col">Pool's own, per million tokens</TableHead>
+      </TableRow>
+    </TableHeader>
+  );
+}
+
+function PriceForm({
+  price,
+  save,
+  drop,
+}: {
+  readonly price: ModelPrice;
+  readonly save: (prices: Prices) => Promise<ModelPrice>;
+  readonly drop: () => Promise<void>;
+}) {
+  const ids = useId();
+  const [kept, setKept] = useState(price);
+  const [drafts, setDrafts] = useState<Drafts>(() => draftsOf(price));
+  const [pending, setPending] = useState<"saving" | "dropping" | null>(null);
+  const [note, setNote] = useState<Said>(null);
+  const [invalid, setInvalid] = useState<ReadonlyArray<keyof Prices>>([]);
+
+  const change = (key: keyof Prices, text: string) => {
+    setDrafts((now) => ({ ...now, [key]: text }));
+    setInvalid((now) => now.filter((each) => each !== key));
+    setNote(null);
+  };
+
+  const submit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (pending !== null) return;
+    const wrong = classes.filter(
+      ({ key }) => !dollarsPattern.test(drafts[key].trim()),
+    );
+    if (wrong.length > 0) {
+      setInvalid(wrong.map(({ key }) => key));
+      setNote({
+        tone: "danger",
+        text: `Not saved: a price must be a number of dollars, zero or more (${wrong
+          .map(({ label }) => label.toLowerCase())
+          .join(", ")}).`,
+      });
+      return;
+    }
+    setInvalid([]);
+    setNote(null);
+    setPending("saving");
+    try {
+      const answer = await save({
+        input: Number(drafts.input),
+        output: Number(drafts.output),
+        cacheRead: Number(drafts.cacheRead),
+        cacheWrite: Number(drafts.cacheWrite),
+      });
+      setKept(answer);
+      setDrafts(draftsOf(answer));
+      setNote({
+        tone: "quiet",
+        text: "Saved. This pool's own price is in force.",
+      });
+    } catch (error) {
+      const detail = problemOf(error);
+      setInvalid(
+        classes.filter(({ key }) => detail.includes(key)).map(({ key }) => key),
+      );
+      setNote({ tone: "danger", text: `Not saved: ${detail}` });
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const dropOwn = async () => {
+    if (pending !== null) return;
+    setNote(null);
+    setInvalid([]);
+    setPending("dropping");
+    try {
+      await drop();
+      const next = { ...kept, own: null };
+      setKept(next);
+      setDrafts(draftsOf(next));
+      setNote({
+        tone: "quiet",
+        text:
+          next.listed === null
+            ? "The pool's own price is dropped. No price is in force now."
+            : "The pool's own price is dropped. The listed price is in force.",
+      });
+    } catch (error) {
+      setNote({ tone: "danger", text: `Not dropped: ${problemOf(error)}` });
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const inForce =
+    kept.own !== null
+      ? "The pool's own price is in force."
+      : kept.listed !== null
+        ? "The listed price is in force."
+        : "No price is in force: the list does not know this model and the pool has none.";
+
+  const said =
+    pending === null
+      ? note
+      : {
+          tone: "quiet" as const,
+          text: pending === "saving" ? "Saving…" : "Dropping…",
+        };
+
+  return (
+    <ListPanel aria-label="Price">
+      <ListPanelHead>
+        <div className="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
+          <Subheading level={2}>
+            <code>{kept.model}</code> through <code>{kept.pool}</code>
+          </Subheading>
+          <Note>{inForce}</Note>
+          {kept.listed === null ? (
+            <Note>The shipped price list does not know this model.</Note>
+          ) : null}
+        </div>
+      </ListPanelHead>
+      <ListPanelBody>
+        <form
+          aria-label={`Price of ${kept.model} through ${kept.pool}`}
+          onSubmit={submit}
+          noValidate
+        >
+          <Table aria-label="Prices">
+            <PriceHead />
+            <TableBody>
+              {classes.map(({ key, label }) => (
+                <TableRow key={key}>
+                  <TableCell>
+                    <label htmlFor={`${ids}-${key}`}>{label}</label>
+                  </TableCell>
+                  <TableCell numeric>
+                    {kept.listed === null ? (
+                      <span title="The list does not know this model">—</span>
+                    ) : (
+                      dollars(kept.listed[key])
+                    )}
+                  </TableCell>
+                  <TableCell className="w-1/3 min-w-32">
+                    <Input
+                      id={`${ids}-${key}`}
+                      inputMode="decimal"
+                      autoComplete="off"
+                      spellCheck={false}
+                      placeholder={
+                        kept.listed === null ? "0" : String(kept.listed[key])
+                      }
+                      value={drafts[key]}
+                      aria-invalid={invalid.includes(key) || undefined}
+                      disabled={pending !== null}
+                      onChange={(event) => change(key, event.target.value)}
+                    />
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+          <div className="flex flex-wrap items-center gap-1.5 p-3">
+            <Button type="submit" size="sm" disabled={pending !== null}>
+              {pending === "saving" ? "Saving…" : "Save the pool's price"}
+            </Button>
+            {kept.own === null ? null : (
+              <Button
+                type="button"
+                variant="outline"
+                size="sm"
+                disabled={pending !== null}
+                onClick={dropOwn}
+              >
+                Drop the pool's price
+              </Button>
+            )}
+            {said === null ? null : (
+              <FieldNote tone={said.tone} className="mt-0">
+                {said.text}
+              </FieldNote>
+            )}
+          </div>
+        </form>
+      </ListPanelBody>
+      <ListPanelFoot>
+        <span>
+          {kept.unpricedRequests === 0
+            ? "No request of the last 7 days is unpriced."
+            : `${plural(kept.unpricedRequests, "request")} of the last 7 days to this model through this pool ${kept.unpricedRequests === 1 ? "has" : "have"} no cost: neither price exists.`}
+        </span>
+        <Note>
+          Dollars per million tokens. A pool's own price wins over the list.
+        </Note>
+      </ListPanelFoot>
+    </ListPanel>
+  );
+}
