+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFoot,
+  ListPanelHead,
+} from "@cota/ui/components/list-panel";
+import { Note } from "@cota/ui/components/note";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Segmented } from "@cota/ui/components/segmented";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableMagnitude,
+  TableRow,
+  TableSecondary,
+  TableSort,
+} from "@cota/ui/components/table";
+import { type ReactNode, useMemo, useState } from "react";
+import { poolHues } from "#shared/domain/hues.ts";
+import {
+  type KeysSort,
+  narrowed,
+  type Scope,
+  shortWindow,
+  sorted,
+} from "#shared/domain/keys.ts";
+import { ago, tokens } from "#shared/domain/quantities.ts";
+import { counted, plural, when } from "#shared/words.ts";
+
+/** What `GET /api/keys` answers. */
+export interface KeysAnswer {
+  readonly keys: ReadonlyArray<KeyRow>;
+  readonly pools: ReadonlyArray<string>;
+  readonly logBegins: string;
+}
+
+export interface KeyRow {
+  readonly id: string;
+  readonly note: string | null;
+  readonly scope: Scope;
+  readonly pools: ReadonlyArray<string>;
+  readonly lastUsedAt: string | null;
+  readonly lastMachine: string | null;
+  readonly requests: number;
+  readonly tokens: number | null;
+}
+
+type Shown = Scope | "all";
+
+const scopeOptions: ReadonlyArray<{
+  readonly value: Shown;
+  readonly label: string;
+}> = [
+  { value: "all", label: "All" },
+  { value: "subscription", label: "Subscription" },
+  { value: "keyed", label: "Keyed" },
+  { value: "reader", label: "Reader" },
+];
+
+const scopeName: Record<Scope, string> = {
+  subscription: "Subscription",
+  keyed: "Keyed",
+  reader: "Reader",
+};
+
+const sevenDays = 7 * 24 * 60 * 60 * 1000;
+
+const tokensText = (row: KeyRow) => {
+  if (row.requests === 0) return "none";
+  return row.tokens === null ? "unreported" : tokens(row.tokens);
+};
+
+function Opens({
+  row,
+  markOf,
+}: {
+  readonly row: KeyRow;
+  readonly markOf: (pool: string) => ReactNode;
+}) {
+  if (row.scope === "reader") {
+    return <span className="text-text-3">The request log, no pool</span>;
+  }
+  if (row.pools.length === 0) {
+    return <span className="text-text-3">No pool</span>;
+  }
+  return (
+    <ul className="flex flex-wrap gap-x-3 gap-y-1">
+      {row.pools.map((pool) => (
+        <li key={pool} className="flex min-w-0 items-center gap-1.5">
+          {markOf(pool)}
+          <span className="truncate">{pool}</span>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function LastUse({ row, now }: { readonly row: KeyRow; readonly now: number }) {
+  if (row.lastUsedAt === null) {
+    return <span className="text-text-3">Never used</span>;
+  }
+  const at = Date.parse(row.lastUsedAt);
+  return <span title={when(at, now)}>{ago(now - at)}</span>;
+}
+
+/** The hub keys of the configuration, each with what it opens, its last use and what it carried in the last 7 days; the answer is the caller's. */
+export function Keys({
+  answer,
+  now,
+}: {
+  readonly answer: KeysAnswer;
+  readonly now: number;
+}) {
+  const [scope, setScope] = useState<Shown>("all");
+  const [by, setBy] = useState<KeysSort>("last-use");
+  const hues = useMemo(() => poolHues(answer.pools), [answer.pools]);
+  const markOf = (pool: string): ReactNode => (
+    <PoolMark hue={hues.get(pool) ?? "neutral"} name={pool} />
+  );
+
+  const listed = sorted(
+    narrowed(answer.keys, scope === "all" ? null : scope),
+    by,
+  );
+  const sortedBy = (sort: KeysSort) => (sort === by ? "descending" : undefined);
+  const peak = Math.max(1, ...listed.map((row) => row.requests));
+  const beginsOn = shortWindow(answer.logBegins, now);
+  const unused = answer.keys.filter((row) => row.lastUsedAt === null).length;
+  const idle = answer.keys.filter(
+    (row) =>
+      row.lastUsedAt !== null && now - Date.parse(row.lastUsedAt) > sevenDays,
+  ).length;
+
+  const body = () => {
+    if (answer.keys.length === 0) {
+      return (
+        <Empty>
+          <EmptyTitle>The configuration holds no hub keys.</EmptyTitle>
+          <EmptyDescription>
+            A machine needs a hub key to use this hub. Add one to the
+            configuration to see it here.
+          </EmptyDescription>
+        </Empty>
+      );
+    }
+    if (listed.length === 0) {
+      return (
+        <Empty>
+          <EmptyTitle>No hub key has this scope.</EmptyTitle>
+          <EmptyDescription>
+            Try another scope, or all of them.
+          </EmptyDescription>
+        </Empty>
+      );
+    }
+    return (
+      <Table aria-label="Hub keys">
+        <TableHeader from="md">
+          <TableRow>
+            <TableHead scope="col">Key</TableHead>
+            <TableHead scope="col" from="md">
+              Opens
+            </TableHead>
+            <TableHead scope="col" from="lg">
+              Scope
+            </TableHead>
+            <TableHead scope="col" sorted={sortedBy("last-use")}>
+              <TableSort
+                sorted={sortedBy("last-use")}
+                onClick={() => setBy("last-use")}
+              >
+                Last used
+              </TableSort>
+            </TableHead>
+            <TableHead
+              scope="col"
+              numeric
+              from="md"
+              sorted={sortedBy("requests")}
+            >
+              <TableSort
+                numeric
+                sorted={sortedBy("requests")}
+                onClick={() => setBy("requests")}
+              >
+                Requests
+              </TableSort>
+            </TableHead>
+            <TableHead scope="col" numeric from="md">
+              Tokens
+            </TableHead>
+          </TableRow>
+        </TableHeader>
+        {listed.map((row) => (
+          <TableBody key={row.id}>
+            <TableRow>
+              <TableCell className="max-w-0 min-w-40">
+                <TableLabel className="block">
+                  <code className="font-mono">{row.id}</code>
+                </TableLabel>
+                <TableSecondary>
+                  {row.note ?? "No note"}
+                  <span className="@2xl/panel:hidden">
+                    {` · ${scopeName[row.scope]} · ${plural(row.requests, "request")} · ${tokensText(row)} tokens`}
+                  </span>
+                </TableSecondary>
+              </TableCell>
+              <TableCell from="md">
+                <Opens row={row} markOf={markOf} />
+              </TableCell>
+              <TableCell from="lg">{scopeName[row.scope]}</TableCell>
+              <TableCell>
+                <LastUse row={row} now={now} />
+                {row.lastUsedAt !== null ? (
+                  <TableSecondary>
+                    {row.lastMachine ?? "No machine tagged"}
+                  </TableSecondary>
+                ) : null}
+              </TableCell>
+              <TableCell numeric from="md">
+                {counted(row.requests)}
+                <TableMagnitude fraction={row.requests / peak} />
+              </TableCell>
+              <TableCell numeric from="md">
+                {tokensText(row)}
+              </TableCell>
+            </TableRow>
+          </TableBody>
+        ))}
+      </Table>
+    );
+  };
+
+  return (
+    <Page className="@container">
+      <PageHeader>
+        <div>
+          <PageTitle>Hub keys</PageTitle>
+          <PageDescription>
+            {[
+              plural(answer.keys.length, "key"),
+              ...(unused > 0 ? [`${unused} never used`] : []),
+              ...(idle > 0 ? [`${idle} idle for over 7 days`] : []),
+            ].join(", ")}
+          </PageDescription>
+        </div>
+        <Segmented
+          label="Scope"
+          size="sm"
+          value={scope}
+          options={scopeOptions}
+          onValueChange={setScope}
+        />
+      </PageHeader>
+
+      <ListPanel aria-label="The hub keys">
+        <ListPanelHead alone>
+          <Note>
+            Requests and tokens are those of the last 7 days
+            {beginsOn === null
+              ? "."
+              : `, though the request log begins on ${beginsOn}.`}
+          </Note>
+        </ListPanelHead>
+        <ListPanelBody>{body()}</ListPanelBody>
+        {answer.keys.length > 0 ? (
+          <ListPanelFoot>
+            {scope === "all"
+              ? plural(listed.length, "key")
+              : `${counted(listed.length)} of ${plural(answer.keys.length, "key")}`}
+          </ListPanelFoot>
+        ) : null}
+      </ListPanel>
+    </Page>
+  );
+}
