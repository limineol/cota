+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, within } from "storybook/test";
+import { keysAnswer, keysNow, keysOfAYoungLog, noKeys } from "#stories/keys.ts";
+import { Keys } from "./keys.tsx";
+
+const meta = {
+  title: "Screens/Keys",
+  component: Keys,
+  args: { answer: keysAnswer, now: keysNow },
+} satisfies Meta<typeof Keys>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+const idsOf = (table: HTMLElement) =>
+  within(table)
+    .getAllByText(/^k_[0-9a-f]{6}$/)
+    .map((cell) => cell.textContent);
+
+export const Everything: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("12 keys, 3 never used, 2 idle for over 7 days"),
+    ).toBeVisible();
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(idsOf(table)).toHaveLength(12);
+    await expect(idsOf(table)[0]).toBe("k_7f3a9c");
+    await expect(
+      within(table).getByRole("columnheader", { name: "Last used" }),
+    ).toHaveAttribute("aria-sort", "descending");
+    await expect(within(table).getAllByText("Never used")).toHaveLength(3);
+    await expect(canvas.getByText("4m ago")).toBeVisible();
+    await expect(canvas.getAllByText("tower").length).toBeGreaterThan(0);
+    await expect(canvas.getByText("96.4M")).toBeVisible();
+  },
+};
+
+export const NeverUsedLast: Story = {
+  play: async ({ canvas }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(idsOf(table).slice(-3)).toEqual([
+      "k_91d6a2",
+      "k_d9144e",
+      "k_0b9d3a",
+    ]);
+  },
+};
+
+export const SortedByRequests: Story = {
+  play: async ({ canvas, userEvent }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await userEvent.click(
+      within(table).getByRole("button", { name: "Requests" }),
+    );
+    await expect(
+      within(table).getByRole("columnheader", { name: "Requests" }),
+    ).toHaveAttribute("aria-sort", "descending");
+    await expect(idsOf(table).slice(0, 3)).toEqual([
+      "k_5e0f48",
+      "k_7f3a9c",
+      "k_2b81de",
+    ]);
+  },
+};
+
+export const NarrowedToOneScope: Story = {
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(await canvas.findByRole("radio", { name: "Reader" }));
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(idsOf(table)).toEqual(["k_3f5c80", "k_e72a65", "k_0b9d3a"]);
+    await expect(canvas.getByText("3 of 12 keys")).toBeVisible();
+    await expect(
+      within(table).getAllByText("The request log, no pool"),
+    ).toHaveLength(3);
+  },
+};
+
+export const ALogThatBeganThisWeek: Story = {
+  args: { answer: keysOfAYoungLog },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(
+        "Requests and tokens are those of the last 7 days, though the request log begins on 2026-11-14.",
+      ),
+    ).toBeVisible();
+  },
+};
+
+export const NoKeys: Story = {
+  args: { answer: noKeys },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The configuration holds no hub keys."),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  globals: { viewport: { value: "mobile2" } },
+  play: async ({ canvas }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(
+      within(table).queryByRole("columnheader", { name: "Tokens" }),
+    ).toBeNull();
+  },
+};
