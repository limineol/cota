@@ -0,0 +1,50 @@
+export const scopes = ["subscription", "keyed", "reader"] as const;
+
+export type Scope = (typeof scopes)[number];
+
+export type KeysSort = "last-use" | "requests";
+
+/** What the list needs of a hub key. */
+export interface KeyRow {
+  readonly scope: Scope;
+  readonly lastUsedAt: string | null;
+  readonly requests: number;
+}
+
+const day = 24 * 60 * 60 * 1000;
+
+/** The keys of one scope, or all of them, in the order given. */
+export const narrowed = <Row extends KeyRow>(
+  rows: ReadonlyArray<Row>,
+  scope: Scope | null,
+): ReadonlyArray<Row> =>
+  scope === null ? rows : rows.filter((row) => row.scope === scope);
+
+const usedAt = (row: KeyRow) =>
+  row.lastUsedAt === null
+    ? Number.NEGATIVE_INFINITY
+    : Date.parse(row.lastUsedAt);
+
+/** The keys, the most recently used or the busiest first; a key never used comes after every used one, and keys that tie keep their order. */
+export const sorted = <Row extends KeyRow>(
+  rows: ReadonlyArray<Row>,
+  by: KeysSort,
+): ReadonlyArray<Row> =>
+  rows
+    .map((row, index) => ({ row, index }))
+    .sort((a, b) => {
+      const order =
+        by === "requests"
+          ? b.row.requests - a.row.requests
+          : usedAt(b.row) === usedAt(a.row)
+            ? 0
+            : usedAt(b.row) > usedAt(a.row)
+              ? 1
+              : -1;
+      return order === 0 ? a.index - b.index : order;
+    })
+    .map(({ row }) => row);
+
+/** The day the request log begins when it begins inside the last 7 days, so that the 7 days' figures cover less than 7 days; otherwise nothing. */
+export const shortWindow = (logBegins: string, now: number): string | null =>
+  Date.parse(logBegins) > now - 7 * day ? logBegins : null;
