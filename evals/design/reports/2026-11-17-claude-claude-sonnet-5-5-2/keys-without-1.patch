@@ -0,0 +1,71 @@
+import { describe, expect, it } from "@effect/vitest";
+import { Arbitrary, Schema } from "effect";
+import { type KeyRow, narrowed, scopes, shortWindow, sorted } from "./keys.ts";
+
+const rows = Arbitrary.schema(
+  Schema.Array(
+    Schema.Struct({
+      scope: Schema.Literals(scopes),
+      at: Schema.NullOr(
+        Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 5 })),
+      ),
+      requests: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 5 })),
+    }),
+  ),
+).pipe(
+  Arbitrary.map((items) =>
+    items.map(({ scope, at, requests }) => ({
+      scope,
+      lastUsedAt:
+        at === null ? null : new Date(Date.UTC(2026, 10, 1 + at)).toISOString(),
+      requests,
+    })),
+  ),
+);
+
+const time = (key: KeyRow) =>
+  key.lastUsedAt === null ? -1 : Date.parse(key.lastUsedAt);
+
+describe("the hub keys' list", () => {
+  it.prop(
+    "V43: narrowing keeps the keys of the scope in their order, and sorting keeps every key, the used before the never used and each order from greatest, ties in their order",
+    { rows },
+    ({ rows: keys }) => {
+      const tagged = keys.map((key, index) => ({ ...key, index }));
+      for (const scope of scopes) {
+        expect(narrowed(tagged, scope)).toEqual(
+          tagged.filter((key) => key.scope === scope),
+        );
+      }
+      expect(narrowed(tagged, null)).toEqual(tagged);
+
+      const byUse = sorted(tagged, "last-use");
+      const byRequests = sorted(tagged, "requests");
+      for (const ordered of [byUse, byRequests]) {
+        expect([...ordered].sort((a, b) => a.index - b.index)).toEqual(tagged);
+      }
+      byUse.forEach((key, at) => {
+        const next = byUse[at + 1];
+        if (next === undefined) return;
+        expect(time(key)).toBeGreaterThanOrEqual(time(next));
+        if (time(key) === time(next))
+          expect(key.index).toBeLessThan(next.index);
+      });
+      byRequests.forEach((key, at) => {
+        const next = byRequests[at + 1];
+        if (next === undefined) return;
+        expect(key.requests).toBeGreaterThanOrEqual(next.requests);
+        if (key.requests === next.requests) {
+          expect(key.index).toBeLessThan(next.index);
+        }
+      });
+    },
+  );
+
+  it("V44: the window is short only when the log begins inside the last 7 days", () => {
+    const now = Date.parse("2026-11-17T12:00:00Z");
+    expect(shortWindow("2026-11-12", now)).toBe("2026-11-12");
+    expect(shortWindow("2026-11-10", now)).toBeNull();
+    expect(shortWindow("2026-10-01", now)).toBeNull();
+  });
+});
