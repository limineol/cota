+import { describe, expect, it } from "@effect/vitest";
+import type { HubKey } from "./answer.ts";
+import {
+  logCoversTheWeek,
+  narrowed,
+  neverUsed,
+  ordered,
+  reordered,
+} from "./arrange.ts";
+
+const key = (id: string, shape: Partial<HubKey>): HubKey => ({
+  id,
+  note: null,
+  scope: "subscription",
+  pools: [],
+  lastUsedAt: null,
+  lastMachine: null,
+  requests: 0,
+  tokens: null,
+  ...shape,
+});
+
+const keys = [
+  key("a", { lastUsedAt: "2026-11-10T00:00:00.000Z", requests: 5 }),
+  key("b", { scope: "reader" }),
+  key("c", { lastUsedAt: "2026-11-16T00:00:00.000Z", requests: 90 }),
+  key("d", { scope: "keyed", lastUsedAt: "2026-11-12T00:00:00.000Z" }),
+  key("e", { scope: "reader" }),
+];
+
+const idsOf = (list: ReadonlyArray<HubKey>) => list.map((each) => each.id);
+
+describe("the hub keys list", () => {
+  it("lists every key while no scope is chosen", () => {
+    expect(idsOf(narrowed(keys, null))).toEqual(["a", "b", "c", "d", "e"]);
+  });
+
+  it("keeps the keys of the chosen scope in the order given", () => {
+    expect(idsOf(narrowed(keys, "reader"))).toEqual(["b", "e"]);
+  });
+
+  it("puts the most recently used key first and the keys never used last", () => {
+    expect(
+      idsOf(ordered(keys, { by: "used", direction: "descending" })),
+    ).toEqual(["c", "d", "a", "b", "e"]);
+  });
+
+  it("puts the keys never used first when the order is reversed", () => {
+    expect(
+      idsOf(ordered(keys, { by: "used", direction: "ascending" })),
+    ).toEqual(["b", "e", "a", "d", "c"]);
+  });
+
+  it("orders by requests, keeping the order given among equal keys", () => {
+    expect(
+      idsOf(ordered(keys, { by: "requests", direction: "descending" })),
+    ).toEqual(["c", "a", "b", "d", "e"]);
+  });
+
+  it("reverses the column in use and starts another with its largest first", () => {
+    const used = { by: "used", direction: "descending" } as const;
+    expect(reordered(used, "used")).toEqual({
+      by: "used",
+      direction: "ascending",
+    });
+    expect(
+      reordered({ by: "used", direction: "ascending" }, "requests"),
+    ).toEqual({ by: "requests", direction: "descending" });
+  });
+
+  it("says the log covers the week only when it began before the week did", () => {
+    const now = Date.parse("2026-11-17T12:00:00.000Z");
+    expect(logCoversTheWeek("2026-11-09", now)).toBe(true);
+    expect(logCoversTheWeek("2026-11-10", now)).toBe(false);
+  });
+
+  it("counts the keys that never sent a request", () => {
+    expect(neverUsed(keys)).toBe(2);
+  });
+});
diff --git a/apps/web/src/screens/keys/arrange.ts b/apps/web/src/screens/keys/arrange.ts
new file mode 100644
index 0000000..40a0092
--- /dev/null
+++ b/apps/web/src/screens/keys/arrange.ts
@@ -0,0 +1,71 @@
+import type { HubKey, Scope } from "./answer.ts";
+
+export type SortBy = "used" | "requests";
+
+export type Direction = "ascending" | "descending";
+
+export interface Order {
+  readonly by: SortBy;
+  readonly direction: Direction;
+}
+
+/** What the list is narrowed to (`null` for every scope) and how it is ordered. */
+export interface Choice {
+  readonly scope: Scope | null;
+  readonly order: Order;
+}
+
+export const defaultChoice: Choice = {
+  scope: null,
+  order: { by: "used", direction: "descending" },
+};
+
+/** The keys of one scope, or all of them, in the order given. */
+export const narrowed = (
+  keys: ReadonlyArray<HubKey>,
+  scope: Scope | null,
+): ReadonlyArray<HubKey> =>
+  scope === null ? keys : keys.filter((key) => key.scope === scope);
+
+const lastUsed = (key: HubKey) =>
+  key.lastUsedAt === null
+    ? Number.NEGATIVE_INFINITY
+    : Date.parse(key.lastUsedAt);
+
+const sortedValue = (by: SortBy, key: HubKey) =>
+  by === "used" ? lastUsed(key) : key.requests;
+
+/** Keys by last use or by requests; a key never used counts as least used, and equal keys keep the order given. */
+export const ordered = (
+  keys: ReadonlyArray<HubKey>,
+  { by, direction }: Order,
+): ReadonlyArray<HubKey> => {
+  const sign = direction === "ascending" ? 1 : -1;
+  return keys.toSorted((a, b) => {
+    const left = sortedValue(by, a);
+    const right = sortedValue(by, b);
+    if (left === right) return 0;
+    return left < right ? -sign : sign;
+  });
+};
+
+/** Choosing the column the list is in the order of reverses it; choosing another starts with its largest first. */
+export const reordered = (order: Order, by: SortBy): Order =>
+  order.by === by
+    ? {
+        by,
+        direction:
+          order.direction === "descending" ? "ascending" : "descending",
+      }
+    : { by, direction: "descending" };
+
+const dayMs = 24 * 60 * 60 * 1000;
+const weekMs = 7 * dayMs;
+
+/** Whether the request log held the whole of the last 7 days: its first day, all of it, came before they began. */
+export const logCoversTheWeek = (logBegins: string, now: number) =>
+  Date.parse(logBegins) + dayMs <= now - weekMs;
+
+/** Keys that have never sent a request. */
+export const neverUsed = (keys: ReadonlyArray<HubKey>) =>
+  keys.filter((key) => key.lastUsedAt === null).length;
