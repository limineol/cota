+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { expect, fn, screen, waitFor, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { keysRead, noKeys, youngLog } from "#stories/keys.ts";
+import { withApi } from "#stories/page.tsx";
+import { type Choice, defaultChoice } from "./arrange.ts";
+import { Keys, type KeysRead } from "./keys.tsx";
+
+const meta = {
+  title: "Screens/Keys",
+  decorators: [withApi([displayNames])],
+  parameters: { layout: "fullscreen" },
+} satisfies Meta;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+/** Content dimmed while a newer answer is on its way is inactive, which WCAG 1.4.3 exempts from contrast. */
+const staleContrast = {
+  a11y: {
+    config: {
+      rules: [{ id: "color-contrast", selector: ":not([data-stale] *)" }],
+    },
+  },
+};
+
+function Screen({
+  read,
+  start = defaultChoice,
+}: {
+  readonly read: KeysRead;
+  readonly start?: Choice;
+}) {
+  const [choice, setChoice] = useState(start);
+  return <Keys read={read} choice={choice} onChoice={setChoice} />;
+}
+
+const screenOf = (read: KeysRead, start?: Choice): StoryObj => ({
+  render: () => (
+    <Screen read={read} {...(start === undefined ? {} : { start })} />
+  ),
+});
+
+const idsOf = (table: HTMLElement) =>
+  within(table)
+    .getAllByRole("row")
+    .slice(1)
+    .map((row) => within(row).getAllByText(/^k_[0-9a-f]{6}$/)[0]?.textContent);
+
+export const TwelveKeys: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("12 hub keys, 3 never used"),
+    ).toBeVisible();
+    const table = canvas.getByRole("table", { name: "Hub keys" });
+    await expect(within(table).getAllByRole("row")).toHaveLength(13);
+    await expect(idsOf(table)[0]).toBe("k_7f3a9c");
+    await expect(within(table).getAllByText("Never used")).toHaveLength(3);
+    await expect(within(table).getAllByText("Desk")).toHaveLength(2);
+    await expect(
+      canvas.getByText("Requests and tokens are of the last 7 days."),
+    ).toBeVisible();
+  },
+};
+
+export const WhatAKeyOpens: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  play: async ({ canvas }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    const pairing = within(table).getByText("pairing session").closest("tr");
+    if (pairing === null) throw new Error("The pairing key is in no row.");
+    await expect(within(pairing).getByText("5 pools")).toBeVisible();
+    const reader = within(table).getByText("reading agent").closest("tr");
+    if (reader === null) throw new Error("The reader key is in no row.");
+    await expect(within(reader).getByText("No pool")).toBeVisible();
+    await expect(within(reader).getByText("None")).toBeVisible();
+  },
+};
+
+export const TokensUnreported: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  play: async ({ canvas }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    const pairing = within(table).getByText("pairing session").closest("tr");
+    if (pairing === null) throw new Error("The pairing key is in no row.");
+    await expect(within(pairing).getByText("unreported")).toBeVisible();
+    const spare = within(table).getByText("spare phone").closest("tr");
+    if (spare === null) throw new Error("The spare key is in no row.");
+    await expect(within(spare).getByText("none")).toBeVisible();
+  },
+};
+
+export const NarrowedToAScope: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  parameters: staleContrast,
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(await canvas.findByRole("button", { name: "Scope" }));
+    await userEvent.click(
+      await screen.findByRole("menuitemcheckbox", { name: /Reader/ }),
+    );
+    await userEvent.keyboard("{Escape}");
+    await waitFor(() => expect(screen.queryByRole("menu")).toBeNull());
+    const table = canvas.getByRole("table", { name: "Hub keys" });
+    await expect(idsOf(table)).toEqual(["k_e6a30b", "k_a1c2f8", "k_d95e41"]);
+    await expect(canvas.getByText("3 hub keys")).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Scope Reader" }),
+    ).toBeVisible();
+  },
+};
+
+export const ResettingTheScope: Story = {
+  ...screenOf(
+    { status: "read", answer: keysRead },
+    { ...defaultChoice, scope: "keyed" },
+  ),
+  parameters: staleContrast,
+  play: async ({ canvas, userEvent }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(within(table).getAllByRole("row")).toHaveLength(4);
+    await userEvent.click(canvas.getByRole("button", { name: /Reset/ }));
+    await expect(within(table).getAllByRole("row")).toHaveLength(13);
+    await expect(canvas.getByRole("button", { name: "Scope" })).toBeVisible();
+  },
+};
+
+export const SortedByRequests: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  play: async ({ canvas, userEvent }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(
+      within(table).getByRole("columnheader", { name: /Last used/ }),
+    ).toHaveAttribute("aria-sort", "descending");
+    await userEvent.click(
+      within(table).getByRole("button", { name: /Requests/ }),
+    );
+    await expect(
+      within(table).getByRole("columnheader", { name: /Requests/ }),
+    ).toHaveAttribute("aria-sort", "descending");
+    await expect(idsOf(table).slice(0, 3)).toEqual([
+      "k_7f3a9c",
+      "k_2b81de",
+      "k_c04e17",
+    ]);
+    await userEvent.click(
+      within(table).getByRole("button", { name: /Requests/ }),
+    );
+    await expect(idsOf(table).slice(-1)).toEqual(["k_7f3a9c"]);
+  },
+};
+
+export const LeastRecentlyUsedFirst: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  play: async ({ canvas, userEvent }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await userEvent.click(
+      within(table).getByRole("button", { name: /Last used/ }),
+    );
+    await expect(
+      within(table).getByRole("columnheader", { name: /Last used/ }),
+    ).toHaveAttribute("aria-sort", "ascending");
+    await expect(idsOf(table).slice(0, 3)).toEqual([
+      "k_3d7f60",
+      "k_6e09b3",
+      "k_d95e41",
+    ]);
+    await expect(idsOf(table).slice(-1)).toEqual(["k_7f3a9c"]);
+  },
+};
+
+export const ARequestLogYoungerThanTheWeek: Story = {
+  ...screenOf({ status: "read", answer: youngLog }),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(
+        /The request log begins on .*, so they may count/,
+      ),
+    ).toBeVisible();
+  },
+};
+
+export const NoKeys: Story = {
+  ...screenOf({ status: "read", answer: noKeys }),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub has no hub keys."),
+    ).toBeVisible();
+    await expect(canvas.getByText("The hub has no hub keys")).toBeVisible();
+  },
+};
+
+export const NoKeyOfTheScope: Story = {
+  ...screenOf(
+    {
+      status: "read",
+      answer: {
+        ...keysRead,
+        keys: keysRead.keys.filter((key) => key.scope !== "reader"),
+      },
+    },
+    { ...defaultChoice, scope: "reader" },
+  ),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub has no reader hub keys."),
+    ).toBeVisible();
+  },
+};
+
+export const WhileANewerAnswerIsRead: Story = {
+  ...screenOf({ status: "read", answer: keysRead, stale: true }),
+  parameters: staleContrast,
+};
+
+export const Loading: Story = screenOf({ status: "loading" });
+
+export const Failed: Story = {
+  ...screenOf({
+    status: "failed",
+    error: new Error("down"),
+    onRetry: fn(),
+  }),
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub could not read the hub keys."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByRole("button", { name: "Try again" }),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  ...screenOf({ status: "read", answer: keysRead }),
+  globals: { viewport: { value: "mobile2" } },
+  play: async ({ canvas }) => {
+    const table = await canvas.findByRole("table", { name: "Hub keys" });
+    await expect(
+      within(table).getAllByText(/ · 4,120 requests · 182.4M tokens$/)[0],
+    ).toBeVisible();
+  },
+};
