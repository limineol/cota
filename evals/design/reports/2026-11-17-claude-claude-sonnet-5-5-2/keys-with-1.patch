index 0000000..deef6c3
--- /dev/null
+++ b/apps/web/src/screens/keys/rows.tsx
@@ -0,0 +1,228 @@
+import { Badge } from "@cota/ui/components/badge";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Skeleton } from "@cota/ui/components/skeleton";
+import {
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableMagnitude,
+  TableRow,
+  TableSecondary,
+  TableSort,
+} from "@cota/ui/components/table";
+import type { ReactNode } from "react";
+import type { Hue } from "#shared/domain/hues.ts";
+import { ago, tokens } from "#shared/domain/quantities.ts";
+import { useNameOf } from "#shared/names.tsx";
+import { counted, plural, when } from "#shared/words.ts";
+import type { HubKey, Scope } from "./answer.ts";
+import type { Order, SortBy } from "./arrange.ts";
+
+export const scopeName: Record<Scope, string> = {
+  subscription: "Subscription",
+  keyed: "Keyed",
+  reader: "Reader",
+};
+
+const marksShown = 4;
+
+const sortable: ReadonlyArray<{
+  readonly by: SortBy;
+  readonly label: string;
+}> = [
+  { by: "used", label: "Last used" },
+  { by: "requests", label: "Requests" },
+];
+
+/** The table's head; the two figures the list can be ordered by are buttons that order it. */
+export function KeysHead({
+  order,
+  onSort,
+}: {
+  readonly order: Order;
+  readonly onSort: (by: SortBy) => void;
+}) {
+  const sortHead = (by: SortBy, from: "md" | "lg") => {
+    const column = sortable.find((each) => each.by === by);
+    const sorted = order.by === by ? order.direction : undefined;
+    return (
+      <TableHead scope="col" numeric from={from} sorted={sorted}>
+        <TableSort numeric sorted={sorted} onClick={() => onSort(by)}>
+          {column?.label}
+        </TableSort>
+      </TableHead>
+    );
+  };
+  return (
+    <TableHeader from="md">
+      <TableRow>
+        <TableHead scope="col">Key</TableHead>
+        <TableHead scope="col" from="lg">
+          Opens
+        </TableHead>
+        {sortHead("used", "md")}
+        <TableHead scope="col" from="lg">
+          Machine
+        </TableHead>
+        {sortHead("requests", "md")}
+        <TableHead scope="col" numeric from="lg">
+          Tokens
+        </TableHead>
+      </TableRow>
+    </TableHeader>
+  );
+}
+
+/** Tokens of the requests that reported usage: none to count with no requests, and unreported when none of them did. */
+const tokensText = (key: HubKey) => {
+  if (key.requests === 0) return "none";
+  return key.tokens === null ? "unreported" : tokens(key.tokens);
+};
+
+function Opens({
+  pools,
+  scope,
+  hues,
+}: {
+  readonly pools: ReadonlyArray<string>;
+  readonly scope: Scope;
+  readonly hues: ReadonlyMap<string, Hue>;
+}) {
+  const nameOf = useNameOf();
+  if (scope === "reader") {
+    return (
+      <>
+        <TableLabel>No pool</TableLabel>
+        <TableSecondary>Reads the request log</TableSecondary>
+      </>
+    );
+  }
+  const names = pools.map((pool) => nameOf("pool", pool)).join(", ");
+  return (
+    <>
+      <span className="flex items-center gap-1.5">
+        {pools.slice(0, marksShown).map((pool) => (
+          <PoolMark
+            key={pool}
+            hue={hues.get(pool) ?? "neutral"}
+            name={nameOf("pool", pool)}
+          />
+        ))}
+        <TableLabel title={names}>{plural(pools.length, "pool")}</TableLabel>
+      </span>
+      <TableSecondary title={names}>{names}</TableSecondary>
+    </>
+  );
+}
+
+export function KeyItem({
+  hubKey,
+  now,
+  peak,
+  hues,
+}: {
+  readonly hubKey: HubKey;
+  readonly now: number;
+  readonly peak: number;
+  readonly hues: ReadonlyMap<string, Hue>;
+}) {
+  const nameOf = useNameOf();
+  const { pools } = hubKey;
+  const used =
+    hubKey.lastUsedAt === null ? null : Date.parse(hubKey.lastUsedAt);
+  const lastUsed: ReactNode =
+    used === null ? (
+      "Never used"
+    ) : (
+      <span title={when(used, now)}>{ago(now - used)}</span>
+    );
+  const machine =
+    hubKey.lastMachine === null ? null : nameOf("machine", hubKey.lastMachine);
+  return (
+    <TableBody>
+      <TableRow>
+        <TableCell className="w-full max-w-0">
+          <span className="flex min-w-0 items-center gap-2">
+            <TableLabel title={hubKey.id}>
+              {hubKey.note ?? hubKey.id}
+            </TableLabel>
+            <Badge>{scopeName[hubKey.scope]}</Badge>
+          </span>
+          <TableSecondary>
+            {hubKey.note === null ? "No note" : hubKey.id}
+          </TableSecondary>
+          <TableSecondary className="@2xl/panel:hidden">
+            {lastUsed}
+            {machine === null ? null : ` · ${machine}`}
+            {` · ${plural(hubKey.requests, "request")} · ${tokensText(hubKey)} tokens`}
+          </TableSecondary>
+          <TableSecondary className="hidden @2xl/panel:block @4xl/panel:hidden">
+            {hubKey.scope === "reader"
+              ? "No pool"
+              : pools.map((pool) => nameOf("pool", pool)).join(", ")}
+            {machine === null ? null : ` · ${machine}`}
+            {` · ${tokensText(hubKey)} tokens`}
+          </TableSecondary>
+        </TableCell>
+        <TableCell from="lg" className="max-w-56">
+          <Opens pools={hubKey.pools} scope={hubKey.scope} hues={hues} />
+        </TableCell>
+        <TableCell numeric from="md">
+          {lastUsed}
+        </TableCell>
+        <TableCell from="lg" className="max-w-40">
+          {machine === null ? (
+            <TableSecondary className="mt-0">None</TableSecondary>
+          ) : (
+            <TableLabel title={hubKey.lastMachine ?? undefined}>
+              {machine}
+            </TableLabel>
+          )}
+        </TableCell>
+        <TableCell numeric from="md">
+          {counted(hubKey.requests)}
+          <TableMagnitude fraction={hubKey.requests / peak} />
+        </TableCell>
+        <TableCell numeric from="lg">
+          {tokensText(hubKey)}
+        </TableCell>
+      </TableRow>
+    </TableBody>
+  );
+}
+
+const placeholders: ReadonlyArray<{
+  readonly from: "md" | "lg";
+  readonly numeric: boolean;
+}> = [
+  { from: "md", numeric: true },
+  { from: "lg", numeric: false },
+  { from: "md", numeric: true },
+  { from: "lg", numeric: true },
+];
+
+/** A row held while the keys are read, shaped like one. */
+export function KeySkeleton() {
+  return (
+    <TableBody aria-hidden="true">
+      <TableRow>
+        <TableCell className="w-full max-w-0">
+          <Skeleton className="h-3.5 w-2/5" />
+          <Skeleton className="mt-2 w-1/4" />
+        </TableCell>
+        <TableCell from="lg">
+          <Skeleton className="w-24" />
+          <Skeleton className="mt-2 w-32" />
+        </TableCell>
+        {placeholders.map(({ from, numeric }, index) => (
+          // biome-ignore lint/suspicious/noArrayIndexKey: placeholders have nothing else to tell them apart
+          <TableCell key={index} numeric={numeric} from={from}>
+            <Skeleton className={numeric ? "ml-auto w-12" : "w-20"} />
+          </TableCell>
+        ))}
+      </TableRow>
+    </TableBody>
+  );
+}
