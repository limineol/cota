+import { Button } from "@cota/ui/components/button";
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import { FilterMenu, FilterMenuItem } from "@cota/ui/components/filter-menu";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFilters,
+  ListPanelFoot,
+  ListPanelHead,
+} from "@cota/ui/components/list-panel";
+import { Note } from "@cota/ui/components/note";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+} from "@cota/ui/components/page";
+import { Skeleton } from "@cota/ui/components/skeleton";
+import { Table } from "@cota/ui/components/table";
+import { X } from "lucide-react";
+import { useMemo } from "react";
+import { poolHues } from "#shared/domain/hues.ts";
+import { NowProvider, useNow } from "#shared/now.tsx";
+import { Problem } from "#shared/problem.tsx";
+import { counted, plural } from "#shared/words.ts";
+import { type KeysAnswer, type Scope, scopes } from "./answer.ts";
+import {
+  type Choice,
+  defaultChoice,
+  logCoversTheWeek,
+  narrowed,
+  neverUsed,
+  ordered,
+  reordered,
+  type SortBy,
+} from "./arrange.ts";
+import { KeyItem, KeySkeleton, KeysHead, scopeName } from "./rows.tsx";
+
+/** What the screen has of the hub's answer: still being read, failed, or read. */
+export type KeysRead =
+  | { readonly status: "loading" }
+  | {
+      readonly status: "failed";
+      readonly error: unknown;
+      readonly onRetry: () => void;
+    }
+  | {
+      readonly status: "read";
+      readonly answer: KeysAnswer;
+      /** True while a newer answer is on its way. */
+      readonly stale?: boolean;
+    };
+
+const skeletonRows = 6;
+
+const day = new Intl.DateTimeFormat("en-US", {
+  year: "numeric",
+  month: "short",
+  day: "numeric",
+  timeZone: "UTC",
+});
+
+export function Keys({
+  read,
+  choice = defaultChoice,
+  onChoice,
+}: {
+  readonly read: KeysRead;
+  readonly choice?: Choice;
+  readonly onChoice: (choice: Choice) => void;
+}) {
+  return (
+    <NowProvider>
+      <KeysPage read={read} choice={choice} onChoice={onChoice} />
+    </NowProvider>
+  );
+}
+
+function KeysPage({
+  read,
+  choice,
+  onChoice,
+}: {
+  readonly read: KeysRead;
+  readonly choice: Choice;
+  readonly onChoice: (choice: Choice) => void;
+}) {
+  const now = useNow();
+  const answer = read.status === "read" ? read.answer : undefined;
+  const hues = useMemo(() => poolHues(answer?.pools ?? []), [answer]);
+
+  const shown = useMemo(
+    () =>
+      answer === undefined
+        ? undefined
+        : ordered(narrowed(answer.keys, choice.scope), choice.order),
+    [answer, choice],
+  );
+  const peak = Math.max(1, ...(shown ?? []).map((key) => key.requests));
+  const countOf = (scope: Scope) =>
+    answer?.keys.filter((key) => key.scope === scope).length ?? 0;
+  const largest = Math.max(1, ...scopes.map(countOf));
+
+  const chooseScope = (scope: Scope | null) => onChoice({ ...choice, scope });
+  const sortBy = (by: SortBy) =>
+    onChoice({ ...choice, order: reordered(choice.order, by) });
+
+  const description = () => {
+    if (answer === undefined) {
+      return read.status === "failed" ? (
+        "Hub keys"
+      ) : (
+        <Skeleton className="inline-block w-64 align-middle" />
+      );
+    }
+    if (answer.keys.length === 0) return "The hub has no hub keys";
+    const idle = neverUsed(answer.keys);
+    return `${plural(answer.keys.length, "hub key")}, ${idle === 0 ? "every one used" : `${counted(idle)} never used`}`;
+  };
+
+  const body = () => {
+    if (read.status === "failed") {
+      return (
+        <Problem
+          inside
+          title="The hub could not read the hub keys."
+          error={read.error}
+          onRetry={read.onRetry}
+        />
+      );
+    }
+    if (shown === undefined) {
+      return (
+        <Table aria-label="Hub keys loading">
+          <KeysHead order={choice.order} onSort={sortBy} />
+          {Array.from({ length: skeletonRows }, (_, index) => (
+            // biome-ignore lint/suspicious/noArrayIndexKey: placeholders have nothing else to tell them apart
+            <KeySkeleton key={index} />
+          ))}
+        </Table>
+      );
+    }
+    if (answer?.keys.length === 0) {
+      return (
+        <Empty>
+          <EmptyTitle>The hub has no hub keys.</EmptyTitle>
+          <EmptyDescription>
+            Hub keys are in the hub's configuration. Add one there and restart
+            the hub, then a machine can send its clients through it.
+          </EmptyDescription>
+        </Empty>
+      );
+    }
+    if (shown.length === 0) {
+      return (
+        <Empty>
+          <EmptyTitle>
+            The hub has no {choice.scope === null ? "" : `${choice.scope} `}hub
+            keys.
+          </EmptyTitle>
+          <EmptyDescription>Choose another scope.</EmptyDescription>
+        </Empty>
+      );
+    }
+    return (
+      <Table aria-label="Hub keys">
+        <KeysHead order={choice.order} onSort={sortBy} />
+        {shown.map((hubKey) => (
+          <KeyItem
+            key={hubKey.id}
+            hubKey={hubKey}
+            now={now}
+            peak={peak}
+            hues={hues}
+          />
+        ))}
+      </Table>
+    );
+  };
+
+  return (
+    <Page className="@container">
+      <PageHeader>
+        <div>
+          <PageTitle>Hub keys</PageTitle>
+          <PageDescription>{description()}</PageDescription>
+        </div>
+      </PageHeader>
+
+      <ListPanel aria-label="The hub keys">
+        <ListPanelHead>
+          <ListPanelFilters
+            end={
+              choice.scope === null ? null : (
+                <Button
+                  variant="ghost"
+                  size="sm"
+                  onClick={() => chooseScope(null)}
+                >
+                  Reset <X aria-hidden="true" />
+                </Button>
+              )
+            }
+          >
+            <FilterMenu
+              label="Scope"
+              chosen={choice.scope === null ? [] : [scopeName[choice.scope]]}
+              note="Counted in hub keys"
+            >
+              {scopes.map((scope) => (
+                <FilterMenuItem
+                  key={scope}
+                  checked={choice.scope === scope}
+                  onCheckedChange={(on) => chooseScope(on ? scope : null)}
+                  count={answer === undefined ? undefined : countOf(scope)}
+                  {...(answer === undefined
+                    ? {}
+                    : { fraction: countOf(scope) / largest })}
+                >
+                  {scopeName[scope]}
+                </FilterMenuItem>
+              ))}
+            </FilterMenu>
+          </ListPanelFilters>
+        </ListPanelHead>
+
+        <ListPanelBody stale={read.status === "read" && read.stale === true}>
+          {body()}
+        </ListPanelBody>
+
+        {answer !== undefined && shown !== undefined && shown.length > 0 ? (
+          <ListPanelFoot>
+            <span>{plural(shown.length, "hub key")}</span>
+            <Note>
+              Requests and tokens are of the last 7 days.
+              {logCoversTheWeek(answer.logBegins, now)
+                ? ""
+                : ` The request log begins on ${day.format(Date.parse(answer.logBegins))}, so they may count from later.`}
+            </Note>
+          </ListPanelFoot>
+        ) : null}
+      </ListPanel>
+    </Page>
+  );
+}
diff --git a/apps/web/src/screens/keys/rows.tsx b/apps/web/src/screens/keys/rows.tsx
