+import type { HubKey, KeysAnswer } from "#screens/keys/answer.ts";
+import { now } from "./overview.ts";
+
+const minute = 60_000;
+const hour = 60 * minute;
+const day = 24 * hour;
+
+const iso = (moment: number) => new Date(moment).toISOString();
+
+const ago = (milliseconds: number) => iso(now - milliseconds);
+
+const key = (
+  id: string,
+  shape: Omit<HubKey, "id" | "lastUsedAt"> & {
+    readonly usedAgo: number | null;
+  },
+): HubKey => {
+  const { usedAgo, ...rest } = shape;
+  return {
+    id,
+    ...rest,
+    lastUsedAt: usedAgo === null ? null : ago(usedAgo),
+  };
+};
+
+/** The pools of the configuration the keys open, in its order. */
+const pools = ["personal", "work", "codex", "zai", "local"];
+
+/** A dozen hub keys of the three scopes, three of them never used. */
+export const twelveKeys: ReadonlyArray<HubKey> = [
+  key("k_7f3a9c", {
+    note: "work laptop",
+    scope: "subscription",
+    pools: ["personal", "work"],
+    usedAgo: 3 * minute,
+    lastMachine: "tower",
+    requests: 4120,
+    tokens: 182_400_000,
+  }),
+  key("k_2b81de", {
+    note: "desktop",
+    scope: "subscription",
+    pools: ["personal", "codex"],
+    usedAgo: 41 * minute,
+    lastMachine: "atlas",
+    requests: 1385,
+    tokens: 61_900_000,
+  }),
+  key("k_c04e17", {
+    note: "build server",
+    scope: "keyed",
+    pools: ["zai"],
+    usedAgo: 2 * hour + 14 * minute,
+    lastMachine: "ci-runner",
+    requests: 902,
+    tokens: 28_300_000,
+  }),
+  key("k_91d5a2", {
+    note: "old laptop",
+    scope: "subscription",
+    pools: ["personal"],
+    usedAgo: 4 * day + 3 * hour,
+    lastMachine: "pavilion",
+    requests: 12,
+    tokens: 410_000,
+  }),
+  key("k_e6a30b", {
+    note: "reading agent",
+    scope: "reader",
+    pools: [],
+    usedAgo: 26 * minute,
+    lastMachine: null,
+    requests: 233,
+    tokens: null,
+  }),
+  key("k_58bc94", {
+    note: null,
+    scope: "keyed",
+    pools: ["zai", "local"],
+    usedAgo: 1 * day + 5 * hour,
+    lastMachine: "ci-runner",
+    requests: 148,
+    tokens: 3_950_000,
+  }),
+  key("k_3d7f60", {
+    note: "spare phone",
+    scope: "subscription",
+    pools: ["work"],
+    usedAgo: null,
+    lastMachine: null,
+    requests: 0,
+    tokens: null,
+  }),
+  key("k_a1c2f8", {
+    note: "dashboard bot",
+    scope: "reader",
+    pools: [],
+    usedAgo: 6 * day + 22 * hour,
+    lastMachine: null,
+    requests: 9,
+    tokens: null,
+  }),
+  key("k_6e09b3", {
+    note: "garage mini",
+    scope: "keyed",
+    pools: ["local"],
+    usedAgo: null,
+    lastMachine: null,
+    requests: 0,
+    tokens: null,
+  }),
+  key("k_f48a15", {
+    note: "friend's visit",
+    scope: "subscription",
+    pools: ["codex"],
+    usedAgo: 12 * day,
+    lastMachine: "guest-air",
+    requests: 0,
+    tokens: null,
+  }),
+  key("k_0b72cd", {
+    note: "pairing session",
+    scope: "subscription",
+    pools: ["personal", "work", "codex", "zai", "local"],
+    usedAgo: 2 * day + 9 * hour,
+    lastMachine: "tower",
+    requests: 57,
+    tokens: null,
+  }),
+  key("k_d95e41", {
+    note: null,
+    scope: "reader",
+    pools: [],
+    usedAgo: null,
+    lastMachine: null,
+    requests: 0,
+    tokens: null,
+  }),
+];
+
+const dayOf = (moment: number) => iso(moment).slice(0, 10);
+
+const answerOf = (keys: ReadonlyArray<HubKey>, logBegins: number) =>
+  ({ keys, pools, logBegins: dayOf(logBegins) }) satisfies KeysAnswer;
+
+/** A request log that holds the whole of the last 7 days. */
+export const keysRead: KeysAnswer = answerOf(twelveKeys, now - 40 * day);
+
+/** A request log that began three days ago, so the 7 days begin before it. */
+export const youngLog: KeysAnswer = answerOf(twelveKeys, now - 3 * day);
+
+/** A hub whose configuration holds no hub keys. */
+export const noKeys: KeysAnswer = answerOf([], now - 40 * day);
