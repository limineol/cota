+const hour = 3_600_000;
+const day = 24 * hour;
+
+const pools = ["personal", "work", "zai", "tower"];
+
+const dayKey = (daysAgo: number) =>
+  new Date(Date.now() - daysAgo * day).toISOString().slice(0, 10);
+
+/** The days of a range, oldest first, from a figure for each. */
+const daysOf = (
+  count: number,
+  of: (index: number) => Omit<PoolDay, "day">,
+): ReadonlyArray<PoolDay> =>
+  Array.from({ length: count }, (_, index) => ({
+    day: dayKey(count - 1 - index),
+    ...of(index),
+  }));
+
+const wave = (index: number, base: number, swing: number) =>
+  Math.round(base + swing * Math.abs(Math.sin(index * 1.7)));
+
+/** A Claude subscription with a 5-hour window and a weekly one, five models and a week of traffic, the range before it covered. */
+export const claudeSubscription: PoolSummary = {
