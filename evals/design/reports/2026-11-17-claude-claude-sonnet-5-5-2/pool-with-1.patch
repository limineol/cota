+import { share, span } from "#shared/domain/quantities.ts";
+import type { PoolRange, PoolWindow } from "./summary.ts";
+
+const hour = 3_600_000;
+const day = 24 * hour;
+
+const named: Record<number, string> = {
+  [5 * hour]: "5-hour",
+  [day]: "Daily",
+  [7 * day]: "Weekly",
+  [28 * day]: "Monthly",
+  [30 * day]: "Monthly",
+  [31 * day]: "Monthly",
+};
+
+/** A window's name for people, from its length and scope: `5-hour`, `Weekly · Opus`. */
+export const windowName = (window: PoolWindow) => {
+  const base =
+    named[window.lengthMs] ??
+    (window.lengthMs < day
+      ? `${Math.round(window.lengthMs / hour)}-hour`
+      : `${Math.round(window.lengthMs / day)}-day`);
+  return window.scope === null ? base : `${base} · ${window.scope}`;
+};
+
+export const usedText = (window: PoolWindow) =>
+  `${share(window.usedPercent / 100)} used`;
+
+export type Tone = "ok" | "warn" | "danger";
+
+/** A window's pace in words, as the hub decided it, and the tone it is drawn in. */
+export const paceOf = (
+  window: PoolWindow,
+): { readonly text: string; readonly tone: Tone } | null => {
+  const standing = window.standing;
+  if (standing === null) return null;
+  const points = Math.round(standing.points ?? 0);
+  switch (standing.pace) {
+    case "full":
+      return { text: "Full until the reset", tone: "danger" };
+    case "on-pace":
+      return { text: "On pace", tone: "ok" };
+    case "in-reserve":
+      return { text: `${points}% in reserve`, tone: "ok" };
+    case "ahead-of-pace": {
+      const tone = window.usedPercent >= 80 ? "danger" : "warn";
+      return {
+        text:
+          standing.emptiesInMs === null
+            ? `${points}% ahead of pace`
+            : `${points}% ahead of pace · empties in ${span(standing.emptiesInMs)}`,
+        tone,
+      };
+    }
+  }
+};
+
+export const rangeOptions = [
+  { value: "1d", label: "1d" },
+  { value: "7d", label: "7d" },
+  { value: "30d", label: "30d" },
+] as const satisfies ReadonlyArray<{ value: PoolRange; label: string }>;
+
+export const rangeDays: Record<PoolRange, number> = {
+  "1d": 1,
+  "7d": 7,
+  "30d": 30,
+};
+
+/** What the range covers, as it ends "… in the last 7 days". */
+export const during: Record<PoolRange, string> = {
+  "1d": "in the last day",
+  "7d": "in the last 7 days",
+  "30d": "in the last 30 days",
+};
+
+/** The range before, as it ends "compared with …". */
+export const before: Record<PoolRange, string> = {
+  "1d": "the day before",
+  "7d": "the 7 days before",
+  "30d": "the 30 days before",
+};
+
+/** An ISO date as a moment of that day in the viewer's zone, so that its day is the one written. */
+export const startOfDay = (isoDate: string) => {
+  const [year = 0, month = 1, date = 1] = isoDate.split("-").map(Number);
+  return new Date(year, month - 1, date).getTime();
+};
+
+export const startOfNextDay = (isoDate: string) => {
+  const [year = 0, month = 1, date = 1] = isoDate.split("-").map(Number);
+  return new Date(year, month - 1, date + 1).getTime();
+};
+
+export const kindName = {
+  subscription: "Subscription",
+  keyed: "Keyed",
+} as const;
