+    },
+    {
+      model: "claude-3-5-haiku",
+      requests: 30,
+      tokens: 500_000,
+      cost: 0.2,
+    },
+  ],
+  days: daysOf(7, (index) => ({
+    requests: wave(index, 400, 400),
+    tokens: wave(index, 60_000_000, 60_000_000),
+    promptSize: index === 2 ? null : wave(index, 90_000, 110_000),
+  })),
+};
+
+/** A subscription whose windows the hub has not read. */
+export const unreadWindows: PoolSummary = {
+  ...claudeSubscription,
+  pool: { id: "work", kind: "subscription", provider: "chatgpt", plan: null },
+  windows: [],
+  totals: {
+    requests: 96,
+    tokens: 14_800_000,
