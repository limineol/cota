+        pace: "in-reserve",
+        points: 23,
+        emptiesInMs: null,
+      },
+    },
+  ],
+  range: "7d",
+  logBegins: dayKey(120),
+  totals: {
+    requests: 4_218,
+    tokens: 612_400_000,
+    cost: 318.42,
+    unpricedRequests: 0,
+    previous: { requests: 3_380, tokens: 540_100_000, cost: 402.1 },
+  },
+  models: [
+    {
+      model: "claude-opus-4-5",
+      requests: 1_204,
+      tokens: 301_000_000,
+      cost: 201.3,
+    },
+    {
+      model: "claude-sonnet-4-5",
+      requests: 2_011,
+      tokens: 244_800_000,
+      cost: 96.02,
+    },
+    {
+      model: "claude-haiku-4-5",
+      requests: 842,
