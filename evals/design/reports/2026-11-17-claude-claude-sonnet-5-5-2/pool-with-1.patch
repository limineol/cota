+    previous: { requests: 40, tokens: 5_100_000, cost: 3.2 },
+  },
+  models: [{ model: "gpt-5", requests: 96, tokens: 14_800_000, cost: 9.1 }],
+  days: daysOf(7, (index) => ({
+    requests: index === 6 ? 96 : 0,
+    tokens: index === 6 ? 14_800_000 : 0,
+    promptSize: index === 6 ? 71_000 : null,
+  })),
+};
+
+/** A keyed pool, with requests to a model that has no price and a log that began inside the range. */
+export const unpricedModel: PoolSummary = {
