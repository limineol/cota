index 0000000..b0889ea
--- /dev/null
+++ b/apps/web/src/screens/pool/context.tsx
@@ -0,0 +1,96 @@
+import {
+  type BlockColumn,
+  BlockColumns,
+  type ColumnsLayout,
+} from "@cota/ui/components/block-columns";
+import { type Bucket, stack } from "#shared/domain/columns.ts";
+import type { Hue } from "#shared/domain/hues.ts";
+import { tokens } from "#shared/domain/quantities.ts";
+import { dayOf } from "#shared/words.ts";
+import type { PoolDay } from "./summary.ts";
+import { startOfDay, startOfNextDay } from "./words.ts";
+
+const bucketsOf = (days: ReadonlyArray<PoolDay>): ReadonlyArray<Bucket> =>
+  days.map((day) => ({
+    start: startOfDay(day.day),
+    end: startOfNextDay(day.day),
+    parts: [day.promptSize ?? 0],
+  }));
+
+/** Adjacent days in runs of one length so that at most `capacity` columns remain; a run keeps its largest prompt, since a context is a level and never a sum. */
+const fitted = (
+  buckets: ReadonlyArray<Bucket>,
+  capacity: number,
+): ReadonlyArray<Bucket> => {
+  const run = Math.ceil(buckets.length / Math.max(1, capacity));
+  if (run <= 1) return buckets;
+  const runs: Array<Bucket> = [];
+  for (let index = 0; index < buckets.length; index += run) {
+    const group = buckets.slice(index, index + run);
+    const first = group[0];
+    const last = group.at(-1);
+    if (first === undefined || last === undefined) continue;
+    runs.push({
+      start: first.start,
+      end: last.end,
+      parts: [Math.max(...group.map((bucket) => bucket.parts[0] ?? 0))],
+    });
+  }
+  return runs;
+};
+
+/** The largest prompt size of any day of the range, or null when no request reported one. */
+export const largestPrompt = (days: ReadonlyArray<PoolDay>): number | null => {
+  const sizes = days.flatMap((day) =>
+    day.promptSize === null ? [] : [day.promptSize],
+  );
+  return sizes.length === 0 ? null : Math.max(...sizes);
+};
+
+const dayLength = 24 * 3_600_000;
+
+/** One column a day, as tall as the largest prompt that day's requests sent. */
+export function ContextByDay({
+  days,
+  hue,
+  poolName,
+}: {
+  readonly days: ReadonlyArray<PoolDay>;
+  readonly hue: Hue;
+  readonly poolName: string;
+}) {
+  const buckets = bucketsOf(days);
+  const fit = (capacity: number): ColumnsLayout => {
+    const { unit, columns } = stack(fitted(buckets, capacity), 1);
+    return {
+      unit: `${tokens(unit)} tokens of prompt`,
+      columns: columns.map((column): BlockColumn => {
+        const { start, end } = column.bucket;
+        const peak = column.bucket.parts[0] ?? 0;
+        return {
+          key: String(start),
+          label:
+            end - start > dayLength * 1.5
+              ? `${dayOf(start)} – ${dayOf(end - 1)}`
+              : dayOf(start),
+          tick: dayOf(start),
+          total: peak > 0 ? tokens(peak) : "none reported",
+          parts: [
+            {
+              blocks: column.parts[0] ?? 0,
+              value: peak > 0 ? tokens(peak) : null,
+            },
+          ],
+        };
+      }),
+    };
+  };
+  return (
+    <BlockColumns
+      series={[{ key: "prompt", label: "Largest prompt", tint: hue }]}
+      fit={fit}
+      label={`Largest prompt size by day, ${poolName}`}
+      empty="No request of this range reported a prompt size."
+    />
+  );
+}
diff --git a/apps/web/src/screens/pool/models.tsx b/apps/web/src/screens/pool/models.tsx
