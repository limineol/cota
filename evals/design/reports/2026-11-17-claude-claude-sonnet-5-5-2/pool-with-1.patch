@@ -0,0 +1,125 @@
+import { BlockMeter } from "@cota/ui/components/block-meter";
+import { Card } from "@cota/ui/components/card";
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  Pace,
+  QuotaWindow,
+  QuotaWindowFoot,
+  QuotaWindowHead,
+  QuotaWindowLabel,
+  QuotaWindowReset,
+  QuotaWindowUsed,
+} from "@cota/ui/components/quota-window";
+import type { Hue } from "#shared/domain/hues.ts";
+import { meter } from "#shared/domain/meter.ts";
+import { span } from "#shared/domain/quantities.ts";
+import { Name } from "#shared/names.tsx";
+import { dayOf, timeOf } from "#shared/words.ts";
+import type { PoolSummary, PoolWindow } from "./summary.ts";
+import { paceOf, usedText, windowName } from "./words.ts";
+
+function WindowLine({
+  window,
+  pool,
+  hue,
+}: {
+  readonly window: PoolWindow;
+  readonly pool: string;
+  readonly hue: Hue;
+}) {
+  const name = windowName(window);
+  const pace = paceOf(window);
+  const used = usedText(window);
+  const {
+    blocks,
+    severity,
+    pace: marker,
+  } = meter({
+    usedPercent: window.usedPercent,
+    elapsed: window.standing?.elapsed ?? null,
+  });
+  const resetsAt =
+    window.resetsAt === null ? null : Date.parse(window.resetsAt);
+  const resetsIn = window.standing?.resetsInMs;
+  return (
+    <QuotaWindow size="detail">
+      <QuotaWindowHead>
+        <QuotaWindowLabel>{name}</QuotaWindowLabel>
+        <QuotaWindowUsed>{used}</QuotaWindowUsed>
+        <QuotaWindowReset>
+          {resetsIn === undefined
+            ? "Not started"
+            : `Resets in ${span(resetsIn)}`}
+        </QuotaWindowReset>
+      </QuotaWindowHead>
+      <BlockMeter
+        blocks={blocks}
+        pace={marker}
+        severity={severity}
+        hue={hue}
+        size="detail"
+        label={`${pool}, ${name} window`}
+        valueText={pace === null ? used : `${used}, ${pace.text}`}
+      />
+      {pace !== null || resetsAt !== null ? (
+        <QuotaWindowFoot>
+          {pace === null ? null : <Pace tone={pace.tone}>{pace.text}</Pace>}
+          {resetsAt === null ? null : (
+            <span>
+              Resets {dayOf(resetsAt)} {timeOf(resetsAt)}
+            </span>
+          )}
+        </QuotaWindowFoot>
+      ) : null}
+    </QuotaWindow>
+  );
+}
+
+/** Why a pool shows no windows: a keyed pool has none to read, a subscription's the hub has not read. */
+const noWindows = (kind: PoolSummary["pool"]["kind"]) =>
+  kind === "keyed"
+    ? {
+        title: "A keyed pool has no quota windows.",
+        description:
+          "Its provider bills each request, with no allowance to use up.",
+      }
+    : {
+        title: "The hub has not read this pool's windows.",
+        description:
+          "They appear here once the hub has read them, or once a request reports them.",
+      };
+
+/** The pool's quota windows as the hub last read them, each with its pace. */
+export function Windows({
+  summary,
+  hue,
+}: {
+  readonly summary: PoolSummary;
+  readonly hue: Hue;
+}) {
+  if (summary.windows.length === 0) {
+    const words = noWindows(summary.pool.kind);
+    return (
+      <Empty>
+        <EmptyTitle>{words.title}</EmptyTitle>
+        <EmptyDescription>{words.description}</EmptyDescription>
+      </Empty>
+    );
+  }
+  return (
+    <Card size="compact">
+      <ul
+        aria-label="Quota windows"
+        className="grid gap-x-8 gap-y-6 @3xl:grid-cols-2"
+      >
+        {summary.windows.map((window) => (
+          <li key={`${window.lengthMs}-${window.scope ?? ""}`}>
+            <WindowLine window={window} pool={summary.pool.id} hue={hue} />
+          </li>
+        ))}
+      </ul>
+    </Card>
+  );
+}
+
+export const poolName = (id: string) => <Name kind="pool" value={id} />;
