@@ -0,0 +1,202 @@
+import { Note } from "@cota/ui/components/note";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+  Section,
+  SectionDescription,
+  SectionHeader,
+  SectionTitle,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { Segmented } from "@cota/ui/components/segmented";
+import {
+  Stat,
+  StatDelta,
+  StatLabel,
+  StatNote,
+  StatValue,
+} from "@cota/ui/components/stat";
+import { hues } from "#shared/domain/hues.ts";
+import { delta, tokens } from "#shared/domain/quantities.ts";
+import { Name, useNameOf } from "#shared/names.tsx";
+import { glyphOf } from "#shared/providers.tsx";
+import { costText, counted, dayOf, plural } from "#shared/words.ts";
+import { ContextByDay, largestPrompt } from "./context.tsx";
+import { Models } from "./models.tsx";
+import type { PoolRange, PoolSummary } from "./summary.ts";
+import { Windows } from "./windows.tsx";
+import { before, during, kindName, rangeOptions, startOfDay } from "./words.ts";
+
+type Totals = PoolSummary["totals"];
+
+interface Figure {
+  readonly label: string;
+  readonly value: string;
+  readonly current: number;
+  readonly previous: number | null;
+  readonly note?: string;
+}
+
+const figuresOf = (totals: Totals): ReadonlyArray<Figure> => [
+  {
+    label: "Requests",
+    value: counted(totals.requests),
+    current: totals.requests,
+    previous: totals.previous?.requests ?? null,
+  },
+  {
+    label: "Tokens",
+    value: tokens(totals.tokens),
+    current: totals.tokens,
+    previous: totals.previous?.tokens ?? null,
+  },
+  {
+    label: "Cost",
+    value: costText(totals.cost, totals.unpricedRequests),
+    current: totals.cost,
+    previous: totals.previous?.cost ?? null,
+    note:
+      totals.unpricedRequests > 0
+        ? `${plural(totals.unpricedRequests, "request")} with no price`
+        : "at API list prices",
+  },
+];
+
+/** What the pool's page says of where the log's reach ends the range or the one before it. */
+const coverage = (summary: PoolSummary): string | null => {
+  const first = summary.days[0];
+  if (first !== undefined && first.day < summary.logBegins) {
+    return `The request log begins on ${dayOf(startOfDay(summary.logBegins))}, so this range starts before it and the figures are of what it holds.`;
+  }
+  if (summary.totals.previous === null) {
+    return `The request log begins on ${dayOf(startOfDay(summary.logBegins))}, so it does not cover ${before[summary.range]}.`;
+  }
+  return null;
+};
+
+/** One pool: how its quota windows stand, what it carried over a range against the range before, the models its requests went to, and the largest prompt each day reached. */
+export function PoolView({
+  summary,
+  onRangeChange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onRangeChange: (range: PoolRange) => void;
+}) {
+  const nameOf = useNameOf();
+  const { pool, totals } = summary;
+  const place = summary.pools.indexOf(pool.id);
+  const hue = (place === -1 ? undefined : hues[place]) ?? "neutral";
+  const name = nameOf("pool", pool.id);
+  const largest = largestPrompt(summary.days);
+  const covered = coverage(summary);
+  return (
+    <Page>
+      <PageHeader>
+        <div>
+          <div className="flex items-center gap-3">
+            <PoolMark
+              hue={hue}
+              name={name}
+              glyph={glyphOf(pool.provider)}
+              size="lg"
+            />
+            <PageTitle>
+              <Name kind="pool" value={pool.id} />
+            </PageTitle>
+          </div>
+          <PageDescription>
+            {[kindName[pool.kind], pool.provider, pool.plan]
+              .filter((part) => part !== null)
+              .join(" · ")}
+          </PageDescription>
+        </div>
+        <Segmented
+          label="Range"
+          value={summary.range}
+          options={rangeOptions}
+          onValueChange={onRangeChange}
+        />
+      </PageHeader>
+
+      <Section aria-labelledby="windows-title" className="mt-0 wide:mt-0">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="windows-title">Quota windows</SectionTitle>
+            <SectionDescription>As the hub last read them.</SectionDescription>
+          </div>
+        </SectionHeader>
+        <Windows summary={summary} hue={hue} />
+      </Section>
+
+      <Section aria-labelledby="traffic-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="traffic-title">Traffic</SectionTitle>
+            <SectionDescription>
+              {plural(totals.requests, "request")} {during[summary.range]}
+              {totals.previous === null
+                ? ""
+                : `, compared with ${before[summary.range]}`}
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <div className="grid grid-cols-1 gap-2.5 @3xl:grid-cols-3 sm:grid-cols-3 wide:gap-3">
+          {figuresOf(totals).map((figure) => {
+            const change =
+              figure.previous === null
+                ? null
+                : delta(figure.current, figure.previous);
+            return (
+              <Stat key={figure.label} variant="tile">
+                <StatLabel>{figure.label}</StatLabel>
+                <StatValue>
+                  {figure.value}
+                  {change === null ? null : (
+                    <StatDelta
+                      direction={change.direction}
+                      title={`The ${figure.label.toLowerCase()} of ${before[summary.range]}`}
+                    >
+                      {change.text}
+                    </StatDelta>
+                  )}
+                </StatValue>
+                {figure.note === undefined ? null : (
+                  <StatNote>{figure.note}</StatNote>
+                )}
+              </Stat>
+            );
+          })}
+        </div>
+        {covered === null ? null : <Note className="mt-3">{covered}</Note>}
+      </Section>
+
+      <Section aria-labelledby="models-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="models-title">Models</SectionTitle>
+            <SectionDescription>
+              Where the pool's requests went {during[summary.range]}.
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <Models summary={summary} />
+      </Section>
+
+      <Section aria-labelledby="context-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="context-title">Largest prompt</SectionTitle>
+            <SectionDescription>
+              {largest === null
+                ? "No request reported a prompt size."
+                : `${tokens(largest)} tokens at most, in one request. Each column is the largest prompt one day's requests sent.`}
+            </SectionDescription>
+          </div>
+        </SectionHeader>
+        <ContextByDay days={summary.days} hue={hue} poolName={name} />
+      </Section>
+    </Page>
+  );
+}
diff --git a/apps/web/src/screens/pool/summary.ts b/apps/web/src/screens/pool/summary.ts
new file mode 100644
