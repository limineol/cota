+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, fn, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { withApi } from "#stories/page.tsx";
+import {
+  claudeSubscription,
+  quiet,
+  unpricedModel,
+  unreadWindows,
+} from "#stories/pool.ts";
+import { PoolView } from "./pool.tsx";
+
+const meta = {
+  title: "Screens/Pool",
+  component: PoolView,
+  decorators: [withApi([displayNames])],
+  args: { summary: claudeSubscription, onRangeChange: fn() },
+} satisfies Meta<typeof PoolView>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const ClaudeSubscription: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: "Personal plan" }),
+    ).toBeVisible();
+    const windows = canvas.getByRole("list", { name: "Quota windows" });
+    await expect(within(windows).getAllByRole("meter")).toHaveLength(2);
+    await expect(within(windows).getByText("5-hour")).toBeVisible();
+    await expect(
+      within(windows).getByText("22% ahead of pace · empties in 1h 20m"),
+    ).toBeVisible();
+    await expect(within(windows).getByText("23% in reserve")).toBeVisible();
+    const models = canvas.getByRole("table", { name: "Models" });
+    await expect(within(models).getAllByRole("row")).toHaveLength(6);
+    await expect(canvas.getByText("4,218")).toBeVisible();
+    await expect(canvas.getByText("↑25%")).toBeVisible();
+    await expect(
+      canvas.getByText(/^\d+(\.\d)?[KM] tokens at most, in one request/),
+    ).toBeVisible();
+  },
+};
+
+export const WindowsNotRead: Story = {
+  args: { summary: unreadWindows },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub has not read this pool's windows."),
+    ).toBeVisible();
+    await expect(canvas.queryByRole("meter")).not.toBeInTheDocument();
+  },
+};
+
+export const ModelWithNoPrice: Story = {
+  args: { summary: unpricedModel },
+  play: async ({ canvas }) => {
+    const models = await canvas.findByRole("table", { name: "Models" });
+    const row = within(models).getByRole("row", { name: /glm-experimental/ });
+    await expect(within(row).getByText("no price")).toBeVisible();
+    await expect(canvas.getByText("≥$4.80")).toBeVisible();
+    await expect(canvas.getByText("141 requests with no price")).toBeVisible();
+    await expect(canvas.getByText(/^The request log begins on/)).toBeVisible();
+  },
+};
+
+export const NothingCarried: Story = {
+  args: { summary: quiet },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("No request went to this pool in the last day."),
+    ).toBeVisible();
+    await expect(
+      canvas.getByText("No request reported a prompt size."),
+    ).toBeVisible();
+  },
+};
+
+export const Narrow: Story = {
+  globals: { viewport: { value: "mobile2" } },
+};
diff --git a/apps/web/src/screens/pool/pool.tsx b/apps/web/src/screens/pool/pool.tsx
new file mode 100644
index 0000000..e8817cf
--- /dev/null
