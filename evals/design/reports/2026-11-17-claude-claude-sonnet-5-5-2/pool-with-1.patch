@@ -0,0 +1,96 @@
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  ListPanel,
+  ListPanelBody,
+  ListPanelFoot,
+} from "@cota/ui/components/list-panel";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableLabel,
+  TableMagnitude,
+  TableRow,
+  TableSecondary,
+} from "@cota/ui/components/table";
+import { cost, share, tokens } from "#shared/domain/quantities.ts";
+import { Name } from "#shared/names.tsx";
+import { counted, plural } from "#shared/words.ts";
+import type { PoolSummary } from "./summary.ts";
+import { during } from "./words.ts";
+
+/** The models the pool's requests went to, each with its share of the tokens; a model with no price says so, never `$0`. */
+export function Models({ summary }: { readonly summary: PoolSummary }) {
+  const { models } = summary;
+  if (models.length === 0) {
+    return (
+      <Empty>
+        <EmptyTitle>
+          No request went to this pool {during[summary.range]}.
+        </EmptyTitle>
+        <EmptyDescription>
+          The models its requests go to are listed here.
+        </EmptyDescription>
+      </Empty>
+    );
+  }
+  const total = models.reduce((sum, model) => sum + model.tokens, 0);
+  const largest = Math.max(1, ...models.map((model) => model.tokens));
+  const unpriced = models.filter((model) => model.cost === null);
+  return (
+    <ListPanel aria-label="Models of this pool">
+      <ListPanelBody>
+        <Table aria-label="Models">
+          <TableHeader>
+            <TableRow>
+              <TableHead>Model</TableHead>
+              <TableHead numeric from="sm">
+                Requests
+              </TableHead>
+              <TableHead numeric>Tokens</TableHead>
+              <TableHead numeric>Cost</TableHead>
+            </TableRow>
+          </TableHeader>
+          <TableBody>
+            {models.map((model) => (
+              <TableRow key={model.model}>
+                <TableCell>
+                  <TableLabel>
+                    <Name kind="model" value={model.model} />
+                  </TableLabel>
+                  <TableSecondary>
+                    {share(total === 0 ? 0 : model.tokens / total)} of the
+                    tokens
+                  </TableSecondary>
+                </TableCell>
+                <TableCell numeric from="sm">
+                  {counted(model.requests)}
+                </TableCell>
+                <TableCell numeric>
+                  {tokens(model.tokens)}
+                  <TableMagnitude fraction={model.tokens / largest} />
+                </TableCell>
+                <TableCell numeric>
+                  {model.cost === null ? "no price" : cost(model.cost)}
+                </TableCell>
+              </TableRow>
+            ))}
+          </TableBody>
+        </Table>
+      </ListPanelBody>
+      {unpriced.length > 0 ? (
+        <ListPanelFoot>
+          <span>
+            {unpriced.length === 1
+              ? "One model has"
+              : `${unpriced.length} models have`}{" "}
+            no price, so its requests are left out of the cost:{" "}
+            {plural(summary.totals.unpricedRequests, "request")}.
+          </span>
+        </ListPanelFoot>
+      ) : null}
+    </ListPanel>
+  );
+}
