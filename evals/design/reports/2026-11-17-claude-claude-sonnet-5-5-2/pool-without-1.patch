+import type { PoolSummary } from "#screens/pool/summary.ts";
+
+const minute = 60_000;
+const hour = 60 * minute;
+const day = 24 * hour;
+
+const now = Math.floor(Date.now() / minute) * minute;
+
+const iso = (at: number) => new Date(at).toISOString();
+
+const dateOf = (at: number) => iso(at).slice(0, 10);
+
+const pools = ["personal", "work", "codex", "glm"] as const;
+
+const startOfToday = Math.floor(now / day) * day;
+
+const daysOf = (
+  shape: ReadonlyArray<{
+    readonly requests: number;
+    readonly tokens: number;
+    readonly promptSize: number | null;
+  }>,
+): PoolSummary["days"] =>
+  shape.map((each, index) => ({
+    day: dateOf(startOfToday - (shape.length - 1 - index) * day),
+    ...each,
+  }));
+
+const fiveHours = 5 * hour;
+const week = 7 * day;
+
+/** A window whose standing is the hub's: the share elapsed, how it compares with pace. */
+const windowOf = (
+  length: number,
+  used: number,
+  elapsed: number,
+  pace: "on-pace" | "in-reserve" | "ahead-of-pace",
+  points: number | null,
+  scope: string | null = null,
+): PoolSummary["windows"][number] => {
+  const startsAt = now - Math.round(elapsed * length);
+  const resetsAt = startsAt + length;
+  return {
+    lengthMs: length,
+    scope,
+    usedPercent: used,
+    startsAt: iso(startsAt),
+    resetsAt: iso(resetsAt),
+    standing: {
+      elapsed,
+      resetsInMs: resetsAt - now,
+      pace,
+      points,
+      emptiesInMs:
+        pace === "ahead-of-pace"
+          ? Math.floor(((100 - used) / used) * (now - startsAt))
+          : null,
+    },
+  };
+};
+
+const sevenDays = daysOf([
+  { requests: 412, tokens: 31_400_000, promptSize: 148_000 },
+  { requests: 388, tokens: 28_900_000, promptSize: 162_000 },
