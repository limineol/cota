@@ -0,0 +1,50 @@
+import type { SummaryDay, SummaryRange } from "./summary.ts";
+
+export const dayLength = 86_400_000;
+
+const dayName = new Intl.DateTimeFormat("en-US", {
+  month: "short",
+  day: "numeric",
+  timeZone: "UTC",
+});
+
+/** The start of an ISO date, in milliseconds, as the hub's day begins: at midnight UTC. */
+export const dayStart = (day: string) =>
+  Date.parse(`${day.slice(0, 10)}T00:00:00Z`);
+
+/** An ISO date as `Nov 10`, in the day's own zone, not the viewer's. */
+export const dayLabel = (day: string) => dayName.format(dayStart(day));
+
+export const rangeOptions: ReadonlyArray<{
+  readonly value: SummaryRange;
+  readonly label: string;
+}> = [
+  { value: "1d", label: "1d" },
+  { value: "7d", label: "7d" },
+  { value: "30d", label: "30d" },
+];
+
+export const rangeTitle: Record<SummaryRange, string> = {
+  "1d": "Last day",
+  "7d": "Last 7 days",
+  "30d": "Last 30 days",
+};
+
+/** The stretch a range is compared with, as it ends "compared with the … before". */
+export const spanBefore: Record<SummaryRange, string> = {
+  "1d": "day",
+  "7d": "7 days",
+  "30d": "30 days",
+};
+
+/** The day with the largest prompt size, the first on a tie, or null when no day reported one. */
+export const peakDay = (days: ReadonlyArray<SummaryDay>): SummaryDay | null =>
+  days.reduce<SummaryDay | null>(
+    (peak, day) =>
+      day.promptSize === null
+        ? peak
+        : peak === null || (peak.promptSize ?? 0) < day.promptSize
+          ? day
+          : peak,
+    null,
+  );
