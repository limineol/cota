@@ -0,0 +1,352 @@
+import { Badge } from "@cota/ui/components/badge";
+import {
+  type BlockColumn,
+  BlockColumns,
+  type ColumnsLayout,
+} from "@cota/ui/components/block-columns";
+import { Card } from "@cota/ui/components/card";
+import { Empty, EmptyDescription, EmptyTitle } from "@cota/ui/components/empty";
+import {
+  Page,
+  PageDescription,
+  PageHeader,
+  PageTitle,
+  Section,
+  SectionDescription,
+  SectionHeader,
+  SectionTitle,
+  Subheading,
+} from "@cota/ui/components/page";
+import { PoolMark } from "@cota/ui/components/pool-mark";
+import { RankItem, RankList } from "@cota/ui/components/rank-list";
+import { Segmented } from "@cota/ui/components/segmented";
+import {
+  Stat,
+  StatDelta,
+  StatLabel,
+  StatNote,
+  StatValue,
+} from "@cota/ui/components/stat";
+import { Switcher, SwitcherItem } from "@cota/ui/components/switcher";
+import { DateTime } from "effect";
+import { type Bucket, stack } from "#shared/domain/columns.ts";
+import { type Hue, poolHues } from "#shared/domain/hues.ts";
+import { cost, delta, tokens } from "#shared/domain/quantities.ts";
+import { Name, useNameOf } from "#shared/names.tsx";
+import { NowProvider } from "#shared/now.tsx";
+import { glyphOf } from "#shared/providers.tsx";
+import { WindowLine } from "#shared/window-line.tsx";
+import type { ReadWindow } from "#shared/windows.ts";
+import { costText, counted, plural } from "#shared/words.ts";
+import type { PoolSummary, SummaryRange } from "./summary.ts";
+import {
+  dayLabel,
+  dayLength,
+  dayStart,
+  peakDay,
+  rangeOptions,
+  rangeTitle,
+  spanBefore,
+} from "./words.ts";
+
+type Window = PoolSummary["windows"][number];
+
+const readWindow = (window: Window): ReadWindow => ({
+  lengthMs: window.lengthMs,
+  scope: window.scope,
+  usedPercent: window.usedPercent,
+  resetsAt:
+    window.resetsAt === null ? null : DateTime.makeUnsafe(window.resetsAt),
+  standing: window.standing,
+});
+
+const kindName: Record<PoolSummary["pool"]["kind"], string> = {
+  subscription: "Subscription",
+  keyed: "Keyed",
+};
+
+interface Figure {
+  readonly label: string;
+  readonly value: string;
+  readonly current: number;
+  readonly previous: number | null;
+  readonly note?: string | undefined;
+}
+
+const figuresOf = (totals: PoolSummary["totals"]): ReadonlyArray<Figure> => [
+  {
+    label: "Requests",
+    value: counted(totals.requests),
+    current: totals.requests,
+    previous: totals.previous?.requests ?? null,
+  },
+  {
+    label: "Tokens",
+    value: tokens(totals.tokens),
+    current: totals.tokens,
+    previous: totals.previous?.tokens ?? null,
+  },
+  {
+    label: "Cost",
+    value: costText(totals.cost, totals.unpricedRequests),
+    current: totals.cost,
+    previous: totals.previous?.cost ?? null,
+    note:
+      totals.unpricedRequests > 0
+        ? `${plural(totals.unpricedRequests, "request")} with no price`
+        : "at API list prices",
+  },
+];
+
+function Totals({ summary }: { readonly summary: PoolSummary }) {
+  return (
+    <div className="grid grid-cols-1 gap-2.5 @xl:grid-cols-3 wide:gap-3">
+      {figuresOf(summary.totals).map((figure) => {
+        const change =
+          figure.previous === null
+            ? null
+            : delta(figure.current, figure.previous);
+        return (
+          <Stat key={figure.label} variant="tile">
+            <StatLabel>{figure.label}</StatLabel>
+            <StatValue>
+              {figure.value}
+              {change === null ? null : (
+                <StatDelta
+                  direction={change.direction}
+                  title={`The ${figure.label.toLowerCase()} of the ${spanBefore[summary.range]} before`}
+                >
+                  {change.text}
+                </StatDelta>
+              )}
+            </StatValue>
+            {figure.note === undefined ? null : (
+              <StatNote>{figure.note}</StatNote>
+            )}
+          </Stat>
+        );
+      })}
+    </div>
+  );
+}
+
+function Models({
+  summary,
+  hue,
+}: {
+  readonly summary: PoolSummary;
+  readonly hue: Hue;
+}) {
+  const nameOf = useNameOf();
+  const ranked = summary.models.toSorted((a, b) => b.tokens - a.tokens);
+  const peak = Math.max(1, ...ranked.map((row) => row.tokens));
+  return (
+    <Card size="compact">
+      <Subheading>Models by tokens</Subheading>
+      <RankList aria-label="Models">
+        {ranked.map((row) => (
+          <RankItem
+            key={row.model}
+            label={<span title={row.model}>{nameOf("model", row.model)}</span>}
+            value={
+              <>
+                {tokens(row.tokens)} · {plural(row.requests, "request")} ·{" "}
+                {row.cost === null ? "no price" : cost(row.cost)}
+              </>
+            }
+            fraction={row.tokens / peak}
+            hue={hue}
+          />
+        ))}
+      </RankList>
+    </Card>
+  );
+}
+
+const noPrompt = "not reported";
+
+function LargestContext({
+  summary,
+  hue,
+}: {
+  readonly summary: PoolSummary;
+  readonly hue: Hue;
+}) {
+  const peak = peakDay(summary.days);
+  const fit = (): ColumnsLayout => {
+    const buckets = summary.days.map(
+      (day): Bucket => ({
+        start: dayStart(day.day),
+        end: dayStart(day.day) + dayLength,
+        parts: [day.promptSize ?? 0],
+      }),
+    );
+    const { unit, columns } = stack(buckets, 1);
+    return {
+      unit: `${tokens(unit)} tokens`,
+      columns: columns.map((column, index): BlockColumn => {
+        const size = summary.days[index]?.promptSize ?? null;
+        return {
+          key: summary.days[index]?.day ?? String(index),
+          label: dayLabel(summary.days[index]?.day ?? ""),
+          tick: dayLabel(summary.days[index]?.day ?? ""),
+          total: size === null ? noPrompt : tokens(size),
+          parts: column.parts.map((blocks) => ({
+            blocks,
+            value: size === null ? null : tokens(size),
+          })),
+        };
+      }),
+    };
+  };
+  return (
+    <Card size="compact">
+      <Subheading>Largest prompt, day by day</Subheading>
+      <p className="text-base text-text-2 tabular-nums">
+        {peak === null || peak.promptSize === null
+          ? "No request in this range reported its prompt size."
+          : `The largest prompt reached ${tokens(peak.promptSize)} tokens, on ${dayLabel(peak.day)}.`}
+      </p>
+      <BlockColumns
+        series={[{ key: "prompt", label: "Largest prompt", tint: hue }]}
+        fit={fit}
+        label="Largest prompt size of each day"
+        empty="No request in this range reported its prompt size."
+      />
+    </Card>
+  );
+}
+
+/**
+ * One pool's page: its quota windows, what it carried over a range against the
+ * range before, which models its requests went to, and the largest prompt each
+ * day reached. `onPool` and `onRange` say what the viewer chose.
+ */
+export function PoolPage({
+  summary,
+  onPool,
+  onRange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onPool: (pool: string) => void;
+  readonly onRange: (range: SummaryRange) => void;
+}) {
+  return (
+    <NowProvider>
+      <PoolView summary={summary} onPool={onPool} onRange={onRange} />
+    </NowProvider>
+  );
+}
+
+function PoolView({
+  summary,
+  onPool,
+  onRange,
+}: {
+  readonly summary: PoolSummary;
+  readonly onPool: (pool: string) => void;
+  readonly onRange: (range: SummaryRange) => void;
+}) {
+  const nameOf = useNameOf();
+  const { pool } = summary;
+  const hues = poolHues(summary.pools);
+  const hueOf = (id: string): Hue => hues.get(id) ?? "neutral";
+  const idle = summary.totals.requests === 0;
+  return (
+    <Page className="@container">
+      <PageHeader>
+        <div>
+          <div className="flex flex-wrap items-center gap-2.5">
+            <PoolMark
+              hue={hueOf(pool.id)}
+              name={nameOf("pool", pool.id)}
+              glyph={glyphOf(pool.provider)}
+              size="lg"
+            />
+            <PageTitle title={pool.id}>{nameOf("pool", pool.id)}</PageTitle>
+            {pool.plan === null ? null : <Badge>{pool.plan}</Badge>}
+          </div>
+          <PageDescription>
+            {kindName[pool.kind]} · {pool.provider}
+          </PageDescription>
+        </div>
+      </PageHeader>
+
+      <Switcher aria-label="Pool" className="mb-6">
+        {summary.pools.map((id) => (
+          <SwitcherItem
+            key={id}
+            current={id === pool.id}
+            render={<button type="button" onClick={() => onPool(id)} />}
+          >
+            <PoolMark hue={hueOf(id)} name={nameOf("pool", id)} />
+            <Name kind="pool" value={id} />
+          </SwitcherItem>
+        ))}
+      </Switcher>
+
+      <section aria-labelledby="windows-title">
+        <SectionHeader>
+          <SectionTitle id="windows-title">Quota windows</SectionTitle>
+        </SectionHeader>
+        {summary.windows.length === 0 ? (
+          <Empty>
+            <EmptyTitle>The hub has not read this pool's windows.</EmptyTitle>
+            <EmptyDescription>
+              No quota reading and no request has reported a window for this
+              pool yet. They appear here once either has.
+            </EmptyDescription>
+          </Empty>
+        ) : (
+          <div className="grid gap-5 @3xl:grid-cols-2">
+            {summary.windows.map((window) => (
+              <WindowLine
+                key={`${window.lengthMs}-${window.scope ?? ""}`}
+                window={readWindow(window)}
+                pool={pool.id}
+                hue={hueOf(pool.id)}
+                detailed
+              />
+            ))}
+          </div>
+        )}
+      </section>
+
+      <Section aria-labelledby="carried-title">
+        <SectionHeader>
+          <div>
+            <SectionTitle id="carried-title">What it carried</SectionTitle>
+            <SectionDescription>
+              {rangeTitle[summary.range]}
+              {summary.totals.previous === null
+                ? ` · the request log begins ${dayLabel(summary.logBegins)}, so there is no ${spanBefore[summary.range]} before to compare`
+                : `, compared with the ${spanBefore[summary.range]} before`}
+            </SectionDescription>
+          </div>
+          <Segmented
+            label="Time range"
+            value={summary.range}
+            options={rangeOptions}
+            onValueChange={onRange}
+          />
+        </SectionHeader>
+        {idle ? (
+          <Empty>
+            <EmptyTitle>This pool carried nothing in this range.</EmptyTitle>
+            <EmptyDescription>
+              No request went through it. Try a longer range.
+            </EmptyDescription>
+          </Empty>
+        ) : (
+          <>
+            <Totals summary={summary} />
+            <div className="mt-3.5 grid gap-3.5 @5xl:grid-cols-2">
+              <Models summary={summary} hue={hueOf(pool.id)} />
+              <LargestContext summary={summary} hue={hueOf(pool.id)} />
+            </div>
+          </>
+        )}
+      </Section>
+    </Page>
+  );
+}
