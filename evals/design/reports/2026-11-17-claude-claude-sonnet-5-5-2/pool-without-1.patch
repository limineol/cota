+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { expect, fn, within } from "storybook/test";
+import { displayNames } from "#stories/fixtures.ts";
+import { withApi } from "#stories/page.tsx";
+import {
+  beforeTheLogBegins,
+  claudeSubscription,
+  quiet,
+  unpricedModel,
+  unreadWindows,
+} from "#stories/pool.ts";
+import { PoolPage } from "./pool.tsx";
+
+const meta = {
+  title: "Screens/Pool",
+  component: PoolPage,
+  decorators: [withApi([displayNames])],
+  args: { summary: claudeSubscription, onPool: fn(), onRange: fn() },
+  tags: ["page"],
+} satisfies Meta<typeof PoolPage>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const ClaudeSubscription: Story = {
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByRole("heading", { level: 1, name: /Personal plan/ }),
+    ).toBeVisible();
+    await expect(
+      await canvas.findByRole("meter", {
+        name: "Personal plan, 5-hour window",
+      }),
+    ).toHaveAttribute("aria-valuetext", "41% used, On pace");
+    await expect(
+      canvas.getByRole("meter", { name: "Personal plan, Weekly window" }),
+    ).toHaveAttribute(
+      "aria-valuetext",
+      expect.stringMatching(/^71% used, 22% ahead of pace · empties in /),
+    );
+    const models = await canvas.findByRole("list", { name: "Models" });
+    await expect(within(models).getAllByRole("listitem")).toHaveLength(5);
+    await expect(canvas.getAllByTitle(/of the 7 days before$/)).toHaveLength(3);
+    await expect(
+      canvas.getByText(/^The largest prompt reached 198K tokens, on .+\.$/),
+    ).toBeVisible();
+  },
+};
+
+export const WindowsNotRead: Story = {
+  args: { summary: unreadWindows },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("The hub has not read this pool's windows."),
+    ).toBeVisible();
+    await expect(canvas.queryAllByRole("meter")).toHaveLength(0);
+  },
+};
+
+export const ModelWithNoPrice: Story = {
+  args: { summary: unpricedModel },
+  play: async ({ canvas }) => {
+    await expect(await canvas.findByText("≥$9.40")).toBeVisible();
+    await expect(canvas.getByText("61 requests with no price")).toBeVisible();
+    await expect(canvas.getByText(/· no price$/)).toBeVisible();
+  },
+};
+
+export const BeforeTheLogBegins: Story = {
+  args: { summary: beforeTheLogBegins },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText(/the request log begins .+, so there is no/),
+    ).toBeVisible();
+    await expect(canvas.queryAllByTitle(/before$/)).toHaveLength(0);
+  },
+};
+
+export const NothingCarried: Story = {
+  args: { summary: quiet },
+  play: async ({ canvas }) => {
+    await expect(
+      await canvas.findByText("This pool carried nothing in this range."),
+    ).toBeVisible();
+  },
+};
+
+export const ChoosingARange: Story = {
+  play: async ({ canvas, userEvent, args }) => {
+    await userEvent.click(await canvas.findByRole("radio", { name: "30d" }));
+    await expect(args.onRange).toHaveBeenCalledWith("30d");
+  },
+};
+
+export const ChoosingAPool: Story = {
+  play: async ({ canvas, userEvent, args }) => {
+    const switcher = await canvas.findByRole("navigation", { name: "Pool" });
+    await userEvent.click(
+      within(switcher).getByRole("button", { name: /glm/ }),
+    );
+    await expect(args.onPool).toHaveBeenCalledWith("glm");
+  },
+};
+
+export const Narrow: Story = {
+  globals: { viewport: { value: "mobile2" } },
+};
+
+const Chosen = () => {
+  const [range, setRange] = useState(claudeSubscription.range);
+  return (
+    <PoolPage
+      summary={{ ...claudeSubscription, range }}
+      onPool={() => undefined}
+      onRange={setRange}
+    />
+  );
+};
+
+export const RangeFollowsTheChoice: Story = {
+  render: () => <Chosen />,
+  play: async ({ canvas, userEvent }) => {
+    await userEvent.click(await canvas.findByRole("radio", { name: "1d" }));
+    await expect(canvas.getByRole("radio", { name: "1d" })).toBeChecked();
+  },
+};
